# Map container seam (RFC 0008, phase F1): legacy VBSP and BSP2 readers, the
# BSP2 writer and lossless legacy conversion. A self-contained strict C++20
# static library with no tier0/tier1 dependency (RFC 0006), so it overrides the
# tree-wide -std=c++11. Consumers include only the C++11-compatible
# public/mapcontainer/map_container.h unless they are C++20 tools.

top = '.'
PROJECT_NAME = 'mapcontainer'

def options(opt):
	return

def configure(conf):
	return

def build(bld):
	bld.stlib(
		source    = [ 'blake2b.cpp', 'map_container.cpp' ],
		target    = PROJECT_NAME,
		name      = PROJECT_NAME,
		features  = 'c cxx',
		includes  = [ '../public' ],
		defines   = [],
		cxxflags  = ['-std=c++20'],
		use       = [],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx       = bld.get_taskgen_count()
	)
