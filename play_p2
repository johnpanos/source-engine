#!/usr/bin/env bash
# Launch the separate Portal 2 target with VPKs from the installed game.
# Physics runs on Box3D (vphysics_box3d), as in ./play; PHYSICS=vphysics ./play_p2
# uses IVP, and an explicit -physics argument wins. PHYSICS_ARGS carries the
# physics launch flags, as in run.conf: -physics_shape_inertia by default
# (RFC 0013 shape inertia); PHYSICS_ARGS= ./play_p2 rolls back.
# Render switches come first, as in ./play (./play_p2 --render-help): --native,
# --null, --core-world (the default), --no-core-world, --no-core,
# --core-probe=MODE, --no-legacy-ports, --validate. The Portal 2 tree builds native Vulkan only, so --dxvk is refused.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
P2_STEAM_ROOT="${P2_STEAM_ROOT:-$HOME/.local/share/Steam/steamapps/common/Portal 2}"
P2_RUNTIME="${P2_RUNTIME:-$ROOT/run/runtime-p2}"
P2_BUILD_DIR="${P2_BUILD_DIR:-$ROOT/build-p2}"
P2_WAFLOCK="${P2_WAFLOCK:-.lock-waf-p2}"
P2_FSR="${P2_FSR:-0}"
if [[ "$P2_FSR" != 0 && "$P2_FSR" != 1 ]]; then
    echo "play_p2: P2_FSR must be 0 or 1" >&2
    exit 1
fi
PHYSICS="${PHYSICS:-vphysics_box3d}"
PHYSICS_ARGS="${PHYSICS_ARGS--physics_shape_inertia}"
# Job system (RFC 0003), as run.conf's JOB_ARGS for Portal: the pooled
# render-start and query-cache graphs. portal_carve_job_graph is Portal-only;
# host_thread_mode stays 0 (see run.conf). JOB_ARGS= rolls back to the engine
# defaults.
JOB_ARGS="${JOB_ARGS-+cl_render_start_graph 2 +sv_querycache_job_graph 2 -vkemitparallel 1}"
# Quality: the system levels (portal2_system_level.cpp) already pick retail's
# highest settings (mat_picmip -1, r_lod 0, dxlevel 100, clamped to the
# renderer's 95). They leave color correction to the saved video config, which
# is 0 in a runtime staged from a retail install; the maps' color_correction
# entities need it on.
MAT_ARGS="${MAT_ARGS-+mat_colorcorrection 1}"

# Render switches (tools/quality/render_flags.sh). The render core draws the
# world by default, as in ./play (user direction, 2026-09-29): --no-core-world
# or CORE_WORLD=0 for the legacy world alone.
. "$ROOT/tools/quality/render_flags.sh"
RENDER_CORE_WORLD_DEFAULT=${CORE_WORLD:-1}
render_flags_parse "$@"
set -- ${RENDER_REST[@]+"${RENDER_REST[@]}"}
render_args=(${RENDER_GAME_ARGS[@]+"${RENDER_GAME_ARGS[@]}"})
case "$RENDER_BACKEND" in
    native) ;;
    null) render_args+=(-renderer null) ;;
    dxvk)
        echo "play_p2: the Portal 2 tree builds native Vulkan only; --dxvk is ./play's" >&2
        exit 1 ;;
esac

if [[ "${1:-}" == "--retail" ]]; then
    shift
    exec "$P2_STEAM_ROOT/portal2.sh" "$@"
fi

mode="${1:-}"
if [[ "$mode" == "--prepare" || "$mode" == "--configure-only" ]]; then
    shift
fi

if [[ -d "$P2_BUILD_DIR/c4che" ]]; then
    if ! grep -Eq "^GAMES = ['\"]portal2['\"]$" "$P2_BUILD_DIR"/c4che/*_cache.py; then
        echo "play_p2: $P2_BUILD_DIR is configured for a different game" >&2
        exit 1
    fi
    if [[ "$P2_FSR" == 1 ]] && ! grep -q '^RENDER_FSR411 = True$' "$P2_BUILD_DIR/c4che/_cache.py"; then
        echo "play_p2: $P2_BUILD_DIR was not configured with FSR 4.1.1" >&2
        exit 1
    fi
    if [[ "$P2_FSR" == 0 ]] && grep -q '^RENDER_FSR411 = True$' "$P2_BUILD_DIR/c4che/_cache.py"; then
        echo "play_p2: $P2_BUILD_DIR is an FSR build; select its FSR launcher" >&2
        exit 1
    fi
else
    echo "play_p2: configuring Portal 2 build in $P2_BUILD_DIR"
    fsr_config=()
    if [[ "$P2_FSR" == 1 ]]; then
        fsr_config+=(--render-fsr411)
    fi
    (cd "$ROOT" && WAFLOCK="$P2_WAFLOCK" python3 ./waf configure \
        --platform-provider=sdl3 --render-backend=native-vulkan \
        --build-games=portal2 --physics-backend=both --video-provider=bink --disable-warns \
        "${fsr_config[@]}" -T release -o "$P2_BUILD_DIR" --prefix="$P2_BUILD_DIR/install")
fi

if [[ "$mode" == "--prepare" || "$mode" == "--configure-only" ]]; then
    python3 "$ROOT/tools/quality/stage_portal2_runtime.py" \
        --steam-root "$P2_STEAM_ROOT" --runtime "$P2_RUNTIME"
    exit 0
fi

# P2_NO_BUILD=1 starts the runtime as staged, for a second copy beside a
# running one (./play_p2_coop): rebuilding and restaging under it gains nothing.
if [[ "${P2_NO_BUILD:-}" != 1 ]]; then
    # Replay the tree's own configure options if a wscript, Waf tool, toolchain
    # policy or profile changed since it was configured, as run.sh does.
    WAFLOCK="$P2_WAFLOCK" python3 "$ROOT/tools/quality/ensure_configured.py" --build "$P2_BUILD_DIR"
    # The ccache directory and size limit shared with ./play's tree (run.sh).
    . "$ROOT/tools/quality/launcher_ccache.sh"
    launcher_ccache "$P2_BUILD_DIR"
    (cd "$ROOT" && WAFLOCK="$P2_WAFLOCK" python3 ./waf build)

    python3 "$ROOT/tools/quality/stage_portal2_runtime.py" \
        --steam-root "$P2_STEAM_ROOT" --runtime "$P2_RUNTIME" --build "$P2_BUILD_DIR" \
        --mount-published
elif [[ ! -x "$P2_RUNTIME/hl2_launcher" ]]; then
    echo "play_p2: P2_NO_BUILD=1 but $P2_RUNTIME has no staged launcher" >&2
    exit 1
fi

cd "$P2_RUNTIME"
export SteamAppId=620 SteamGameId=620
export LD_LIBRARY_PATH="$PWD/bin:${LD_LIBRARY_PATH:-}"
physics_args=(-physics "$PHYSICS")
for arg in "$@"; do
    if [[ "$arg" == "-physics" ]]; then
        physics_args=()
    fi
done
# shellcheck disable=SC2206  # the ConVar lists are intentionally word-split
config_args=($PHYSICS_ARGS $JOB_ARGS $MAT_ARGS)
if [[ "$P2_FSR" == 1 ]]; then
    if [[ ! -d "$ROOT/external/fsr411/assets" ]]; then
        echo "play_p2: FSR assets are missing; initialize external/fsr411" >&2
        exit 1
    fi
    render_args+=(-fsr -fsr-assets "$ROOT/external/fsr411/assets")
fi
if [[ ${#render_args[@]} -gt 0 ]]; then
    echo "play_p2: render switches: ${render_args[*]}"
fi
exec ./hl2_launcher -game portal2 "${physics_args[@]}" "${config_args[@]}" \
    ${render_args[@]+"${render_args[@]}"} "$@"
