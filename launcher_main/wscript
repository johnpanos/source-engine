#! /usr/bin/env python
# encoding: utf-8

from waflib import Utils
import os

top = '.'
PROJECT_NAME = 'hl2_launcher'

def options(opt):
	# stub
	return

def configure(conf):
	# The Android and Apple application roots name the game they launch (-game).
	conf.env.GAMES = conf.options.GAMES

def build(bld):
	# Game-specific modules a static composition root links and binds:
	# Portal 2's script manager (static_composition.cpp).
	game_libs = []
	game_defines = []
	if bld.env.STATIC_COMPOSITION and bld.env.GAMES == 'portal2':
		game_libs += ['vscript']
		game_defines += ['STATIC_COMPOSITION_VSCRIPT']

	if bld.env.ANDROID_SDL3:
		# SDLActivity's native entry: libmain.so exporting SDL_main.
		bld.shlib(
			source   = ['android_main.cpp', 'app_root.cpp'],
			target   = 'main',
			name     = PROJECT_NAME,
			features = 'c cxx',
			includes = ['../public', '../public/tier0'],
			defines  = ['ANDROID_DEFAULT_GAME="%s"' % bld.env.GAMES],
			use      = ['launcher', 'tier0', 'SDL3'],
			install_path = bld.env.LIBDIR,
			idx      = bld.get_taskgen_count()
		)
		return
	if bld.env.DEST_OS == 'android':
		return
	if bld.env.APPLE:
		# The app executable for macOS, iOS and tvOS: SDL3 owns main()
		# (SDL_main.h) and starts AppKit or UIKit; apple_main.cpp is the shared
		# launch sequence and apple_app_<platform>.cpp the platform's half. The
		# root links and binds every module (static_composition.cpp).
		source = ['apple_main.cpp', 'apple_thermal.mm', 'app_root.cpp', 'static_composition.cpp']
		libs = ['launcher', 'client', 'server', 'GameUI', 'scenefilecache',
			'soundemittersystem', 'tier0', 'SDL3', 'FOUNDATION', 'COREFOUNDATION'] + game_libs
		if bld.env.DEST_OS == 'ios':
			# Game Center achievements and the tvOS user-defaults record store.
			source += ['apple_app_uikit.cpp']
			libs += ['platform_apple', 'platform_achievements', 'platform_records', 'GAMEKIT']
		else:
			source += ['apple_app_macos.cpp']
		bld(
			source   = source,
			target   = PROJECT_NAME,
			name     = PROJECT_NAME,
			features = 'c cxx cxxprogram',
			includes = ['../public', '../public/tier0', '../public/tier1'],
			defines  = ['APPLE_DEFAULT_GAME="%s"' % bld.env.GAMES] + game_defines,
			use      = libs,
			install_path = bld.env.BINDIR,
			idx      = bld.get_taskgen_count()
		)
		return

	source = ['main.cpp']
	includes = ['../public']
	defines = []
	libs = []

	if bld.env.STATIC_COMPOSITION:
		# The composition root links every module of the product and binds
		# the game modules to the engine (static_composition.cpp). filesystem
		# and physics come in through the launcher.
		source += ['static_composition.cpp']
		includes += ['../public/tier0', '../public/tier1']
		libs += ['launcher', 'client', 'server', 'GameUI', 'scenefilecache',
			'soundemittersystem'] + game_libs
		defines += game_defines

	if bld.env.DEST_OS != 'win32':
		libs += [ 'DL', 'LOG' ]
	else:
		libs += ['USER32', 'SHELL32']
		source += ['launcher_main.rc']

	install_path = bld.env.BINDIR
	bld(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx cxxprogram',
		includes = includes,
		defines  = defines,
		use      = libs,
		install_path = install_path,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)

