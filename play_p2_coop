#!/usr/bin/env python3
"""Boot Portal 2 co-op on two peers (two desktop copies by default) and connect them.

    ./play_p2_coop [--host PEER] [--client PEER] [--map MAP] [--no-wait]

PEER is `android` (the adb device), `ios` (the iPhone behind `ssh macvm`) or
`desktop` (./play_p2 on this machine). The default is two desktop copies side
by side on the co-op calibration course (mp_coop_start): the host plays Atlas
and the client P-body. Co-op gives the first player the blue team (Atlas) and
the second the red one (P-body), CPortal_Player::PickTeam in
game/server/portal2/portal/portal_player.cpp.

The host runs a listen server for two players (`+maxplayers 2` selects the
co-op game rules, game/server/portal/portal_client.cpp). Once its server
answers a challenge request on the LAN, the client starts with `+connect`, and
the join is read from the host's engine.log (launcher/launcher.cpp writes the
console there on every peer). The phones take
their arguments from commandline.txt in their content directory
(launcher_main/android_main.cpp, ios_main.cpp); the previous file is put back
once the game has read it. The apps are not built or installed here: use
./build-android-portal2-apk.sh --install and ./build-ios-portal2-app.sh with
./ios-deploy.sh, from the same source revision on both peers.

All peers must be on one LAN. The first co-op run on the iPhone asks for
Local Network access; allow it, or the iPhone cannot reach its partner.
"""

import argparse
import ipaddress
import os
import shlex
import re
import socket
import subprocess
import sys
import tempfile
import time
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "tools/quality"))

import ios_device  # noqa: E402
import profile_extends  # noqa: E402

DEFAULT_PORT = 27015
ANDROID_PROFILE = ROOT / "quality/product_profiles/portal2-android-native-vulkan.json"
IOS_PROFILE = ROOT / "quality/product_profiles/portal2-ios-native-vulkan.json"
# The game reads commandline.txt at startup; restore the previous file after this.
ARGUMENTS_READ_SECONDS = 15


def log(message):
    print("\033[1;36m==> %s\033[0m" % message, flush=True)


# -- server probe -----------------------------------------------------------------
def server_answers(address, timeout=2.0):
    """True when a Source server answers at address. Without Steam the engine
    does not answer A2S_INFO (the Steam game-server API does), so this asks
    for a server challenge ('W' -> 'A', engine/baseserver.cpp), which the
    engine answers itself once the server is running."""
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
        sock.settimeout(timeout)
        try:
            sock.sendto(b"\xff\xff\xff\xffW", address)
            reply, _ = sock.recvfrom(64)
        except OSError:
            return False
    return reply[:5] == b"\xff\xff\xff\xffA"


def wait_until(predicate, timeout, interval=2.0):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        result = predicate()
        if result:
            return result
        time.sleep(interval)
    return None


# A remote player's connect on the host (engine/baseserver.cpp); the host's
# own player connects over the loopback.
CONNECTED = re.compile(r'Client "([^"]*)" connected \((?!loopback)([^)]*)\)')


def remote_join(log_text):
    match = CONNECTED.search(log_text or "")
    return match and (match.group(1), match.group(2))


# -- peers ----------------------------------------------------------------------
class Android:
    name = "Android"

    def __init__(self, serial):
        app = profile_extends.load_profile(ANDROID_PROFILE)["android"]
        self.package = app["application_id"]
        self.content = "/sdcard/Android/data/%s/files" % self.package
        self.serial = serial or os.environ.get("ANDROID_SERIAL") or self._only_device()
        self.saved = None

    def adb(self, *args, check=True):
        return subprocess.run(["adb", "-s", self.serial, *args], check=check, text=True,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT).stdout

    @staticmethod
    def _only_device():
        out = subprocess.run(["adb", "devices"], check=True, text=True,
                             stdout=subprocess.PIPE).stdout
        devices = [line.split()[0] for line in out.splitlines()[1:]
                   if line.strip().endswith("device")]
        if len(devices) != 1:
            raise SystemExit("play_p2_coop: %d adb devices; pass --serial" % len(devices))
        return devices[0]

    def address(self):
        out = self.adb("shell", "ip -4 -o addr show wlan0")
        for word in out.split():
            if "/" in word and word[0].isdigit():
                return word.split("/")[0]
        raise SystemExit("play_p2_coop: the Android device has no wlan0 address:\n" + out)

    def start(self, arguments):
        path = self.content + "/commandline.txt"
        self.saved = self.adb("shell", "cat %s 2>/dev/null" % shlex.quote(path), check=False)
        self._write(arguments)
        self.adb("shell", "am", "force-stop", self.package)
        activity = self.adb("shell", "cmd", "package", "resolve-activity", "--brief",
                            self.package).split()[-1]
        self.adb("shell", "am", "start", "-n", activity)

    def restore(self):
        if self.saved is not None:
            self._write(self.saved)
            self.saved = None

    def engine_log(self):
        return self.adb("shell", "cat %s/engine.log 2>/dev/null" % self.content, check=False)

    def _write(self, text):
        path = self.content + "/commandline.txt"
        with tempfile.NamedTemporaryFile("w", suffix="_commandline.txt", delete=False) as f:
            f.write(text)
        try:
            self.adb("push", f.name, path)
        finally:
            os.unlink(f.name)
        # The app runs as its own user; adb's file must be readable to it.
        self.adb("shell", "chmod", "666", path)


class Ios:
    name = "iPhone"

    def __init__(self, macvm):
        self.app = profile_extends.load_profile(IOS_PROFILE)["ios"]
        self.device = ios_device.Device(self.app["bundle_id"], host=macvm)
        self.saved = None

    def address(self):
        hostname = self.device.hostname()
        if not hostname:
            raise SystemExit("play_p2_coop: no network name for the iPhone; pass --host-ip")
        try:
            return socket.gethostbyname(hostname)
        except OSError:
            raise SystemExit("play_p2_coop: cannot resolve %s; pass --host-ip" % hostname)

    def start(self, arguments):
        with tempfile.TemporaryDirectory() as directory:
            previous = Path(directory) / "commandline.txt"
            self.saved = previous.read_text() if self.device.get(
                "Documents/commandline.txt", previous) else ""
        self.device.put_text(arguments, "Documents/commandline.txt")
        self.device.start()

    def restore(self):
        if self.saved is not None:
            self.device.put_text(self.saved, "Documents/commandline.txt")
            self.saved = None

    def engine_log(self):
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory) / "engine.log"
            return path.read_text(errors="replace") if self.device.get(
                "Documents/engine.log", path) else ""


class Desktop:
    name = "desktop"

    def __init__(self, window=None):
        self.process = None
        # (width, height, x): windowed at x when two copies share this screen.
        self.window = window

    def address(self):
        out = subprocess.run(["ip", "-4", "route", "get", "1.1.1.1"], check=True, text=True,
                             stdout=subprocess.PIPE).stdout.split()
        return out[out.index("src") + 1]

    def start(self, arguments, second_port=None):
        # A second copy on this machine (desktop with desktop) needs its own
        # server port (the host's comes in its arguments); -multirun skips
        # the single-instance lock. It also skips engine.log, which the host's
        # join check reads, and the rebuild and restaging the first copy did
        # (P2_NO_BUILD).
        env = dict(os.environ)
        ports = []
        if second_port:
            ports = ["-port", str(second_port), "-nolog"]
            env["P2_NO_BUILD"] = "1"
        window = []
        if self.window:
            width, height, x = self.window
            # The command-line mode is not saved to the video config
            # (s_bVideoConfigOverriddenFromCmdLine, engine/matsys_interface.cpp).
            # Wayland compositors place the windows themselves and ignore -x/-y.
            window = ["-windowed", "-w", str(width), "-h", str(height),
                      "-x", str(x), "-y", "0"]
        self.process = subprocess.Popen([str(ROOT / "play_p2"), "-multirun", *ports, *window,
                                         *shlex.split(arguments)], cwd=ROOT, env=env)

    def restore(self):
        pass

    def check_running(self):
        """Stop waiting on a copy that has exited (a failed build, a crash)."""
        if self.process and self.process.poll() is not None:
            raise SystemExit("play_p2_coop: the %s exited with status %d"
                             % (self.name, self.process.returncode))

    def engine_log(self):
        path = ROOT / "run/runtime-p2/engine.log"
        return path.read_text(errors="replace") if path.exists() else ""


def check_running(*peers):
    for peer in peers:
        if isinstance(peer, Desktop):
            peer.check_running()
    return None


def make_peer(kind, args, window=None):
    if kind == "android":
        return Android(args.serial)
    if kind == "ios":
        return Ios(args.macvm)
    return Desktop(window)


def parse_window(text):
    match = re.fullmatch(r"(\d+)x(\d+)", text)
    if not match:
        raise argparse.ArgumentTypeError("expected WIDTHxHEIGHT, e.g. 1280x720")
    return int(match.group(1)), int(match.group(2))


def main(argv=None):
    parser = argparse.ArgumentParser(
        description=__doc__.splitlines()[0],
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="\n".join(__doc__.splitlines()[2:]))
    peers = ["android", "ios", "desktop"]
    parser.add_argument("--host", choices=peers, default="desktop",
                        help="peer that runs the listen server and plays Atlas "
                             "(default: desktop)")
    parser.add_argument("--client", choices=peers, default="desktop",
                        help="peer that joins and plays P-body (default: desktop)")
    parser.add_argument("--window", type=parse_window, default=(1280, 720),
                        metavar="WxH",
                        help="window size of each copy when both peers are the desktop "
                             "(default: 1280x720)")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT,
                        help="host server port (default: %d); another copy of the game "
                             "may already hold it" % DEFAULT_PORT)
    parser.add_argument("--map", default="mp_coop_start", help="co-op map (default: mp_coop_start)")
    parser.add_argument("--host-ip", help="host address to connect to (default: discovered)")
    parser.add_argument("--serial", help="adb device (default: $ANDROID_SERIAL or the only one)")
    parser.add_argument("--macvm", default=ios_device.DEFAULT_HOST,
                        help="Mac that reaches the iPhone (default: macvm)")
    parser.add_argument("--timeout", type=float, default=300,
                        help="seconds to wait for the host, then the client (default: 300)")
    parser.add_argument("--extra", default="", help="further engine arguments for both peers")
    parser.add_argument("--no-wait", action="store_true",
                        help="return once the client is started")
    args = parser.parse_args(argv)
    if args.host == args.client and args.host != "desktop":
        parser.error("the host and the client must be different devices")

    both_desktop = args.host == args.client == "desktop"
    width, height = args.window
    host = make_peer(args.host, args, (width, height, 0) if both_desktop else None)
    client = make_peer(args.client, args, (width, height, width) if both_desktop else None)
    host.name += " (Atlas)"
    client.name += " (P-body)"
    address = args.host_ip or host.address()
    ipaddress.IPv4Address(address)
    port = args.port
    server = (address, port)
    if server_answers(server, timeout=1):
        raise SystemExit("play_p2_coop: a server already answers at %s:%d; stop it or "
                         "pass --port" % server)

    common = "+sv_cheats 1 " + args.extra
    started = []
    try:
        log("%s hosts %s at %s:%d" % (host.name, args.map, address, port))
        # A co-op host alone gives up on its partner after
        # mp_wait_for_other_player_notconnecting_timeout (10 s) and
        # mp_wait_for_other_player_timeout (100 s) and disconnects
        # (CPortal_Player::PlayerCatchPatnerNotConnectingThink); the partner
        # here starts only once the host answers, so wait as long as this does.
        wait = "+mp_wait_for_other_player_notconnecting_timeout %d " \
               "+mp_wait_for_other_player_timeout %d" % (args.timeout, args.timeout)
        host.start("-port %d +sv_lan 1 +maxplayers 2 %s %s +map %s\n"
                   % (port, common, wait, args.map))
        started.append(host)
        if not wait_until(lambda: check_running(host) or server_answers(server), args.timeout):
            raise SystemExit("play_p2_coop: the %s host did not answer at %s:%d within %d s"
                             % (host.name, address, port, args.timeout))
        host.restore()
        log("host up")

        log("%s joins %s:%d" % (client.name, address, port))
        arguments = "%s +connect %s:%d\n" % (common, address, port)
        if isinstance(client, Desktop):
            client.start(arguments, port + 10 if args.host == "desktop" else None)
        else:
            client.start(arguments)
            time.sleep(ARGUMENTS_READ_SECONDS)
            client.restore()
        started.append(client)
        if args.no_wait:
            return 0
        joined = wait_until(lambda: check_running(host, client) or remote_join(host.engine_log()),
                            args.timeout, interval=5)
        if not joined:
            raise SystemExit("play_p2_coop: the %s client did not join within %d s"
                             % (client.name, args.timeout))
        log('connected: "%s" joined from %s' % joined)
    finally:
        for peer in started:
            peer.restore()
    processes = [peer.process for peer in (host, client)
                 if isinstance(peer, Desktop) and peer.process]
    try:
        status = 0
        for process in processes:
            status = process.wait() or status
        return status
    except KeyboardInterrupt:
        for process in processes:
            process.terminate()
        for process in processes:
            process.wait()
        return 130


if __name__ == "__main__":
    sys.exit(main())
