{
  "schema": "source-product-profile/v2",
  "id": "portal-wasm32-webgpu-v2",
  "description": "Portal for the browser (RFC 0029): a statically composed WebAssembly client (Emscripten, wasm32) whose render core uses the WebGPU adapter over the browser's webgpu.h (the pinned Dawn release's emdawnwebgpu port). The engine runs in a worker on an OffscreenCanvas page (tools/web); tools/web/run_node.cjs is its Node lane. The shader API is the core shader API (materialsystem/shaderapicore), which draws every material through the render core on WebGPU and presents to the page's canvas.",
  "aliases": [
    "portal@wasm32"
  ],
  "target": {
    "product": "portal-client",
    "os": "emscripten",
    "architecture": "wasm32"
  },
  "toolchain": {
    "family": "emscripten",
    "version": "6.0.10",
    "cc": "emcc",
    "cxx": "em++",
    "dialect_policy": "quality/toolchain/policy.json",
    "build_type": "release"
  },
  "configure_options": {
    "build_type": "release",
    "disable_warns": true,
    "static_composition": true,
    "render_backend": "core",
    "platform_provider": "sdl3",
    "build_games": "portal",
    "render_core_webgpu": true,
    "render_core_device": "webgpu"
  },
  "build": {
    "toolchain": "emscripten",
    "default_flavor": "dev",
    "flavors": {
      "dev": {
        "description": "The browser client with function names kept for the browser's and Node's stacks",
        "configure_options": {}
      }
    }
  },
  "pipeline": {
    "stages": [
      "waf-engine"
    ]
  },
  "package": {
    "form": "linux-dir",
    "directory": "runtime",
    "steps": [
      {
        "op": "seed",
        "from": "portal-base",
        "marker": "portal/gameinfo.txt",
        "game": "portal",
        "shared_suffixes": [
          ".vpk",
          ".bsp",
          ".vtf",
          ".vmt",
          ".mdl",
          ".vvd",
          ".vtx",
          ".phy",
          ".wav",
          ".mp3",
          ".ogg",
          ".webm",
          ".bik"
        ],
        "skip_directories": [
          "screenshots",
          "save",
          "logs",
          "dumps"
        ],
        "skip_suffixes": [
          ".log",
          ".dmp"
        ]
      },
      {
        "op": "overlay",
        "artifact": "engine-install",
        "include": [
          "hl2_launcher.js",
          "hl2_launcher.wasm"
        ]
      }
    ]
  },
  "content": {
    "locators": {
      "portal-base": {
        "default": "{root}/run/runtime",
        "description": "A runnable Portal tree (retail content and its third-party libraries) to seed the runtime from once"
      },
      "published-maps": {
        "default": "{root}/run/maps",
        "description": "Maps published by tools/quality/pbrt_map_build.py (playable_maps.py), mounted as portal/custom/pbrt-<map>"
      }
    }
  },
  "launch": {
    "display_session": "user",
    "run": "browser-page",
    "game": "portal",
    "default_map": "testchmb_a_01",
    "executable": "{root}/tools/web/serve.py",
    "variables": {
      "width": [
        "1280"
      ],
      "height": [
        "720"
      ],
      "port": [
        "8080"
      ],
      "web_out": [
        "{runtime}/../web-session"
      ],
      "web_profile": [
        "{runtime}/../web-profile"
      ]
    },
    "arguments": [],
    "peers": [
      {
        "name": "server",
        "executable": "{root}/tools/web/serve.py",
        "arguments": [
          "--build",
          "{runtime}",
          "--content",
          "{runtime}",
          "--port",
          "{port}",
          "--out",
          "{web_out}",
          "--firefox-profile",
          "{web_profile}",
          "--",
          "-game",
          "portal",
          "-novid",
          "-noip",
          "-w",
          "{width}",
          "-h",
          "{height}",
          "+r_core_world",
          "1",
          "+r_core_dynamic_draws",
          "1",
          "{args}",
          "+map",
          "{map}"
        ]
      },
      {
        "name": "browser",
        "executable": "firefox",
        "arguments": [
          "--no-remote",
          "--new-instance",
          "--profile",
          "{web_profile}",
          "http://127.0.0.1:{port}/"
        ]
      }
    ],
    "facts": {
      "port": "{port}",
      "timeout": "60"
    },
    "switches": {},
    "environment": {
      "MOZ_ENABLE_WAYLAND": "1"
    }
  }
}
