{
  "schema": "source-product-profile/v2",
  "id": "portal2-3ds-pica-v2",
  "description": "Portal 2 on the New Nintendo 3DS (RFC 0026): a statically composed client drawing through the render core's PICA200 device, built with devkitARM from its image pinned by digest and the pinned SDL3 cross-built by the n3ds-devkitarm toolchain. Replaces build-3ds.sh.",
  "aliases": [
    "portal2@3ds"
  ],
  "target": {
    "product": "portal2-client",
    "os": "3ds",
    "architecture": "armv6k"
  },
  "toolchain": {
    "family": "devkitarm",
    "version": "16.1.0",
    "cc": "arm-none-eabi-gcc",
    "cxx": "arm-none-eabi-g++",
    "dialect_policy": "quality/toolchain/policy.json",
    "build_type": "release"
  },
  "dependencies": {
    "container_image": "devkitpro/devkitarm@sha256:116afba8df8453961de2936ffab20dd441edf4d682856c1ec8b0e53d7ed0bbf5",
    "archives": {
      "sdl3": {
        "path": "dependencies/3ds/archives/SDL3-3.4.16.tar.gz",
        "sha256": "7322236cd12090c3eb40b9728be4d49c76f66ad17d04369584d4ecad5cf77c68",
        "directory": "SDL3-3.4.16",
        "cmake_options": [
          "-DSDL_SHARED=OFF",
          "-DSDL_STATIC=ON",
          "-DSDL_TESTS=OFF",
          "-DSDL_EXAMPLES=OFF"
        ]
      }
    }
  },
  "configure_options": {
    "build_type": "release",
    "disable_warns": true,
    "static_composition": true,
    "use_ccache": true,
    "render_backend": "pica",
    "platform_provider": "sdl3",
    "build_games": "portal2",
    "video_provider": "none"
  },
  "build": {
    "toolchain": "n3ds-devkitarm",
    "default_flavor": "dev",
    "flavors": {
      "dev": {
        "description": "The 3DS client as the Azahar harness runs it (tools/n3ds/n3ds.py)",
        "configure_options": {}
      }
    }
  },
  "pipeline": {
    "stages": [
      "waf-engine"
    ]
  },
  "launch": {
    "game": "portal2",
    "default_map": "sp_a1_intro4",
    "executable": "hl2_launcher"
  }
}
