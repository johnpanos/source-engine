{
  "schema": "source-product-fragment/v2",
  "id": "windows-x86_64-msvc-wine-v2",
  "description": "Shared build facts of the Windows x86_64 products built on Linux (RFC 0027): MSVC under Wine. tools/windows/msvc_wine.py provisions the pinned Visual Studio Build Tools and Windows SDK with mstorsjo/msvc-wine into dependencies/windows-msvc-wine/; the windows-msvc-wine toolchain provider checks that install and passes --msvc-wine to Waf. The MSVC toolset equals the hosted windows-2022 runner's (14.44), so a local build answers what CI's MSVC lane would. The products run under the host's Wine (the wine run provider).",
  "target": {
    "os": "windows",
    "architecture": "x86_64"
  },
  "toolchain": {
    "cxx": "cl",
    "cc": "cl",
    "family": "msvc",
    "version": "19.44",
    "standard_library": "msvc-stl",
    "dialect_policy": "quality/toolchain/policy.json",
    "msvc_wine": {
      "repository": "https://github.com/mstorsjo/msvc-wine",
      "commit": "514f8ea34842cd6d831804d0e9658d3a32870ae1",
      "archive_sha256": "ad0d0aef7590fbe2c2338abc289be36c869ff9a076e7790f7d62b483458f5e55",
      "visual_studio": "17.14.41",
      "installer_manifest": {
        "url": "https://download.visualstudio.microsoft.com/download/pr/bc92e2cb-33de-4a0c-995d-efa817f16b16/6e470016e4324c84c255ffd0beb3767d17ec89cc8561e9409ee3e1f6d29400f5/VisualStudio.vsman",
        "sha256": "f0a50ea157222c29abd5ea6ff01bfc3c33b04e011c5e45ee2ca38ef0778e5643"
      },
      "msvc_version": "17.14",
      "msvc_toolset": "14.44",
      "sdk_version": "10.0.26100",
      "architectures": [
        "x64",
        "x86"
      ]
    }
  },
  "configure_options": {
    "build_type": "release",
    "disable_warns": true
  },
  "build": {
    "toolchain": "windows-msvc-wine",
    "default_flavor": "dev",
    "flavors": {
      "dev": {
        "description": "Development build",
        "configure_options": {}
      }
    }
  },
  "pipeline": {
    "stages": [
      "waf-engine"
    ]
  }
}
