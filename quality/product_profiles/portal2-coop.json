{
  "schema": "source-product-profile/v2",
  "id": "portal2-coop-v2",
  "description": "Portal 2 co-op on two copies of the runtime, as the retired ./play_p2_coop did: the host (Atlas) runs a two-player listen server on the co-op map, and once it answers, the client (P-body) connects over the LAN; the coop-pair run provider watches the host's engine.log for the join. Builds the Portal 2 product in its own tree.",
  "extends": [
    "portal2-linux-native-vulkan.json"
  ],
  "aliases": [
    "portal2-coop@linux-x86_64"
  ],
  "launch": {
    "default_map": "mp_coop_start",
    "run": "coop-pair",
    "map_arguments": [],
    "variables": {
      "port": [
        "27015"
      ],
      "client_port": [
        "27025"
      ],
      "coop_width": [
        "1280"
      ],
      "coop_height": [
        "720"
      ],
      "coop_timeout": [
        "300"
      ],
      "lan_address": [
        "{lan_address}"
      ],
      "coop_stop": [
        "0"
      ]
    },
    "peers": [
      {
        "name": "host",
        "arguments": [
          "-multirun",
          "-windowed",
          "-w",
          "{coop_width}",
          "-h",
          "{coop_height}",
          "-x",
          "0",
          "-y",
          "0",
          "-port",
          "{port}",
          "+sv_lan",
          "1",
          "+maxplayers",
          "2",
          "+sv_cheats",
          "1",
          "{args}",
          "+mp_wait_for_other_player_notconnecting_timeout",
          "{coop_timeout}",
          "+mp_wait_for_other_player_timeout",
          "{coop_timeout}",
          "+map",
          "{map}"
        ]
      },
      {
        "name": "client",
        "arguments": [
          "-multirun",
          "-port",
          "{client_port}",
          "-nolog",
          "-windowed",
          "-w",
          "{coop_width}",
          "-h",
          "{coop_height}",
          "-x",
          "{coop_width}",
          "-y",
          "0",
          "+sv_cheats",
          "1",
          "{args}",
          "+connect",
          "{lan_address}:{port}"
        ]
      }
    ],
    "facts": {
      "port": "{port}",
      "join_log": "engine.log",
      "timeout": "{coop_timeout}",
      "stop_after_join": "{coop_stop}"
    },
    "switches": {
      "until-joined": {
        "description": "Stop both peers once the client has joined (for checks)",
        "set": {
          "coop_stop": [
            "1"
          ]
        }
      }
    }
  }
}
