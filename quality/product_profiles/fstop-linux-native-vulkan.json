{
  "schema": "source-product-profile/v2",
  "id": "fstop-linux-native-vulkan-v2",
  "description": "F-Stop on Linux x86_64 (Portal 1 plus Valve's F-Stop content, ./play_fstop, tree build-fstop).",
  "extends": [
    "fragments/linux-x86_64-desktop.json",
    "fragments/desktop-launch.json"
  ],
  "aliases": [
    "fstop@linux-x86_64"
  ],
  "target": {
    "product": "fstop-client"
  },
  "configure_options": {
    "platform_provider": "sdl3",
    "render_backend": "native-vulkan",
    "build_games": "fstop"
  },
  "launch": {
    "game": "fstop",
    "default_map": "fstop_mechanics",
    "executable": "hl2_launcher",
    "variables": {
      "width": [
        "1920"
      ],
      "height": [
        "1080"
      ],
      "renderer": [
        "native-vulkan"
      ],
      "job_args": [
        "+cl_render_start_graph",
        "2",
        "+sv_querycache_job_graph",
        "2",
        "+portal_carve_job_graph",
        "2",
        "-vkemitparallel",
        "1"
      ],
      "mat_args": [
        "+mat_bumpmap",
        "1",
        "+mat_picmip",
        "-1",
        "+r_lod",
        "0"
      ]
    },
    "arguments": [
      "-game",
      "fstop",
      "-windowed",
      "-w",
      "{width}",
      "-h",
      "{height}",
      "-renderer",
      "{renderer}",
      "-physics",
      "{physics}",
      "{physics_args}",
      "{job_args}",
      "{mat_args}",
      "-novid",
      "-insecure",
      "{queue}",
      "+map",
      "{map}",
      "{args}"
    ],
    "environment": {
      "SDL_VIDEODRIVER": "wayland",
      "SDL_VIDEO_DRIVER": "wayland",
      "SteamAppId": "400",
      "SteamGameId": "400",
      "LD_LIBRARY_PATH": "{runtime}/bin:{inherit}"
    }
  }
}
