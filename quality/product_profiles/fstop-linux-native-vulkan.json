{
  "schema": "source-product-profile/v2",
  "id": "fstop-linux-native-vulkan-v2",
  "description": "F-Stop on Linux x86_64 (Portal 1 plus Valve's F-Stop content; kiln play fstop, formerly ./play_fstop).",
  "extends": [
    "fragments/linux-x86_64-desktop.json",
    "fragments/desktop-launch.json"
  ],
  "aliases": [
    "fstop@linux-x86_64"
  ],
  "target": {
    "product": "fstop-client"
  },
  "configure_options": {
    "platform_provider": "sdl3",
    "render_backend": "native-vulkan",
    "build_games": "fstop"
  },
  "launch": {
    "game": "fstop",
    "default_map": "fstop_mechanics",
    "executable": "hl2_launcher",
    "variables": {
      "width": [
        "1920"
      ],
      "height": [
        "1080"
      ],
      "renderer": [
        "native-vulkan"
      ],
      "job_args": [
        "+cl_render_start_graph",
        "2",
        "+sv_querycache_job_graph",
        "2",
        "+portal_carve_job_graph",
        "2"
      ],
      "mat_args": [
        "+mat_bumpmap",
        "1",
        "+mat_picmip",
        "-1",
        "+r_lod",
        "0"
      ]
    },
    "arguments": [
      "-game",
      "fstop",
      "-windowed",
      "-w",
      "{width}",
      "-h",
      "{height}",
      "-renderer",
      "{renderer}",
      "-physics",
      "{physics}",
      "{physics_args}",
      "{job_args}",
      "{mat_args}",
      "-novid",
      "-insecure",
      "{queue}",
      "+map",
      "{map}",
      "{args}"
    ],
    "environment": {
      "SDL_VIDEODRIVER": "wayland",
      "SDL_VIDEO_DRIVER": "wayland",
      "SteamAppId": "400",
      "SteamGameId": "400",
      "LD_LIBRARY_PATH": "{runtime}/bin:{inherit}"
    }
  },
  "pipeline": {
    "stages": [
      "waf-engine",
      "fstop-content"
    ]
  },
  "package": {
    "form": "linux-dir",
    "directory": "runtime",
    "steps": [
      {
        "op": "seed",
        "from": "portal-base",
        "marker": "portal/gameinfo.txt",
        "game": "portal",
        "shared_suffixes": [
          ".vpk",
          ".bsp",
          ".vtf",
          ".vmt",
          ".mdl",
          ".vvd",
          ".vtx",
          ".phy",
          ".wav",
          ".mp3",
          ".ogg",
          ".webm",
          ".bik"
        ],
        "skip_directories": [
          "screenshots",
          "save",
          "logs",
          "dumps"
        ],
        "skip_suffixes": [
          ".log",
          ".dmp"
        ]
      },
      {
        "op": "overlay",
        "artifact": "fstop-content",
        "include": [
          "**"
        ]
      },
      {
        "op": "overlay",
        "artifact": "engine-install",
        "include": [
          "hl2_launcher",
          "bin/*.so",
          "fstop/bin/*.so"
        ]
      },
      {
        "op": "remove-elf32",
        "directories": [
          "bin",
          "portal/bin"
        ]
      }
    ]
  },
  "content": {
    "locators": {
      "portal-base": {
        "default": "{root}/run/runtime",
        "description": "A runnable Portal tree to seed from (FSTOP_BASE_RUNTIME)"
      },
      "fstop-depot": {
        "default": "{home}/Downloads/portal2-steam2-research/852_0",
        "description": "Valve's Steam2 depot 852 version 0, extracted: portal2/ and portal2_tempcontent/ (FSTOP_CONTENT)"
      },
      "portal2-runtime": {
        "default": "{root}/run/runtime-p2",
        "description": "A staged Portal 2 runtime for the shop-door models (optional)"
      }
    }
  }
}
