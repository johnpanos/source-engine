{
  "schema": "source-product-profile/v2",
  "id": "portal-linux-dxvk-v2",
  "description": "Portal on Linux x86_64 through DXVK Native's D3D9 (./play dxvk, tree build-portal-vulkan). Configure reads the pinned DXVK Native package from dependencies/dxvk-native-2.7.1/usr (verified against dependencies.dxvk_native by the wscript); tools/quality/product_profile.py fetch provides it until L1's `kiln deps`.",
  "extends": [
    "portal-linux-wayland.json",
    "fragments/linux-x86_64-desktop.json",
    "fragments/desktop-launch.json",
    "fragments/render-switches.json"
  ],
  "aliases": [
    "portal-dxvk@linux-x86_64"
  ],
  "configure_options": {
    "dxvk_root": "dependencies/dxvk-native-2.7.1/usr"
  },
  "launch": {
    "game": "portal",
    "default_map": "testchmb_a_01",
    "executable": "hl2_launcher",
    "arguments": [
      "-renderer",
      "vulkan-compat",
      "-physics",
      "vphysics_box3d",
      "-physics_shape_inertia",
      "-novid",
      "-insecure"
    ],
    "environment": {
      "SteamAppId": "400",
      "SteamGameId": "400",
      "DXVK_WSI_DRIVER": "SDL3"
    }
  }
}
