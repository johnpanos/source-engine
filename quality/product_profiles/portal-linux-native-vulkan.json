{
  "schema": "source-product-profile/v2",
  "id": "portal-linux-native-vulkan-v2",
  "description": "Portal on Linux x86_64, SDL3 and native Vulkan with the render core: the product ./play and run.sh build today (tree build/); the launch reproduces run.sh with run.conf's settings. Pins and evidence are the v1 slice's (extends portal-linux-wayland-native-vulkan.json).",
  "extends": [
    "portal-linux-wayland-native-vulkan.json",
    "fragments/linux-x86_64-desktop.json",
    "fragments/desktop-launch.json",
    "fragments/render-switches.json"
  ],
  "aliases": [
    "portal@linux-x86_64"
  ],
  "launch": {
    "game": "portal",
    "default_map": "testchmb_a_01",
    "executable": "hl2_launcher",
    "variables": {
      "width": [
        "1920"
      ],
      "height": [
        "1080"
      ],
      "frame_cap": [
        "120"
      ],
      "windowed": [
        "-windowed"
      ],
      "renderer": [
        "native-vulkan"
      ],
      "job_args": [
        "+cl_render_start_graph",
        "2",
        "+sv_querycache_job_graph",
        "2",
        "+portal_carve_job_graph",
        "2",
        "-vkemitparallel",
        "1"
      ],
      "mat_args": [
        "+mat_bumpmap 1",
        "+mat_picmip -1",
        "+r_lod 0",
        "+r_indirect_producer auto"
      ]
    },
    "arguments": [
      "-game",
      "portal",
      "-w",
      "{width}",
      "-h",
      "{height}",
      "-renderer",
      "{renderer}",
      "-physics",
      "{physics}",
      "{physics_args}",
      "+fps_max",
      "{frame_cap}",
      "{job_args}",
      "{mat_args}",
      "+map",
      "{map}",
      "{windowed}",
      "-novid",
      "-insecure",
      "{queue}",
      "{args}",
      "{switches}",
      "{core_world}",
      "+r_indirect_producer",
      "{producer}",
      "+r_core_runtime_direct",
      "{runtime_direct}",
      "+r_core_area_lights",
      "{area_lights}"
    ],
    "environment": {
      "SDL_VIDEODRIVER": "wayland",
      "SDL_VIDEO_DRIVER": "wayland",
      "SteamAppId": "400",
      "SteamGameId": "400",
      "LD_LIBRARY_PATH": "{runtime}/bin:{inherit}"
    },
    "switches": {
      "null": {
        "description": "No rendering (the null device), for headless checks",
        "set": {
          "renderer": [
            "null"
          ],
          "core_world": []
        },
        "conflicts": [
          "core-world"
        ]
      }
    }
  }
}
