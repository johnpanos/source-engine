{
  "schema": "source-product-profile/v2",
  "id": "portal2-retail-v2",
  "description": "The installed retail Portal 2 run as is, for comparisons (./play_p2 --retail execs Steam's portal2.sh from the repository root). Nothing is built.",
  "extends": [
    "fragments/desktop-launch.json"
  ],
  "aliases": [
    "portal2-retail@linux-x86_64"
  ],
  "target": {
    "product": "portal2-retail",
    "os": "linux",
    "architecture": "x86_64"
  },
  "launch": {
    "game": "portal2",
    "run": "external-install",
    "executable": "{locator:steam-portal2}/portal2.sh",
    "working_directory": "{root}",
    "arguments": [
      "{args}"
    ],
    "environment": {}
  },
  "content": {
    "locators": {
      "steam-portal2": {
        "default": "{home}/.local/share/Steam/steamapps/common/Portal 2",
        "description": "The installed retail Portal 2 (P2_STEAM_ROOT)"
      }
    }
  }
}
