{
  "schema": "source-product-profile/v2",
  "id": "portal2-linux-native-vulkan-v2",
  "description": "Portal 2 on Linux x86_64, SDL3 and native Vulkan with the render core and the GL adapter: the product the retired ./play_p2 built (tree build-p2).",
  "extends": [
    "fragments/linux-x86_64-desktop.json",
    "fragments/desktop-launch.json",
    "fragments/render-switches.json"
  ],
  "aliases": [
    "portal2@linux-x86_64"
  ],
  "target": {
    "product": "portal2-client"
  },
  "configure_options": {
    "platform_provider": "sdl3",
    "render_backend": "core",
    "render_core_device": "vulkan",
    "build_games": "portal2",
    "physics_backend": "both",
    "render_core_gl": true
  },
  "launch": {
    "game": "portal2",
    "executable": "hl2_launcher",
    "map_arguments": [
      "+map",
      "{map}"
    ],
    "variables": {
      "job_args": [
        "+cl_render_start_graph",
        "2",
        "+sv_querycache_job_graph",
        "2"
      ],
      "mat_args": [
        "+mat_colorcorrection",
        "1"
      ],
      "video": [],
      "renderer_args": [
        "-renderer",
        "pica"
      ],
      "fsr_args": []
    },
    "arguments": [
      "-game",
      "portal2",
      "-physics",
      "{physics}",
      "{physics_args}",
      "{job_args}",
      "{mat_args}",
      "{queue}",
      "{video}",
      "{switches}",
      "{core_world}",
      "+r_indirect_producer",
      "{producer}",
      "+r_core_runtime_direct",
      "{runtime_direct}",
      "+r_core_area_lights",
      "{area_lights}",
      "{renderer_args}",
      "{fsr_args}",
      "{map_arguments}",
      "{args}"
    ],
    "environment": {
      "SteamAppId": "620",
      "SteamGameId": "620",
      "LD_LIBRARY_PATH": "{runtime}/bin:{inherit}"
    },
    "switches": {
      "null": {
        "description": "No rendering (the null device), for headless checks",
        "set": {
          "renderer_args": [
            "-renderer",
            "null"
          ],
          "core_world": []
        },
        "conflicts": [
          "core-world"
        ]
      },
      "bink": {
        "description": "Retail Bink movies instead of the AV1 transcodes (VIDEO_ARGS=\"-video-provider bink\")",
        "set": {
          "video": [
            "-video-provider",
            "bink"
          ]
        }
      }
    }
  },
  "package": {
    "form": "linux-dir",
    "directory": "runtime",
    "steps": [
      {
        "op": "seed",
        "from": "steam-portal2",
        "marker": "portal2/gameinfo.txt",
        "game": "portal2",
        "content_only": true,
        "shared_suffixes": [
          ".vpk",
          ".bsp",
          ".vtf",
          ".vmt",
          ".mdl",
          ".vvd",
          ".vtx",
          ".phy",
          ".wav",
          ".mp3",
          ".ogg",
          ".webm",
          ".bik"
        ],
        "skip_directories": [
          "screenshots",
          "save",
          "logs",
          "dumps"
        ],
        "skip_suffixes": [
          ".log",
          ".dmp"
        ]
      },
      {
        "op": "link",
        "path": "update",
        "from": "steam-portal2",
        "source": "update",
        "check": "pak01_dir.vpk"
      },
      {
        "op": "link",
        "path": "portal2_dlc2",
        "from": "steam-portal2",
        "source": "portal2_dlc2",
        "check": "pak01_dir.vpk"
      },
      {
        "op": "link",
        "path": "portal2_dlc1",
        "from": "steam-portal2",
        "source": "portal2_dlc1",
        "check": "pak01_dir.vpk"
      },
      {
        "op": "link",
        "path": "retail_platform",
        "from": "steam-portal2",
        "source": "platform",
        "check": "resource"
      },
      {
        "op": "link",
        "path": "media_av1",
        "from": "av1-media",
        "check": "manifest.json",
        "optional": true
      },
      {
        "op": "extract-packs",
        "mount_set": "p2ce-workshop",
        "from": "steam-workshop",
        "manifest": "quality/materials/p2ce-workshop-mounts.json",
        "format": "p2ce-workshop-mounts/v1",
        "into": "workshop"
      },
      {
        "op": "search-paths",
        "file": "portal2/gameinfo.txt",
        "lines": [
          "game+mod\t\t\t|gameinfo_path|custom/*",
          {
            "mount_set": "p2ce-workshop",
            "each_record": "workshop/mounts.json",
            "line": "game+mod\t\t\t|gameinfo_path|../workshop/{item}"
          },
          {
            "when_exists": "media_av1/update/media",
            "line": "game+mod\t\t\t|gameinfo_path|../media_av1/update"
          },
          "game+mod\t\t\t|gameinfo_path|../update/pak01_dir.vpk",
          "game+mod\t\t\t|gameinfo_path|../update",
          {
            "when_exists": "media_av1/portal2_dlc2/media",
            "line": "game+mod\t\t\t|gameinfo_path|../media_av1/portal2_dlc2"
          },
          "game+mod\t\t\t|gameinfo_path|../portal2_dlc2/pak01_dir.vpk",
          "game+mod\t\t\t|gameinfo_path|../portal2_dlc2",
          {
            "when_exists": "media_av1/portal2_dlc1/media",
            "line": "game+mod\t\t\t|gameinfo_path|../media_av1/portal2_dlc1"
          },
          "game+mod\t\t\t|gameinfo_path|../portal2_dlc1/pak01_dir.vpk",
          "game+mod\t\t\t|gameinfo_path|../portal2_dlc1",
          {
            "when_exists": "media_av1/portal2/media",
            "line": "game+mod\t\t\t|gameinfo_path|../media_av1/portal2"
          },
          "game+mod\t\t\t|gameinfo_path|pak01_dir.vpk",
          "game+mod+mod_write+game_write+default_write_path\t|gameinfo_path|.",
          "gamebin\t\t\t\t|gameinfo_path|bin",
          "platform\t\t\t|gameinfo_path|../platform",
          "platform\t\t\t|gameinfo_path|../retail_platform"
        ]
      },
      {
        "op": "extract",
        "from": "steam-portal2",
        "archive": "portal2/pak01_dir.vpk",
        "entry": "materials/console/portal2_product_1_widescreen.vtf",
        "path": "portal2/materials/console/background_menu_widescreen.vtf"
      },
      {
        "op": "extract",
        "from": "steam-portal2",
        "archive": "portal2/pak01_dir.vpk",
        "entry": "materials/console/portal2_product_1.vtf",
        "path": "portal2/materials/console/background_menu.vtf"
      },
      {
        "op": "mount-each",
        "from": "published-maps",
        "into": "portal2/custom",
        "prefix": "pbrt-",
        "record": "published.json",
        "require": "maps/{name}.bsp",
        "skip_if_exists": "portal2/maps/{name}.bsp",
        "optional": true
      },
      {
        "op": "overlay",
        "artifact": "engine-install",
        "include": [
          "hl2_launcher",
          "bin/*.so",
          "portal2/bin/*.so"
        ]
      }
    ]
  },
  "content": {
    "locators": {
      "steam-portal2": {
        "default": "{home}/.local/share/Steam/steamapps/common/Portal 2",
        "description": "The installed retail Portal 2 (P2_STEAM_ROOT)"
      },
      "av1-media": {
        "default": "{root}/run/media-av1",
        "description": "AV1 transcodes of the retail movies, filled by the video-av1 stage (P2_AV1_MEDIA); the packager links them when manifest.json exists",
        "create": true
      },
      "published-maps": {
        "default": "{root}/run/maps",
        "description": "Maps published by the map pipeline, mounted as portal2/custom/pbrt-<map>"
      },
      "steam-workshop": {
        "default": "{home}/.local/share/Steam/steamapps/workshop/content/440000",
        "description": "The Steam Workshop content of P2:CE (app 440000)"
      }
    },
    "mount_sets": {
      "p2ce-workshop": {
        "description": "The opt-in P2:CE Workshop packs of quality/materials/p2ce-workshop-mounts.json, ahead of retail content (kiln play portal2 --mounts p2ce-workshop)"
      }
    }
  },
  "pipeline": {
    "stages": [
      "waf-engine",
      "video-av1"
    ]
  }
}
