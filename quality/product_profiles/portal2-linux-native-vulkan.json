{
  "schema": "source-product-profile/v2",
  "id": "portal2-linux-native-vulkan-v2",
  "description": "Portal 2 on Linux x86_64, SDL3 and native Vulkan with the render core and the GL adapter: the product ./play_p2 builds today (tree build-p2).",
  "extends": [
    "fragments/linux-x86_64-desktop.json",
    "fragments/desktop-launch.json",
    "fragments/render-switches.json"
  ],
  "aliases": [
    "portal2@linux-x86_64"
  ],
  "target": {
    "product": "portal2-client"
  },
  "configure_options": {
    "platform_provider": "sdl3",
    "render_backend": "native-vulkan",
    "build_games": "portal2",
    "physics_backend": "both",
    "render_core_gl": true
  },
  "launch": {
    "game": "portal2",
    "executable": "hl2_launcher",
    "map_arguments": [
      "+map",
      "{map}"
    ],
    "variables": {
      "job_args": [
        "+cl_render_start_graph",
        "2",
        "+sv_querycache_job_graph",
        "2",
        "-vkemitparallel",
        "1"
      ],
      "mat_args": [
        "+mat_colorcorrection",
        "1"
      ],
      "video": [],
      "renderer_args": [],
      "fsr_args": []
    },
    "arguments": [
      "-game",
      "portal2",
      "-physics",
      "{physics}",
      "{physics_args}",
      "{job_args}",
      "{mat_args}",
      "{queue}",
      "{video}",
      "{switches}",
      "{core_world}",
      "+r_indirect_producer",
      "{producer}",
      "+r_core_runtime_direct",
      "{runtime_direct}",
      "+r_core_area_lights",
      "{area_lights}",
      "{renderer_args}",
      "{fsr_args}",
      "{map_arguments}",
      "{args}"
    ],
    "environment": {
      "SteamAppId": "620",
      "SteamGameId": "620",
      "LD_LIBRARY_PATH": "{runtime}/bin:{inherit}"
    },
    "switches": {
      "null": {
        "description": "No rendering (the null device), for headless checks",
        "set": {
          "renderer_args": [
            "-renderer",
            "null"
          ],
          "core_world": []
        },
        "conflicts": [
          "core-world"
        ]
      },
      "bink": {
        "description": "Retail Bink movies instead of the AV1 transcodes (VIDEO_ARGS=\"-video-provider bink\")",
        "set": {
          "video": [
            "-video-provider",
            "bink"
          ]
        }
      }
    }
  }
}
