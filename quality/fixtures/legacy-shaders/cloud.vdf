// Cloud_dx9 (cloud_ps20 / cloud_vs20): the base texture (scaled by $cloudscale
// through the base transform) times the cloud alpha texture (on uv1, scaled by
// $maskscale), alpha blended over the clear color; alpha is shaped by the
// range fog factor's smoothstep. Varied vertex depths move the fog factor
// across the smoothstep (range fog 0..1 over the quad's depth).
"LegacyShaderCases"
{
	"texture"
	{
		"name" "conformance/legacy/cloud_base"
		"width" "4"
		"height" "4"
		"texels" "200 100 50 255   40 160 220 200   120 120 120 128   255 255 255 60   30 90 150 255   250 20 90 180   10 240 60 220   90 90 200 100   180 180 30 255   60 20 120 140   220 140 80 240   20 20 20 255   100 200 250 90   255 128 0 255   0 128 255 200   128 64 32 170"
	}
	"texture"
	{
		"name" "conformance/legacy/cloud_alpha"
		"width" "2"
		"height" "2"
		"point" "1"
		"texels" "255 255 255 255   200 150 100 180   120 220 160 90   60 60 250 230"
	}
	"case"
	{
		"name" "cloud_blend"
		"shader" "Cloud"
		"clear" "30 60 120 255"
		"material"
		{
			"$basetexture" "conformance/legacy/cloud_base"
			"$cloudalphatexture" "conformance/legacy/cloud_alpha"
			"$cloudscale" "[2 1]"
			"$maskscale" "[1 2]"
		}
		"fog" { "mode" "linear" "start" "0" "end" "1" "color" "255 0 0" }
		"vertex" { "pos" "-1 1 0.1" "uv0" "0 0" "uv1" "0 0" }
		"vertex" { "pos" "1 1 0.5" "uv0" "1 0" "uv1" "1 0" }
		"vertex" { "pos" "1 -1 0.9" "uv0" "1 1" "uv1" "1 1" }
		"vertex" { "pos" "-1 -1 0.5" "uv0" "0 1" "uv1" "0 1" }
		"points" "0.1 0.1 0.3 0.2 0.6 0.3 0.8 0.8 0.25 0.75 0.5 0.5 0.9 0.4"
	}
	"case"
	{
		"name" "cloud_additive"
		"shader" "Cloud"
		"clear" "30 60 120 255"
		"material"
		{
			"$basetexture" "conformance/legacy/cloud_base"
			"$cloudalphatexture" "conformance/legacy/cloud_alpha"
			"$additive" "1"
			"$cloudscale" "[1 1]"
			"$maskscale" "[1 1]"
		}
		"fog" { "mode" "linear" "start" "0.2" "end" "0.9" "color" "255 0 0" }
		"points" "0.1 0.1 0.3 0.2 0.6 0.3 0.8 0.8 0.25 0.75"
	}
}
