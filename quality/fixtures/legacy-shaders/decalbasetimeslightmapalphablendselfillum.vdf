// DecalBaseTimesLightmapAlphaBlendSelfIllum_DX9: pass 1
// (lightmappedgeneric_decal_ps20b / lightmappedgeneric_decal_vs20) blends the
// decal times the three bumped lightmap pages (uv1 stepped by uv2.x), the
// modulation color and the vertex color; pass 2
// (decalbasetimeslightmapalphablendselfillum2_ps20b / lightmappedgeneric_vs20)
// blends the self-illumination texture over it.
"LegacyShaderCases"
{
	"texture"
	{
		"name" "conformance/legacy/decalbasetimeslightmapalphablendselfillum_base"
		"width" "2"
		"height" "2"
		"point" "1"
		"texels" "220 120 60 255   60 200 140 160   150 150 250 90   250 250 250 200"
	}
	"texture"
	{
		"name" "conformance/legacy/decalbasetimeslightmapalphablendselfillum_mask"
		"width" "2"
		"height" "2"
		"texels" "255 200 100 30   40 90 255 200   255 255 255 0   120 40 200 120"
	}
	"texture"
	{
		"name" "conformance/legacy/decalbasetimeslightmapalphablendselfillum_lightmap"
		"width" "4"
		"height" "2"
		"point" "1"
		"clamp" "1"
		"texels" "128 64 32 255   40 200 120 255   90 90 90 255   250 180 60 255   30 60 200 255   160 160 30 255   200 40 100 255   70 140 210 255"
	}
	"case"
	{
		"name" "decalbasetimeslightmapalphablendselfillum"
		"shader" "DecalBaseTimesLightmapAlphaBlendSelfIllum"
		"clear" "40 80 60 255"
		"lightmap" "conformance/legacy/decalbasetimeslightmapalphablendselfillum_lightmap"
		"material"
		{
			"$basetexture" "conformance/legacy/decalbasetimeslightmapalphablendselfillum_base"
			"$selfillumtexture" "conformance/legacy/decalbasetimeslightmapalphablendselfillum_mask"
			"$color" "[0.9 0.7 1.0]"
			"$alpha" "0.8"
		}
		"vertex" { "pos" "-1 1 0.5" "uv0" "0 0" "uv1" "0 0" "uv2" "0.25 0" "color" "255 200 150 255" }
		"vertex" { "pos" "1 1 0.5" "uv0" "1 0" "uv1" "0.25 0" "uv2" "0.25 0" "color" "255 255 255 230" }
		"vertex" { "pos" "1 -1 0.5" "uv0" "1 1" "uv1" "0.25 1" "uv2" "0.25 0" "color" "150 255 200 255" }
		"vertex" { "pos" "-1 -1 0.5" "uv0" "0 1" "uv1" "0 1" "uv2" "0.25 0" "color" "200 200 255 180" }
		"points" "0.25 0.25 0.75 0.25 0.25 0.75 0.75 0.75 0.5 0.5 0.1 0.9"
	}
}
