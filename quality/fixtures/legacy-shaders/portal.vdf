// Portal_DX90 (portal_ps20b / portal_vs20): the portal texture (or the frame
// buffer copy without $basetexture) at the screen position, darkened by
// $staticamount and mixed with the static texture or gray, cut by the alpha
// mask (alpha blended and alpha tested), through an alternate view matrix,
// with range fog.
"LegacyShaderCases"
{
	"texture"
	{
		"name" "conformance/legacy/portal_view"
		"width" "4"
		"height" "4"
		"texels" "200 100 50 255   40 160 220 200   120 120 120 128   255 255 255 60   30 90 150 255   250 20 90 180   10 240 60 220   90 90 200 100   180 180 30 255   60 20 120 140   220 140 80 240   20 20 20 255   100 200 250 90   255 128 0 255   0 128 255 200   128 64 32 170"
	}
	"texture"
	{
		"name" "conformance/legacy/portal_static"
		"width" "2"
		"height" "2"
		"texels" "255 40 40 255   40 255 90 128   60 60 255 30   240 240 60 190"
	}
	"texture"
	{
		"name" "conformance/legacy/portal_mask"
		"width" "2"
		"height" "2"
		"point" "1"
		"texels" "255 255 255 255   255 255 255 230   255 255 255 0   255 255 255 210"
	}
	"case"
	{
		"name" "portal_framebuffer_gray_static"
		"shader" "Portal"
		"clear" "30 60 120 255"
		"framebuffer" "180 90 40 255"
		"material"
		{
			"$staticamount" "0.3"
		}
		"points" "0.25 0.25 0.75 0.75"
	}
	"case"
	{
		"name" "portal_static_mask"
		"shader" "Portal"
		"clear" "30 60 120 255"
		"material"
		{
			"$basetexture" "conformance/legacy/portal_view"
			"$staticblendtexture" "conformance/legacy/portal_static"
			"$alphamasktexture" "conformance/legacy/portal_mask"
			"$staticamount" "0.4"
		}
		"points" "0.125 0.125 0.375 0.125 0.625 0.375 0.875 0.625 0.3 0.8 0.8 0.8"
	}
	"case"
	{
		"name" "portal_static_fog"
		"shader" "Portal"
		"clear" "30 60 120 255"
		"material"
		{
			"$basetexture" "conformance/legacy/portal_view"
			"$staticblendtexture" "conformance/legacy/portal_static"
			"$staticamount" "0.6"
		}
		"fog" { "mode" "linear" "start" "0" "end" "1" "color" "40 200 90" }
		"vertex" { "pos" "-1 1 0.1" "uv0" "0 0" }
		"vertex" { "pos" "1 1 0.4" "uv0" "1 0" }
		"vertex" { "pos" "1 -1 0.9" "uv0" "1 1" }
		"vertex" { "pos" "-1 -1 0.6" "uv0" "0 1" }
		"points" "0.125 0.125 0.375 0.125 0.625 0.375 0.875 0.625 0.3 0.8"
	}
	"case"
	{
		"name" "portal_alternate_view"
		"shader" "Portal"
		"clear" "30 60 120 255"
		"material"
		{
			"$basetexture" "conformance/legacy/portal_view"
			"$usealternateviewmatrix" "1"
			"$alternateviewmatrix" "[0.8 0.1 0 0.05 0 0.7 0.2 0 0 0 1 0 0 0.1 0 1]"
		}
		"points" "0.125 0.125 0.375 0.125 0.625 0.375 0.875 0.625 0.3 0.8 0.05 0.95"
	}
	"case"
	{
		"name" "portal_mask_no_static"
		"shader" "Portal"
		"clear" "30 60 120 255"
		"material"
		{
			"$basetexture" "conformance/legacy/portal_view"
			"$alphamasktexture" "conformance/legacy/portal_mask"
		}
		"points" "0.125 0.125 0.375 0.125 0.625 0.375 0.875 0.625 0.3 0.8"
	}
}
