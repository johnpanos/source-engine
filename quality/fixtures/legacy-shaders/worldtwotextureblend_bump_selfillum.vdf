		"vertex" { "pos" "1 -1 0.5" "uv0" "1 1" "uv1" "1 1" }
		"vertex" { "pos" "-1 -1 0.5" "uv0" "0 1" "uv1" "0 1" }
		"points" "0.125 0.25 0.375 0.25 0.625 0.25 0.875 0.25 0.125 0.75 0.625 0.75"
	}
	"case"
	{
		"name" "worldtwotextureblend_bumped_lightmap_translucent"
