// WorldTwoTextureBlend's SELFILLUM, DETAIL_ALPHA_MASK_BASE_TEXTURE and BUMPMAP
// combos. worldtwotextureblend_ps2x.fxc's "SKIP: FLASHLIGHT && ..." lines lacked
// the "$", so fxc_prep.pl skipped all of these combos in a source-compiled pack
// although the shader DLL selects them; with the "$" restored they compile.
"LegacyShaderCases"
{
	"texture"
	{
		"name" "conformance/legacy/worldtwotextureblend_retail_base"
		"width" "4"
		"height" "4"
		"texels" "200 100 50 255   40 160 220 200   120 120 120 128   255 255 255 60   30 90 150 255   250 20 90 180   10 240 60 220   90 90 200 100   180 180 30 255   60 20 120 140   220 140 80 240   20 20 20 255   100 200 250 90   255 128 0 255   0 128 255 200   128 64 32 170"
	}
	"texture"
	{
		"name" "conformance/legacy/worldtwotextureblend_retail_detail"
		"width" "2"
		"height" "2"
		"texels" "255 40 40 255   40 255 90 128   60 60 255 30   240 240 60 190"
	}
	"texture"
	{
		"name" "conformance/legacy/worldtwotextureblend_retail_lightmap"
		"width" "4"
		"height" "2"
		"point" "1"
		"clamp" "1"
		"texels" "128 64 32 255   40 200 120 255   90 90 90 255   250 180 60 255   30 60 200 255   160 160 30 255   200 40 100 255   70 140 210 255"
	}
	"texture"
	{
