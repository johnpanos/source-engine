		"clear" "30 60 120 255"
		"lightmap" "conformance/legacy/worldtwotextureblend_retail_lightmap"
		"material"
		{
			"$basetexture" "conformance/legacy/worldtwotextureblend_retail_base"
			"$detail" "conformance/legacy/worldtwotextureblend_retail_detail"
			"$detailscale" "1"
			"$detail_alpha_mask_base_texture" "1"
			"$vertexcolor" "1"
		}
		"vertex" { "pos" "-1 1 0.5" "uv0" "0 0" "uv1" "0 0" "color" "255 128 64 255" }
		"vertex" { "pos" "1 1 0.5" "uv0" "1 0" "uv1" "1 0" "color" "255 255 255 255" }
		"vertex" { "pos" "1 -1 0.5" "uv0" "1 1" "uv1" "1 1" "color" "64 255 128 200" }
		"vertex" { "pos" "-1 -1 0.5" "uv0" "0 1" "uv1" "0 1" "color" "128 128 255 90" }
		"points" "0.125 0.25 0.375 0.25 0.625 0.25 0.875 0.25 0.125 0.75 0.625 0.75"
	}
	"case"
	{
		"name" "worldtwotextureblend_selfillum_detail"
		"shader" "WorldTwoTextureBlend"
		"clear" "30 60 120 255"
		"lightmap" "conformance/legacy/worldtwotextureblend_retail_lightmap"
		"material"
		{
			"$basetexture" "conformance/legacy/worldtwotextureblend_retail_base"
			"$detail" "conformance/legacy/worldtwotextureblend_retail_detail"
			"$selfillum" "1"
