// Modulate_DX9 (modulate_ps20b / unlitgeneric_vs20). The "legacy" family of the
// (unittests/shaderextensiontest/material_pixel_legacy.cpp documents the format;
// tools/quality/legacy_shader_conformance.py runs and judges them).
"LegacyShaderCases"
{
	"texture"
	{
		"name" "conformance/legacy/modulate_quad"
		"width" "2"
		"height" "2"
		"point" "1"
		"clamp" "1"
		"texels" "200 100 50 255   40 160 220 255   120 120 120 128   255 255 255 0"
	}
	"case"
	{
		"name" "modulate"
		"shader" "Modulate"
		"clear" "180 90 200 255"
		"material"
		{
			"$basetexture" "conformance/legacy/modulate_quad"
		}
		"points" "0.25 0.25 0.75 0.25 0.25 0.75 0.75 0.75"
	}
	"case"
	{
		"name" "modulate_mod2x_vertexcolor"
		"shader" "Modulate"
		"clear" "180 90 200 255"
		"material"
		{
			"$basetexture" "conformance/legacy/modulate_quad"
			"$mod2x" "1"
			"$vertexcolor" "1"
		}
		"vertex" { "pos" "-1 1 0.5" "uv0" "0 0" "color" "255 128 64 255" }
		"vertex" { "pos" "1 1 0.5" "uv0" "1 0" "color" "255 128 64 255" }
		"vertex" { "pos" "1 -1 0.5" "uv0" "1 1" "color" "64 255 128 200" }
		"vertex" { "pos" "-1 -1 0.5" "uv0" "0 1" "color" "64 255 128 200" }
		"points" "0.25 0.25 0.75 0.25 0.25 0.75 0.75 0.75"
	}
}
