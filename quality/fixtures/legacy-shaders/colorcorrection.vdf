// ColorCorrection (colorcorrection_ps20b / screenspaceeffect_vs20): the input
// texture (or the frame buffer copy) times $weight_default, plus up to four
// color correction lookup volumes (TEXTURE_COLOR_CORRECTION_VOLUME_0..3) read
// at the input color, each times its weight ($num_lookups 0..4). The engine
// sets $input_texture on a material that never loads it (the cases do the
// same with "texturevars").
"LegacyShaderCases"
{
	"texture"
	{
		"name" "conformance/legacy/colorcorrection_input"
		"width" "4"
		"height" "4"
		"texels" "165 77 202 24  37 48 187 29  109 19 44 222  214 35 123 46  217 30 63 114  31 203 25 113  23 68 148 214  73 60 157 92  52 96 190 49  32 30 105 254  218 160 238 232  185 153 127 92  124 41 153 253  175 229 147 37  60 214 84 175  77 250 215 20"
	}
	"case"
	{
		"name" "colorcorrection_framebuffer"
		"shader" "ColorCorrection"
		"clear" "180 90 200 255"
		"framebuffer" "200 100 50 255"
		"material"
		{
			"$use_fb_texture" "1"
			"$weight_default" "0.6"
		}
