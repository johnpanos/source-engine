		"ambient" "0.10 0.08 0.06  0.02 0.03 0.04  0.05 0.05 0.05  0.01 0.02 0.01  0.03 0.03 0.03  0.20 0.15 0.10"
		"light" { "type" "point" "color" "0.9 0.8 0.7" "position" "0.5 0.6 -1" "attenuation" "0.5 0.2 0.1" }
		"points" "0.2 0.2 0.3 0.7 0.7 0.3 0.8 0.8 0.45 0.55"
	}
