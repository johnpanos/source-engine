		"light" { "type" "point" "color" "0.9 0.8 0.7" "position" "0.5 0.6 -1" "attenuation" "0.5 0.2 0.1" }
		"light" { "type" "directional" "color" "0.4 0.5 0.6" "direction" "0.2 -0.3 0.9" }
		"points" "0.2 0.2 0.3 0.7 0.7 0.3 0.8 0.8 0.45 0.55 0.6 0.6 0.1 0.5 0.5 0.1"
	}
	"case"
	{
		"name" "cloak_full_brush"
		"shader" "Cloak"
		"clear" "20 40 60 255"
		"framebuffer" "160 70 200 255"
		"material"
		{
			"$basetexture" "conformance/legacy/cloak_base"
			"$normalmap" "conformance/legacy/cloak_normal"
			"$cloakfactor" "1"
			"$rimlight" "1"
		}
		"vertex" { "pos" "-1 1 0.5" "uv0" "0 0" "normal" "0 0 -1" "tangents" "1 0 0" "tangentt" "0 1 0" }
		"vertex" { "pos" "1 1 0.5" "uv0" "1 0" "normal" "0 0 -1" "tangents" "1 0 0" "tangentt" "0 1 0" }
