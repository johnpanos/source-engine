// Core_DX90 (core_ps20b / core_vs20): pass 0 refracts the frame copy
// (_rt_FullFrameFB) or $basetexture through the normal map's offset scaled by
// its alpha and $refractamount, tinted by $refracttint; pass 1 (depth EQUAL,
// added) reflects $envmap by the tangent-space normal with $envmaptint,
// $envmapcontrast and $envmapsaturation. The flow map case bends the normal
// map's coordinates by the flow map sampled around the shader's hard-coded
// sphere and blends $corecolortexture. The camera is at the origin and the
// quad at z 0.5 faces it (normals -z); brush cases use the tangent S and T
// streams, the model case TANGENT's user data. Every case has an $envmap: without
// one, pass 0 blends by the normal map's alpha (SetDefaultBlendingShadowState)
// and so writes no depth, and pass 1's EQUAL depth test rejects every pixel,
// which the oracle (no depth buffer) cannot model.
"LegacyShaderCases"
{
	"texture"
	{
		"name" "conformance/legacy/core_normal"
		"width" "4"
		"height" "4"
		"point" "1"
		"texels" "128 128 255 255  170 110 235 200  90 150 230 120  150 150 220 40   110 170 240 180  128 128 255 90  200 60 200 255  60 190 210 150   140 100 235 30  80 128 220 220  128 128 255 255  170 170 200 100   100 100 230 160  150 110 240 60  120 160 235 240  128 128 255 10"
	}
	"texture"
	{
		"name" "conformance/legacy/core_base"
		"width" "4"
		"height" "4"
		"point" "1"
		"clamp" "1"
		"texels" "255 0 0 255  0 255 0 255  0 0 255 255  255 255 0 255   0 255 255 255  255 0 255 255  40 40 40 255  220 220 220 255   10 200 90 255  90 10 200 255  200 90 10 255  128 128 128 255   0 0 0 255  255 255 255 255  60 120 180 255  180 120 60 255"
	}
	"texture"
	{
		"name" "conformance/legacy/core_env"
		"width" "1"
		"height" "1"
		"point" "1"
		"cube" "1"
		"texels" "200 60 60 255  60 200 60 255  60 60 200 255  200 200 60 255  60 200 200 255  200 60 200 255"
	}
	// LoadCubeMap reads "<name>.hdr" with HDR enabled: the same cube under that name.
	"texture"
	{
		"name" "conformance/legacy/core_env.hdr"
		"width" "1"
		"height" "1"
		"point" "1"
		"cube" "1"
		"texels" "200 60 60 255  60 200 60 255  60 60 200 255  200 200 60 255  60 200 200 255  200 60 200 255"
	}
	"texture"
	{
		"name" "conformance/legacy/core_flow"
		"width" "2"
		"height" "2"
		"point" "1"
		"texels" "30 200 0 255  220 60 0 255  128 128 0 255  90 170 0 255"
	}
	"texture"
	{
		"name" "conformance/legacy/core_color"
		"width" "4"
		"height" "1"
		"point" "1"
		"texels" "255 0 0 0  0 255 0 90  0 0 255 180  255 255 255 255"
	}
	"case"
	{
		"name" "core_refract_envmap"
		"shader" "Core"
		"clear" "20 40 60 255"
		"framebuffer" "180 120 60 255"
		"material"
		{
			"$normalmap" "conformance/legacy/core_normal"
			"$envmap" "conformance/legacy/core_env"
			"$refractamount" "0.1"
			"$refracttint" "[0.9 0.7 0.5]"
			"$envmaptint" "[0.6 0.8 0.7]"
			"$envmapcontrast" "0.5"
			"$envmapsaturation" "0.6"
		}
		"vertex" { "pos" "-1 1 0.5" "uv0" "0 0" "normal" "0 0 -1" "tangents" "1 0 0" "tangentt" "0 -1 0" }
		"vertex" { "pos" "1 1 0.5" "uv0" "1 0" "normal" "0 0 -1" "tangents" "1 0 0" "tangentt" "0 -1 0" }
		"vertex" { "pos" "1 -1 0.5" "uv0" "1 1" "normal" "0 0 -1" "tangents" "1 0 0" "tangentt" "0 -1 0" }
		"vertex" { "pos" "-1 -1 0.5" "uv0" "0 1" "normal" "0 0 -1" "tangents" "1 0 0" "tangentt" "0 -1 0" }
		"points" "0.1 0.1 0.35 0.15 0.6 0.1 0.9 0.35 0.15 0.4 0.4 0.6 0.65 0.65 0.85 0.9 0.1 0.9 0.6 0.4"
	}
	"case"
	{
		"name" "core_basetexture_model"
		"shader" "Core"
		"clear" "20 40 60 255"
		"material"
		{
			"$model" "1"
			"$basetexture" "conformance/legacy/core_base"
			"$normalmap" "conformance/legacy/core_normal"
			"$refractamount" "0.2"
			"$refracttint" "[1 0.8 0.9]"
			"$envmap" "conformance/legacy/core_env"
			"$envmaptint" "[0.3 0.3 0.3]"
		}
		"vertex" { "pos" "-1 1 0.5" "uv0" "0 0" "normal" "-0.3 0.3 -0.905539" "userdata" "0.953463 0 -0.301511 1" }
		"vertex" { "pos" "1 1 0.5" "uv0" "1 0" "normal" "0.3 0.3 -0.905539" "userdata" "0.953463 0 0.301511 1" }
		"vertex" { "pos" "1 -1 0.5" "uv0" "1 1" "normal" "0.4 -0.2 -0.894427" "userdata" "0.912871 0 0.408248 -1" }
		"vertex" { "pos" "-1 -1 0.5" "uv0" "0 1" "normal" "0 -0.6 -0.8" "userdata" "1 0 0 -1" }
		"points" "0.1 0.1 0.35 0.15 0.6 0.1 0.9 0.35 0.15 0.4 0.4 0.6 0.65 0.65 0.85 0.9 0.1 0.9 0.6 0.4"
	}
	"case"
	{
		"name" "core_flowmap_corecolor"
		"shader" "Core"
		"clear" "20 40 60 255"
		"framebuffer" "90 160 200 255"
		"material"
		{
			"$normalmap" "conformance/legacy/core_normal"
			"$flowmap" "conformance/legacy/core_flow"
			"$corecolortexture" "conformance/legacy/core_color"
			"$refractamount" "0.3"
			"$flowmaptexcoordoffset" "0.4"
			"$envmap" "conformance/legacy/core_env"
			"$envmaptint" "[0.4 0.2 0.3]"
		}
		"vertex" { "pos" "-1 1 0.5" "uv0" "0 0" "normal" "0 0 -1" "tangents" "1 0 0" "tangentt" "0 -1 0" }
		"vertex" { "pos" "1 1 0.5" "uv0" "1 0" "normal" "0 0 -1" "tangents" "1 0 0" "tangentt" "0 -1 0" }
		"vertex" { "pos" "1 -1 0.5" "uv0" "1 1" "normal" "0 0 -1" "tangents" "1 0 0" "tangentt" "0 -1 0" }
		"vertex" { "pos" "-1 -1 0.5" "uv0" "0 1" "normal" "0 0 -1" "tangents" "1 0 0" "tangentt" "0 -1 0" }
		"points" "0.1 0.1 0.35 0.15 0.6 0.1 0.9 0.35 0.15 0.4 0.4 0.6 0.65 0.65 0.85 0.9"
	}
}
