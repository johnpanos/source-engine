// Refract_DX90 (refract_ps20b / refract_vs20): the refraction of the frame (here
// a procedural $basetexture, which the shader reads in its place) displaced by
// the normal map, tinted, with the cube map, masked, blurred, tint-textured,
// second-normal, silhouette-faded and vertex-color-modulated variants, on a
// brush (TANGENTS/TANGENTT streams) and on a model (TANGENT user data).
// Refract_DX90 draws on the native textured family by default; its passes take
// the legacy port only with -vklegacyrefract, so run this file with
//   legacy_shader_conformance.py --cases <this file> --extra-arg=-vklegacyrefract
"LegacyShaderCases"
{
	"texture"
	{
		"name" "conformance/legacy/refract_scene"
		"width" "4"
		"height" "4"
		"clamp" "1"
		"texels" "250 20 20 255  20 250 20 255  20 20 250 255  250 250 20 255   20 250 250 255  250 20 250 255  60 60 60 255  200 200 200 255   30 180 90 255  90 30 180 255  180 90 30 255  128 128 128 255   10 10 10 255  240 240 240 255  60 120 180 255  180 120 60 255"
	}
	"texture"
	{
		"name" "conformance/legacy/refract_normal"
		"width" "2"
		"height" "2"
		"texels" "200 128 230 255  90 160 230 128  128 60 220 200  170 170 200 40"
	}
	"texture"
	{
		"name" "conformance/legacy/refract_normal2"
		"width" "2"
		"height" "2"
		"texels" "128 200 220 255  60 128 240 255  170 90 220 255  128 128 255 255"
	}
	"texture"
	{
		"name" "conformance/legacy/refract_tint"
		"width" "2"
		"height" "2"
		"texels" "255 128 64 255  64 255 128 255  128 64 255 255  200 200 200 255"
	}
	"texture"
	{
		"name" "conformance/legacy/refract_cube"
		"width" "2"
		"height" "2"
		"cube" "1"
		// Point-sampled: Vulkan filters cube maps seamlessly across faces and
		// D3D9 (and the oracle) within one face, which differ at face edges.
		"point" "1"
		"texels" "255 0 0 255  255 64 0 255  255 0 64 255  200 0 0 255   0 255 0 255  64 255 0 255  0 255 64 255  0 200 0 255   0 0 255 255  64 0 255 255  0 64 255 255  0 0 200 255   255 255 0 255  255 255 64 255  200 255 0 255  255 200 0 255   0 255 255 255  64 255 255 255  0 200 255 255  0 255 200 255   255 0 255 255  255 64 255 255  200 0 255 255  255 0 200 255"
	}
	"texture"
	{
		"name" "conformance/legacy/refract_cube.hdr"
		"width" "2"
		"height" "2"
		"cube" "1"
		// The same cube under the name integer HDR loads ($envmap + ".hdr").
		"point" "1"
		"texels" "255 0 0 255  255 64 0 255  255 0 64 255  200 0 0 255   0 255 0 255  64 255 0 255  0 255 64 255  0 200 0 255   0 0 255 255  64 0 255 255  0 64 255 255  0 0 200 255   255 255 0 255  255 255 64 255  200 255 0 255  255 200 0 255   0 255 255 255  64 255 255 255  0 200 255 255  0 255 200 255   255 0 255 255  255 64 255 255  200 0 255 255  255 0 200 255"
	}
	"case"
	{
		"name" "refract_brush"
		"shader" "Refract"
		"clear" "30 30 30 255"
		"material"
		{
			"$basetexture" "conformance/legacy/refract_scene"
			"$normalmap" "conformance/legacy/refract_normal"
			"$refractamount" "0.15"
			"$refracttint" "[0.9 0.7 0.5]"
		}
		"points" "0.1 0.1 0.3 0.6 0.55 0.45 0.8 0.2 0.9 0.85"
	}
	"case"
	{
		"name" "refract_envmap"
		"shader" "Refract"
		"clear" "30 30 30 255"
		"material"
		{
			"$basetexture" "conformance/legacy/refract_scene"
			"$normalmap" "conformance/legacy/refract_normal"
			"$refractamount" "0.1"
			"$envmap" "conformance/legacy/refract_cube"
			"$envmaptint" "[0.5 0.6 0.7]"
			"$envmapcontrast" "0.5"
			"$envmapsaturation" "[0.4 0.6 0.8]"
		}
		"points" "0.1 0.1 0.3 0.6 0.55 0.45 0.8 0.2 0.9 0.85"
	}
	"case"
	{
		"name" "refract_masked"
		"shader" "Refract"
		"clear" "30 90 150 255"
		"material"
		{
			"$basetexture" "conformance/legacy/refract_scene"
			"$normalmap" "conformance/legacy/refract_normal"
			"$refractamount" "0.2"
			"$masked" "1"
		}
		"points" "0.1 0.1 0.3 0.6 0.55 0.45 0.8 0.2 0.9 0.85"
	}
	"case"
	{
		"name" "refract_blur"
		"shader" "Refract"
		"clear" "30 30 30 255"
		"material"
		{
			"$basetexture" "conformance/legacy/refract_scene"
			"$normalmap" "conformance/legacy/refract_normal"
			"$refractamount" "0.1"
			"$bluramount" "1"
			"$refracttint" "[0.8 0.9 1.0]"
		}
		"points" "0.1 0.1 0.3 0.6 0.55 0.45 0.8 0.2 0.9 0.85"
	}
	"case"
	{
		"name" "refract_tint_normal2_fade"
		"shader" "Refract"
		"clear" "30 30 30 255"
		"material"
		{
			"$basetexture" "conformance/legacy/refract_scene"
			"$normalmap" "conformance/legacy/refract_normal"
			"$normalmap2" "conformance/legacy/refract_normal2"
			"$refracttinttexture" "conformance/legacy/refract_tint"
			"$fadeoutonsilhouette" "1"
			"$refractamount" "0.12"
		}
		"vertex" { "pos" "-1 1 0.5" "uv0" "0 0" "normal" "0.3 0 -0.95" "tangents" "1 0 0" "tangentt" "0 1 0" }
		"vertex" { "pos" "1 1 0.5" "uv0" "1 0" "normal" "0 0.4 -0.9" "tangents" "1 0 0" "tangentt" "0 1 0" }
		"vertex" { "pos" "1 -1 0.5" "uv0" "1 1" "normal" "-0.2 0 -0.97" "tangents" "1 0 0" "tangentt" "0 1 0" }
		"vertex" { "pos" "-1 -1 0.5" "uv0" "0 1" "normal" "0 -0.3 -0.95" "tangents" "1 0 0" "tangentt" "0 1 0" }
		"points" "0.1 0.1 0.3 0.6 0.55 0.45 0.8 0.2 0.9 0.85"
	}
	"case"
	{
		"name" "refract_model_colormodulate"
		"shader" "Refract"
		"clear" "30 30 30 255"
		"material"
		{
			"$basetexture" "conformance/legacy/refract_scene"
			"$normalmap" "conformance/legacy/refract_normal"
			"$refractamount" "0.1"
			"$model" "1"
			"$vertexcolormodulate" "1"
			"$envmap" "conformance/legacy/refract_cube"
		}
		"vertex" { "pos" "-1 1 0.5" "uv0" "0 0" "color" "255 200 150 255" "normal" "0 0 -1" "userdata" "1 0 0 1" }
		"vertex" { "pos" "1 1 0.5" "uv0" "1 0" "color" "150 255 200 180" "normal" "0 0 -1" "userdata" "1 0 0 1" }
		"vertex" { "pos" "1 -1 0.5" "uv0" "1 1" "color" "200 150 255 255" "normal" "0 0 -1" "userdata" "0.8 0.6 0 -1" }
		"vertex" { "pos" "-1 -1 0.5" "uv0" "0 1" "color" "255 255 255 120" "normal" "0 0 -1" "userdata" "0.8 0.6 0 -1" }
		"points" "0.1 0.1 0.3 0.6 0.55 0.45 0.8 0.2 0.9 0.85"
	}
}
