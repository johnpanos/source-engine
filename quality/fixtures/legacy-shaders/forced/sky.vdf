// Sky_HDR_DX9 (integer HDR) and Sky_DX9 (HDR none), both with sky_vs20:
// sky_ps20b scales the base texture by $color; sky_hdr_compressed_rgbs_ps20b
// filters the four RGBS point samples sky_vs20 places around each coordinate
// by hand; sky_hdr_compressed_ps20b returns constant red. Run with --hdr
// integer for the Sky_HDR_DX9 pairs; with --hdr none every case falls back to
// Sky_DX9 on $basetexture (sky_ps20b). The sky ignores Z and writes alpha.
// sky_ps20b draws on the native textured family by default (its port does not
// match D3D9 in integer HDR); the compressed HDR pairs always take their ports.
// Run this file with --extra-arg=-vklegacysky so every case reaches a port.
"LegacyShaderCases"
{
	"texture"
	{
		"name" "conformance/legacy/sky_base"
		"width" "4"
		"height" "4"
		"texels" "200 100 50 255   40 160 220 200   120 120 120 128   255 255 255 60   30 90 150 255   250 20 90 180   10 240 60 220   90 90 200 100   180 180 30 255   60 20 120 140   220 140 80 240   20 20 20 255   100 200 250 90   255 128 0 255   0 128 255 200   128 64 32 170"
	}
	"texture"
	{
		"name" "conformance/legacy/sky_rgbs"
		"width" "4"
		"height" "4"
		"point" "1"
		"texels" "200 100 50 255   40 160 220 64   120 120 120 128   255 255 255 32   30 90 150 255   250 20 90 180   10 240 60 220   90 90 200 100   180 180 30 255   60 20 120 140   220 140 80 240   20 20 20 255   100 200 250 90   255 128 0 255   0 128 255 200   128 64 32 170"
	}
	"case"
	{
		"name" "sky_base"
		"shader" "Sky"
		"clear" "30 60 120 255"
		"material"
		{
			"$basetexture" "conformance/legacy/sky_base"
			"$hdrbasetexture" "conformance/legacy/sky_base"
			"$color" "[0.8 0.9 0.7]"
		}
		"tonescale" "0.7"
		"points" "0.125 0.125 0.375 0.125 0.625 0.375 0.875 0.625 0.3 0.8 0.55 0.55"
	}
	"case"
	{
		"name" "sky_hdr_compressed_rgbs"
		"shader" "Sky"
		"clear" "30 60 120 255"
		"material"
		{
			"$basetexture" "conformance/legacy/sky_base"
			"$hdrcompressedtexture" "conformance/legacy/sky_rgbs"
			"$color" "[0.12 0.09 0.15]"
			"$basetexturetransform" "center .5 .5 scale 0.9 0.8 rotate 10 translate 0.05 0"
		}
		"tonescale" "0.8"
		"points" "0.125 0.125 0.375 0.125 0.625 0.375 0.875 0.625 0.3 0.8 0.55 0.55 0.71 0.23"
	}
	"case"
	{
		"name" "sky_hdr_compressed"
		"shader" "Sky"
		"clear" "30 60 120 255"
		"material"
		{
			"$basetexture" "conformance/legacy/sky_base"
			"$hdrcompressedtexture0" "conformance/legacy/sky_base"
			"$hdrcompressedtexture1" "conformance/legacy/sky_rgbs"
			"$hdrcompressedtexture2" "conformance/legacy/sky_base"
		}
		"tonescale" "0.6"
		"points" "0.125 0.125 0.625 0.375 0.3 0.8"
	}
}
