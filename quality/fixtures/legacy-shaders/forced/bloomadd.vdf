// screenspace_general_dx9's bloomadd_ps20 pixel shader (the ssg_bloomadd case
// split out of ../screenspace_general.vdf). The native textured family draws
// bloomadd_ps20b passes (g_CurrentBloomAdd); they take the legacy port only
// with -vklegacybloomadd, so run this file with
//   legacy_shader_conformance.py --cases <this file> --extra-arg=-vklegacybloomadd
// (the default run, of the parent directory only, would find them drawn natively).
"LegacyShaderCases"
{
	"texture"
	{
		"name" "conformance/legacy/screenspace_general_c"
		"width" "4"
		"height" "4"
		"texels" "204 201 53 246  205 31 97 34  106 225 83 56  174 26 52 0  77 51 186 13  36 106 192 76  129 177 186 242  62 59 249 238  245 247 159 43  73 52 175 135  245 82 11 105  185 75 13 152  46 133 187 85  182 114 168 114  99 122 205 116  102 252 182 14"
	}
	"case"
	{
		"name" "ssg_bloomadd"
		"shader" "screenspace_general"
		"clear" "60 40 20 255"
		"material"
		{
			"$pixshader" "bloomadd_ps20"
			"$basetexture" "conformance/legacy/screenspace_general_c"
			"$additive" "1"
			"$linearread_basetexture" "1"
			"$linearwrite" "1"
		}
		"points" "0.125 0.125 0.625 0.375 0.375 0.875 0.875 0.625 0.875 0.125 0.125 0.625"
	}
}
