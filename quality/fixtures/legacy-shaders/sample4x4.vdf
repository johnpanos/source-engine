// Sample4x4 and Sample4x4_Blend with each $pixshader the game's materials name
// (sample4x4, sample4x4log, sample4x4delog, sample4x4maxmin, sample4x4_blend;
// all with Downsample_vs20), taps one texel apart, sampled at texel centers.
// On this 8-bit target sample4x4log's red (a mean log luminance, <= 0) and the
// exponent of sample4x4delog and sample4x4_blend (>= 1) saturate; their other
// channels still vary.
"LegacyShaderCases"
{
	"texture"
	{
		"name" "conformance/legacy/sample4x4_source"
		"width" "4"
		"height" "4"
		"clamp" "1"
		"texels" "39 160 174 179  254 233 35 47  138 242 33 31  158 228 145 197  177 11 236 181  86 59 252 30  111 147 66 126  203 200 254 41  85 229 205 142  70 220 142 212  183 194 118 77  42 90 77 118  119 6 248 93  134 144 2 74  214 189 163 64  27 233 200 203"
	}
	"case"
	{
		"name" "sample4x4"
		"shader" "Sample4x4"
		"clear" "180 90 200 255"
		"material"
		{
			"$basetexture" "conformance/legacy/sample4x4_source"
			"$pixshader" "sample4x4_ps20"
		}
		"points" "0.125 0.125 0.625 0.375 0.375 0.875 0.875 0.625 0.875 0.125 0.125 0.625"
	}
	"case"
	{
		"name" "sample4x4_maxmin"
		"shader" "Sample4x4"
		"clear" "180 90 200 255"
		"material"
		{
			"$basetexture" "conformance/legacy/sample4x4_source"
			"$pixshader" "sample4x4maxmin_ps20"
		}
		"points" "0.125 0.125 0.625 0.375 0.375 0.875 0.875 0.625 0.875 0.125 0.125 0.625"
	}
	"case"
	{
		"name" "sample4x4_log"
		"shader" "Sample4x4"
		"clear" "180 90 200 255"
		"material"
		{
			"$basetexture" "conformance/legacy/sample4x4_source"
			"$pixshader" "sample4x4log_ps20"
			"$alpha" "0.6"
		}
		"points" "0.125 0.125 0.625 0.375 0.375 0.875 0.875 0.625 0.875 0.125 0.125 0.625"
	}
	"case"
	{
		"name" "sample4x4_delog"
		"shader" "Sample4x4"
		"clear" "180 90 200 255"
		"material"
		{
			"$basetexture" "conformance/legacy/sample4x4_source"
			"$pixshader" "sample4x4delog_ps20"
		}
		"points" "0.125 0.125 0.625 0.375 0.375 0.875 0.875 0.625 0.875 0.125 0.125 0.625"
	}
	"case"
	{
		"name" "sample4x4_blend"
		"shader" "Sample4x4_Blend"
		"clear" "180 90 200 255"
		"material"
		{
			"$basetexture" "conformance/legacy/sample4x4_source"
			"$pixshader" "sample4x4_blend_ps20"
		}
		"points" "0.125 0.125 0.625 0.375 0.375 0.875 0.875 0.625 0.875 0.125 0.125 0.625"
	}
