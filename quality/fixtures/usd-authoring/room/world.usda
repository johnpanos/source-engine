#usda 1.0
(
    """World structure of the U0 room: six closed convex world solids and the
    Materials they bind. Sublayer of room.usda."""
    metersPerUnit = 0.0254
    upAxis = "Z"
)

over "Map"
{
    def Scope "Looks"
    {
        def Material "Floor"
        {
            uniform string sourcemap:material = "metal/metal_modular_floor001"
            token outputs:surface.connect = </Map/Looks/Floor/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.35, 0.36, 0.38)
                float inputs:roughness = 0.6
                token outputs:surface
            }
        }

        def Material "Wall"
        {
            uniform string sourcemap:material = "metal/metalwall048b"
            token outputs:surface.connect = </Map/Looks/Wall/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.56, 0.58)
                float inputs:roughness = 0.5
                token outputs:surface
            }
        }

        def Material "Ceiling"
        {
            uniform string sourcemap:material = "concrete/concrete_modular_ceiling001a"
            token outputs:surface.connect = </Map/Looks/Ceiling/Preview.outputs:surface>

            def Shader "Preview"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.7, 0.7, 0.68)
                float inputs:roughness = 0.9
                token outputs:surface
            }
        }
    }

    def Scope "World"
    {
        def Mesh "Floor" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token sourcemap:role = "world_solid"
            uniform string sourcemap:id = "world.floor"
            uniform token sourcemap:contents = "solid"
            uniform int[] sourcemap:surfaceIds = [0, 1, 2, 3, 4, 5]
            rel material:binding = </Map/Looks/Floor>
            uniform token subdivisionScheme = "none"
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 1, 2, 6, 5, 3, 0, 4, 7]
            point3f[] points = [(-272, -208, -16), (272, -208, -16), (272, 208, -16), (-272, 208, -16), (-272, -208, 0), (272, -208, 0), (272, 208, 0), (-272, 208, 0)]
            texCoord2f[] primvars:st = [
                (-2.125, -1.625), (-2.125, 1.625), (2.125, 1.625), (2.125, -1.625),
                (-2.125, -1.625), (2.125, -1.625), (2.125, 1.625), (-2.125, 1.625),
                (-2.125, -0.125), (2.125, -0.125), (2.125, 0), (-2.125, 0),
                (2.125, -0.125), (-2.125, -0.125), (-2.125, 0), (2.125, 0),
                (-1.625, -0.125), (1.625, -0.125), (1.625, 0), (-1.625, 0),
                (1.625, -0.125), (-1.625, -0.125), (-1.625, 0), (1.625, 0)
            ] (
                interpolation = "faceVarying"
            )
        }

        def Mesh "Ceiling" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token sourcemap:role = "world_solid"
            uniform string sourcemap:id = "world.ceiling"
            uniform token sourcemap:contents = "solid"
            uniform int[] sourcemap:surfaceIds = [0, 1, 2, 3, 4, 5]
            rel material:binding = </Map/Looks/Ceiling>
            uniform token subdivisionScheme = "none"
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 1, 2, 6, 5, 3, 0, 4, 7]
            point3f[] points = [(-272, -208, 192), (272, -208, 192), (272, 208, 192), (-272, 208, 192), (-272, -208, 208), (272, -208, 208), (272, 208, 208), (-272, 208, 208)]
            texCoord2f[] primvars:st = [
                (-2.125, -1.625), (-2.125, 1.625), (2.125, 1.625), (2.125, -1.625),
                (-2.125, -1.625), (2.125, -1.625), (2.125, 1.625), (-2.125, 1.625),
                (-2.125, 1.5), (2.125, 1.5), (2.125, 1.625), (-2.125, 1.625),
                (2.125, 1.5), (-2.125, 1.5), (-2.125, 1.625), (2.125, 1.625),
                (-1.625, 1.5), (1.625, 1.5), (1.625, 1.625), (-1.625, 1.625),
                (1.625, 1.5), (-1.625, 1.5), (-1.625, 1.625), (1.625, 1.625)
            ] (
                interpolation = "faceVarying"
            )
        }

        def Mesh "WallNorth" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token sourcemap:role = "world_solid"
            uniform string sourcemap:id = "world.wall-north"
            uniform token sourcemap:contents = "solid"
            uniform int[] sourcemap:surfaceIds = [0, 1, 2, 3, 4, 5]
            rel material:binding = </Map/Looks/Wall>
            uniform token subdivisionScheme = "none"
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 1, 2, 6, 5, 3, 0, 4, 7]
            point3f[] points = [(-272, 192, 0), (272, 192, 0), (272, 208, 0), (-272, 208, 0), (-272, 192, 192), (272, 192, 192), (272, 208, 192), (-272, 208, 192)]
            texCoord2f[] primvars:st = [
                (-2.125, 1.5), (-2.125, 1.625), (2.125, 1.625), (2.125, 1.5),
                (-2.125, 1.5), (2.125, 1.5), (2.125, 1.625), (-2.125, 1.625),
                (-2.125, 0), (2.125, 0), (2.125, 1.5), (-2.125, 1.5),
                (2.125, 0), (-2.125, 0), (-2.125, 1.5), (2.125, 1.5),
                (1.5, 0), (1.625, 0), (1.625, 1.5), (1.5, 1.5),
                (1.625, 0), (1.5, 0), (1.5, 1.5), (1.625, 1.5)
            ] (
                interpolation = "faceVarying"
            )
        }

        def Mesh "WallSouth" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token sourcemap:role = "world_solid"
            uniform string sourcemap:id = "world.wall-south"
            uniform token sourcemap:contents = "solid"
            uniform int[] sourcemap:surfaceIds = [0, 1, 2, 3, 4, 5]
            rel material:binding = </Map/Looks/Wall>
            uniform token subdivisionScheme = "none"
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 1, 2, 6, 5, 3, 0, 4, 7]
            point3f[] points = [(-272, -208, 0), (272, -208, 0), (272, -192, 0), (-272, -192, 0), (-272, -208, 192), (272, -208, 192), (272, -192, 192), (-272, -192, 192)]
            texCoord2f[] primvars:st = [
                (-2.125, -1.625), (-2.125, -1.5), (2.125, -1.5), (2.125, -1.625),
                (-2.125, -1.625), (2.125, -1.625), (2.125, -1.5), (-2.125, -1.5),
                (-2.125, 0), (2.125, 0), (2.125, 1.5), (-2.125, 1.5),
                (2.125, 0), (-2.125, 0), (-2.125, 1.5), (2.125, 1.5),
                (-1.625, 0), (-1.5, 0), (-1.5, 1.5), (-1.625, 1.5),
                (-1.5, 0), (-1.625, 0), (-1.625, 1.5), (-1.5, 1.5)
            ] (
                interpolation = "faceVarying"
            )
        }

        def Mesh "WallEast" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token sourcemap:role = "world_solid"
            uniform string sourcemap:id = "world.wall-east"
            uniform token sourcemap:contents = "solid"
            uniform int[] sourcemap:surfaceIds = [0, 1, 2, 3, 4, 5]
            rel material:binding = </Map/Looks/Wall>
            uniform token subdivisionScheme = "none"
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 1, 2, 6, 5, 3, 0, 4, 7]
            point3f[] points = [(256, -192, 0), (272, -192, 0), (272, 192, 0), (256, 192, 0), (256, -192, 192), (272, -192, 192), (272, 192, 192), (256, 192, 192)]
            texCoord2f[] primvars:st = [
                (2, -1.5), (2, 1.5), (2.125, 1.5), (2.125, -1.5),
                (2, -1.5), (2.125, -1.5), (2.125, 1.5), (2, 1.5),
                (2, 0), (2.125, 0), (2.125, 1.5), (2, 1.5),
                (2.125, 0), (2, 0), (2, 1.5), (2.125, 1.5),
                (-1.5, 0), (1.5, 0), (1.5, 1.5), (-1.5, 1.5),
                (1.5, 0), (-1.5, 0), (-1.5, 1.5), (1.5, 1.5)
            ] (
                interpolation = "faceVarying"
            )
        }

        def Mesh "WallWest" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            uniform token sourcemap:role = "world_solid"
            uniform string sourcemap:id = "world.wall-west"
            uniform token sourcemap:contents = "solid"
            uniform int[] sourcemap:surfaceIds = [0, 1, 2, 3, 4, 5]
            rel material:binding = </Map/Looks/Wall>
            uniform token subdivisionScheme = "none"
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 1, 2, 6, 5, 3, 0, 4, 7]
            point3f[] points = [(-272, -192, 0), (-256, -192, 0), (-256, 192, 0), (-272, 192, 0), (-272, -192, 192), (-256, -192, 192), (-256, 192, 192), (-272, 192, 192)]
            texCoord2f[] primvars:st = [
                (-2.125, -1.5), (-2.125, 1.5), (-2, 1.5), (-2, -1.5),
                (-2.125, -1.5), (-2, -1.5), (-2, 1.5), (-2.125, 1.5),
                (-2.125, 0), (-2, 0), (-2, 1.5), (-2.125, 1.5),
                (-2, 0), (-2.125, 0), (-2.125, 1.5), (-2, 1.5),
                (-1.5, 0), (1.5, 0), (1.5, 1.5), (-1.5, 1.5),
                (1.5, 0), (-1.5, 0), (-1.5, 1.5), (1.5, 1.5)
            ] (
                interpolation = "faceVarying"
            )
        }
    }
}
