#usda 1.0
(
    """RFC 0009 U0 authoring fixture: a sealed 512 x 384 x 192 unit room.
    Profile source-authoring v1 (quality/usd_authoring/source_authoring_v1.md).
    Z up; one USD unit is one Source unit (0.0254 m). The world solids and the
    entities are separate sublayers of this root layer."""
    customLayerData = {
        dictionary sourcemap = {
            string profile = "source-authoring"
            int version = 1
        }
    }
    defaultPrim = "Map"
    metersPerUnit = 0.0254
    subLayers = [
        @./entities.usda@,
        @./world.usda@
    ]
    upAxis = "Z"
)

def Xform "Map"
{
}
