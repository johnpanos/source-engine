#usda 1.0
(
    defaultPrim = "GalleryIntegratingSphere"
    metersPerUnit = 1
    subLayers = [
        @../integrating-sphere.usda@
    ]
    upAxis = "Z"
)

over "GalleryIntegratingSphere"
{
    over "Lights"
    {
        over "Red"
        {
            float inputs:intensity = 0
        }

        over "Green"
        {
            float inputs:intensity = 0
        }
    }
}

