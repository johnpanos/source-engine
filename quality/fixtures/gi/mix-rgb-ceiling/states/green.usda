#usda 1.0
(
    defaultPrim = "GalleryMixRgbCeiling"
    metersPerUnit = 1
    subLayers = [
        @../mix-rgb-ceiling.usda@
    ]
    upAxis = "Z"
)

over "GalleryMixRgbCeiling"
{
    over "Lights"
    {
        over "Red"
        {
            float inputs:intensity = 0
        }

        over "Blue"
        {
            float inputs:intensity = 0
        }
    }
}

