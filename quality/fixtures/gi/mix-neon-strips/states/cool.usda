#usda 1.0
(
    defaultPrim = "GalleryMixNeonStrips"
    metersPerUnit = 1
    subLayers = [
        @../mix-neon-strips.usda@
    ]
    upAxis = "Z"
)

over "GalleryMixNeonStrips"
{
    over "Looks"
    {
        over "NeonRed"
        {
            over "Surface"
            {
                color3f inputs:emissiveColor = (0, 0, 0)
            }
        }

        over "NeonOrange"
        {
            over "Surface"
            {
                color3f inputs:emissiveColor = (0, 0, 0)
            }
        }

        over "NeonYellow"
        {
            over "Surface"
            {
                color3f inputs:emissiveColor = (0, 0, 0)
            }
        }
    }
}

