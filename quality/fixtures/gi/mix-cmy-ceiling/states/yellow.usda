#usda 1.0
(
    defaultPrim = "GalleryMixCmyCeiling"
    metersPerUnit = 1
    subLayers = [
        @../mix-cmy-ceiling.usda@
    ]
    upAxis = "Z"
)

over "GalleryMixCmyCeiling"
{
    over "Lights"
    {
        over "Cyan"
        {
            float inputs:intensity = 0
        }

        over "Magenta"
        {
            float inputs:intensity = 0
        }
    }
}

