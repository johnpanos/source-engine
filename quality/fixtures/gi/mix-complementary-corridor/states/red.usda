#usda 1.0
(
    defaultPrim = "GalleryMixComplementaryCorridor"
    metersPerUnit = 1
    subLayers = [
        @../mix-complementary-corridor.usda@
    ]
    upAxis = "Z"
)

over "GalleryMixComplementaryCorridor"
{
    over "Lights"
    {
        over "Cyan"
        {
            float inputs:intensity = 0
        }
    }
}

