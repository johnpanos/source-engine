#usda 1.0
(
    defaultPrim = "GalleryComplexStairwell"
    metersPerUnit = 1
    subLayers = [
        @../complex-stairwell.usda@
    ]
    upAxis = "Z"
)

over "GalleryComplexStairwell"
{
    over "Lights"
    {
        over "Cool"
        {
            float inputs:intensity = 0
        }
    }
}

