#usda 1.0
(
    defaultPrim = "GalleryMixRgbProbes"
    metersPerUnit = 1
    subLayers = [
        @../mix-rgb-probes.usda@
    ]
    upAxis = "Z"
)

over "GalleryMixRgbProbes"
{
    over "Lights"
    {
        over "Red"
        {
            float inputs:intensity = 0
        }

        over "Green"
        {
            float inputs:intensity = 0
        }
    }
}

