#usda 1.0
(
    defaultPrim = "GalleryMixLightSwap"
    metersPerUnit = 1
    subLayers = [
        @../mix-light-swap.usda@
    ]
    upAxis = "Z"
)

over "GalleryMixLightSwap"
{
    over "Lights"
    {
        over "Left"
        {
            color3f inputs:color = (0.1, 0.5, 1)
        }

        over "Right"
        {
            color3f inputs:color = (1, 0.5, 0.1)
        }
    }
}

