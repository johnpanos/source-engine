#usda 1.0
(
    defaultPrim = "GalleryProbeDirectionalRgb"
    metersPerUnit = 1
    subLayers = [
        @../probe-directional-rgb.usda@
    ]
    upAxis = "Z"
)

over "GalleryProbeDirectionalRgb"
{
    over "Lights"
    {
        over "Red"
        {
            float inputs:intensity = 0
        }

        over "Blue"
        {
            float inputs:intensity = 0
        }
    }
}

