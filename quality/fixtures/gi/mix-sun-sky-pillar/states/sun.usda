#usda 1.0
(
    defaultPrim = "GalleryMixSunSkyPillar"
    metersPerUnit = 1
    subLayers = [
        @../mix-sun-sky-pillar.usda@
    ]
    upAxis = "Z"
)

over "GalleryMixSunSkyPillar"
{
    over "Lights"
    {
        over "Sky"
        {
            float inputs:intensity = 0
        }
    }
}

