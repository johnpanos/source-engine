#usda 1.0
(
    defaultPrim = "GalleryOcclusionPinhole"
    metersPerUnit = 1
    subLayers = [
        @../occlusion-pinhole.usda@
    ]
    upAxis = "Z"
)

over "GalleryOcclusionPinhole"
{
    over "Lights"
    {
        over "Red"
        {
            float inputs:intensity = 0
        }
    }
}

