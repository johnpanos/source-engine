#usda 1.0
(
    defaultPrim = "GalleryOcclusionColoredShadows"
    metersPerUnit = 1
    subLayers = [
        @../occlusion-colored-shadows.usda@
    ]
    upAxis = "Z"
)

over "GalleryOcclusionColoredShadows"
{
    over "Lights"
    {
        over "Red"
        {
            float inputs:intensity = 0
        }

        over "Blue"
        {
            float inputs:intensity = 0
        }
    }
}

