#usda 1.0
(
    defaultPrim = "ProbeGrid"
    metersPerUnit = 1
    subLayers = [
        @../probe-grid.usda@
    ]
    upAxis = "Z"
)

over "ProbeGrid"
{
    over "Lights"
    {
        over "Sky"
        {
            float inputs:intensity = 0
        }

        over "Sun"
        {
            token visibility = "inherited"
        }
    }
}

