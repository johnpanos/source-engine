#usda 1.0
(
    defaultPrim = "Room"
    metersPerUnit = 0.01
    subLayers = [
        @../room-states.usda@
    ]
    upAxis = "Y"
)

over "Room"
{
    over "Looks"
    {
        over "Screen"
        {
            over "Surface"
            {
                color3f inputs:emissiveColor = (0, 0, 0)
                color3f inputs:emissiveColor.connect = None
            }
        }
    }
}

