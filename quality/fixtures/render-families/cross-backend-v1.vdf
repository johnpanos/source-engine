	"case" { "name" "pbr_model_transform" "limit" "2" "outliers" "0" }
	"case" { "name" "pbr_skinned" "limit" "2" "outliers" "0" }
	"case" { "name" "reflective-water" "limit" "2" "outliers" "0" }
	"case" { "name" "vertexlit_alpha_modulated" "limit" "2" "outliers" "0" }
	"case" { "name" "vertexlit_alphatest" "limit" "2" "outliers" "0" }
	"case" { "name" "vertexlit_ambient" "limit" "2" "outliers" "0" }
	"case" { "name" "vertexlit_directional_color" "limit" "2" "outliers" "0" }
