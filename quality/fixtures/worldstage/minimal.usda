#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 0.0254
    upAxis = "Z"
)

def Xform "World" (
    prepend apiSchemas = ["SourceWorldAPI"]
)
{
    uniform int source:schemaVersion = 4
    uniform int source:lightmapAtlasWidth = 64
    uniform int source:lightmapAtlasHeight = 64
    int[] source:chartFaceIds = [0]
    int4[] source:chartRects = [(0, 0, 64, 64)]

    def Scope "Geometry"
    {
        def Scope "WorldSpawn"
        {
            def Mesh "Mesh_0" (
                prepend apiSchemas = ["SourceMeshAPI"]
            )
            {
                int[] faceVertexCounts = [3]
                int[] faceVertexIndices = [0, 1, 2]
                point3f[] points = [(0, 0, 0), (64, 0, 0), (0, 64, 0)]
                normal3f[] normals = [(0, 0, 1)] (
                    interpolation = "uniform"
                )
                texCoord2f[] primvars:st = [(0, 0), (1, 0), (0, 1)] (
                    interpolation = "faceVarying"
                )
                texCoord2f[] primvars:lightmap:st = [(0, 0), (1, 0), (0, 1)] (
                    interpolation = "faceVarying"
                )
                int[] primvars:source:faceId = [0] (
                    interpolation = "uniform"
                )
                uint[] primvars:source:smoothingGroup = [0] (
                    interpolation = "uniform"
                )
                int[] primvars:source:lightmapChartId = [0] (
                    interpolation = "uniform"
                )
            }
        }
    }

    def Scope "Entities"
    {
        def "Entity_0" (
            prepend apiSchemas = ["SourceEntityAPI"]
        )
        {
            uniform int source:entityIndex = 0
            string[] source:keyNames = ["classname"]
            string[] source:keyValues = ["worldspawn"]
        }
        def "Entity_1" (
            prepend apiSchemas = ["SourceEntityAPI"]
        )
        {
            uniform int source:entityIndex = 1
            string[] source:keyNames = ["classname", "origin", "_light"]
            string[] source:keyValues = ["light", "0 0 32", "255 255 255 100"]
        }
    }

    def Scope "Lights"
    {
        def SphereLight "Light_1" (
            prepend apiSchemas = ["SourceLightAPI"]
        )
        {
            float inputs:intensity = 100
            color3f inputs:color = (1, 1, 1)
            float inputs:radius = 8
            double3 xformOp:translate = (0, 0, 32)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            uniform int source:entityIndex = 1
            uniform int source:styleId = 0
            uniform token source:lightingPolicy = "preview-v1"
        }
    }
}
