#usda 1.0
(
    defaultPrim = "Room"
    doc = """corpus-usd-rooms v1 seeded negative control (hand-written, 2026-09-25).
st_transforms.usda with one seeded defect: the Full material's UsdTransform2d
rotation is -30 degrees instead of 30. Tests run against it must fail
StTransformTest (the Full quad's UVs), and nothing else."""
    metersPerUnit = 1
    subLayers = [
        @../st_transforms.usda@
    ]
    upAxis = "Z"
)

over "Room"
{
    over "Looks"
    {
        over "Full"
        {
            float inputs:tileRotation = -30
        }
    }
}
