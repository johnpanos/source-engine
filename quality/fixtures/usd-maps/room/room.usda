#usda 1.0
(
    defaultPrim = "Room"
    metersPerUnit = 0.01
    upAxis = "Y"
)

def Xform "Room"
{
    def Scope "Looks"
    {
        def Material "WoodFloor"
        {
            token inputs:frame:stPrimvarName = "st"
            token outputs:surface.connect = </Room/Looks/WoodFloor/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Room/Looks/WoodFloor/BaseColor.outputs:rgb>
                float inputs:metallic.connect = </Room/Looks/WoodFloor/ORM.outputs:b>
                normal3f inputs:normal.connect = </Room/Looks/WoodFloor/Normal.outputs:rgb>
                float inputs:occlusion.connect = </Room/Looks/WoodFloor/ORM.outputs:r>
                float inputs:roughness.connect = </Room/Looks/WoodFloor/ORM.outputs:g>
                token outputs:surface
            }

            def Shader "StReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname.connect = </Room/Looks/WoodFloor.inputs:frame:stPrimvarName>
                float2 outputs:result
            }

            def Shader "Tiling"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </Room/Looks/WoodFloor/StReader.outputs:result>
                float2 inputs:scale = (0.5, 0.5)
                float2 outputs:result
            }

            def Shader "BaseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/wood_basecolor.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Room/Looks/WoodFloor/Tiling.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                color3f outputs:rgb
            }

            def Shader "ORM"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/wood_orm.png@
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Room/Looks/WoodFloor/Tiling.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:b
                float outputs:g
                float outputs:r
            }

            def Shader "Normal"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @./textures/wood_normal.png@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Room/Looks/WoodFloor/Tiling.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                normal3f outputs:rgb
            }
        }

        def Material "Plaster"
        {
            token inputs:frame:stPrimvarName = "st"
            token outputs:surface.connect = </Room/Looks/Plaster/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.58, 0.52)
                normal3f inputs:normal.connect = </Room/Looks/Plaster/Normal.outputs:rgb>
                float inputs:roughness = 0.85
                token outputs:surface
            }

            def Shader "StReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname.connect = </Room/Looks/Plaster.inputs:frame:stPrimvarName>
                float2 outputs:result
            }

            def Shader "Normal"
            {
                uniform token info:id = "UsdUVTexture"
                float4 inputs:bias = (-1, -1, -1, 0)
                asset inputs:file = @./textures/plaster_normal.png@
                float4 inputs:scale = (2, 2, 2, 1)
                token inputs:sourceColorSpace = "raw"
                float2 inputs:st.connect = </Room/Looks/Plaster/StReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                normal3f outputs:rgb
            }
        }

        def Material "Ceiling"
        {
            token inputs:frame:stPrimvarName = "st"
            token outputs:surface.connect = </Room/Looks/Ceiling/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.78)
                float inputs:roughness = 0.9
                token outputs:surface
            }

            def Shader "StReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname.connect = </Room/Looks/Ceiling.inputs:frame:stPrimvarName>
            }
        }

        def Material "BrushedMetal"
