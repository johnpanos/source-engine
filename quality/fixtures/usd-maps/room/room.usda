                float inputs:metallic = 1
                float inputs:roughness = 0.45
                token outputs:surface
            }

            def Shader "StReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname.connect = </Room/Looks/PaintedSteel.inputs:frame:stPrimvarName>
            }
        }

        def Material "Screen"
        {
            token inputs:frame:stPrimvarName = "st"
            token outputs:surface.connect = </Room/Looks/Screen/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.02, 0.02)
                color3f inputs:emissiveColor.connect = </Room/Looks/Screen/Emissive.outputs:rgb>
                float inputs:roughness = 0.15
                token outputs:surface
            }

            def Shader "StReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname.connect = </Room/Looks/Screen.inputs:frame:stPrimvarName>
                float2 outputs:result
            }

            def Shader "Emissive"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/screen_emissive.png@
                float4 inputs:scale = (3, 3, 3, 1)
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Room/Looks/Screen/StReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                color3f outputs:rgb
            }
        }

        def Material "Poster"
        {
            token inputs:frame:stPrimvarName = "st"
            token outputs:surface.connect = </Room/Looks/Poster/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
