                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Room/Looks/Poster/StReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                color3f outputs:rgb
            }
        }

        def Material "Leaves"
        {
            token inputs:frame:stPrimvarName = "st"
            token outputs:surface.connect = </Room/Looks/Leaves/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </Room/Looks/Leaves/BaseColor.outputs:rgb>
                float inputs:opacity.connect = </Room/Looks/Leaves/BaseColor.outputs:a>
                float inputs:opacityThreshold = 0.5
                float inputs:roughness = 0.6
                token outputs:surface
            }

            def Shader "StReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname.connect = </Room/Looks/Leaves.inputs:frame:stPrimvarName>
                float2 outputs:result
            }

            def Shader "BaseColor"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/leaf_basecolor.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Room/Looks/Leaves/StReader.outputs:result>
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float outputs:a
                color3f outputs:rgb
            }
        }

        def Material "CratePaint"
        {
            token inputs:frame:stPrimvarName = "st"
            token outputs:surface.connect = </Room/Looks/CratePaint/Surface.outputs:surface>

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.12, 0.08)
                float inputs:roughness = 0.5
                token outputs:surface
            }

            def Shader "StReader"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname.connect = </Room/Looks/CratePaint.inputs:frame:stPrimvarName>
            }
        }
    }

