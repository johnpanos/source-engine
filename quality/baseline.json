    {"id": "quality.selftest", "group": "static", "domain": "Q-FOUNDATION", "rows": ["R02"], "argv": ["python3", "tools/quality/selftest.py", "--jobs", "{jobs}"], "budget_seconds": 20, "baseline": {"outcome": "pass"}},
