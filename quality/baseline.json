{
  "schema": "source-baseline/v1",
  "description": "R01 / RFC 0005 Q0 reproducible baseline and profile inventory. Declares the host tools, content corpora, support matrix, installed checks with their recorded outcome at this revision, and the identified baseline captures and budgets per harness domain. Run tools/quality/baseline.py audit; see RFC/0005-progress.md#q0--r01-baseline-and-profile-inventory. Profile facts stay in the linked profile files; module dependency permissions stay in architecture/modules.json; roadmap state stays in AGENTS.md.",
  "tools": [
    {"id": "gcc", "kind": "command", "argv": ["g++", "--version"]},
    {"id": "clang", "kind": "command", "argv": ["clang++", "--version"]},
    {"id": "gcc-m32", "kind": "compile", "cxx": "g++", "flags": ["-m32"], "source": "int main() { return sizeof(void *) == 4 ? 0 : 1; }\n", "note": "linux-i386 legacy CI profile needs a 32-bit multilib runtime"},
    {"id": "gcc-asan-ubsan", "kind": "compile", "cxx": "g++", "flags": ["-fsanitize=address,undefined"], "source": "int main() { int a[2] = {0, 1}; return a[1] - 1; }\n"},
    {"id": "clang-asan-ubsan", "kind": "compile", "cxx": "clang++", "flags": ["-fsanitize=address,undefined"], "source": "int main() { int a[2] = {0, 1}; return a[1] - 1; }\n"},
    {"id": "gcc-tsan", "kind": "compile", "cxx": "g++", "flags": ["-fsanitize=thread"], "source": "int main() { return 0; }\n"},
    {"id": "clang-tsan", "kind": "compile", "cxx": "clang++", "flags": ["-fsanitize=thread"], "source": "int main() { return 0; }\n"},
    {"id": "mingw-gcc", "kind": "command", "argv": ["x86_64-w64-mingw32-g++", "--version"]},
    {"id": "wine", "kind": "command", "argv": ["wine", "--version"]},
    {"id": "ge-proton", "kind": "path", "candidates": ["~/.local/share/Steam/compatibilitytools.d/GE-Proton11-5-x86_64"], "note": "second Windows PE runtime named by quality/profiles/windows-pe-wine.json"},
    {"id": "msvc-wine", "kind": "path", "env": "MSVC_WINE_ROOT", "candidates": [], "note": "msvc-wine cl 19.29 with ATL/MFC for the legacy Hammer parity lane (architecture/hammer_legacy_parity.json); provisioned per session, not installed"},
    {"id": "msvc-native", "kind": "command", "argv": ["cl.exe"], "note": "Windows client/dedicated CI profiles build with Visual Studio on windows-2019/2022 runners"},
    {"id": "clang-format", "kind": "command", "argv": ["clang-format", "--version"], "expect": "22\\.1\\.8", "note": "pinned by tools/stylelint/requirements.txt"},
    {"id": "ccache", "kind": "command", "argv": ["ccache", "--version"]},
    {"id": "glslc", "kind": "command", "argv": ["glslc", "--version"]},
    {"id": "spirv-val", "kind": "command", "argv": ["spirv-val", "--version"]},
    {"id": "sdl3", "kind": "pkg-config", "module": "sdl3"},
    {"id": "sdl2", "kind": "pkg-config", "module": "sdl2"},
    {"id": "vulkan-sdk", "kind": "pkg-config", "module": "vulkan"},
    {"id": "gtk4", "kind": "pkg-config", "module": "gtk4"},
    {"id": "libadwaita", "kind": "pkg-config", "module": "libadwaita-1"},
    {"id": "epoxy", "kind": "pkg-config", "module": "epoxy"},
    {"id": "vulkan-hardware-gpu", "kind": "command", "argv": ["vulkaninfo", "--summary"], "expect": "PHYSICAL_DEVICE_TYPE_(INTEGRATED|DISCRETE)_GPU", "note": "a real (non-software) Vulkan device; llvmpipe alone does not satisfy GPU gates"},
    {"id": "wayland-session", "kind": "env", "variable": "WAYLAND_DISPLAY", "note": "a live session is NOT permission to open test windows; native window tests run in an isolated compositor"},
    {"id": "isolated-compositor", "kind": "command", "argv": ["mutter", "--version"], "note": "mutter --headless provides a private Wayland socket for native window tests"},
    {"id": "dxvk-native", "kind": "path", "candidates": ["dependencies/dxvk-native-2.7.1/usr"], "note": "pinned by quality/product_profiles/portal-linux-wayland.json; restore with tools/quality/product_profile.py fetch"},
    {"id": "android-ndk", "kind": "path", "candidates": ["dependencies/android/android-ndk-r30/source.properties"], "note": "pinned by quality/product_profiles/portal-android-native-vulkan.json; build-android-apk.sh fetches and verifies it"},
    {"id": "android-sdk-platform", "kind": "path", "candidates": ["dependencies/android/sdk-platform-android-36-r02"]},
    {"id": "java", "kind": "command", "argv": ["java", "--version"]},
    {"id": "adb", "kind": "command", "argv": ["adb", "version"]},
    {"id": "android-device", "kind": "command", "argv": ["adb", "devices"], "expect": "\\tdevice$", "note": "an attached, authorized device; probing does not install or run anything on it"},
    {"id": "android-emulator", "kind": "path", "env": "ANDROID_HOME", "candidates": ["~/Android/Sdk/emulator/emulator"], "note": "emulator is an additional profile, not a replacement for device evidence"},
    {"id": "xcode", "kind": "command", "argv": ["xcodebuild", "-version"], "note": "macOS and iOS builds need a native Apple runner"},
    {"id": "moltenvk", "kind": "path", "env": "MOLTENVK_ROOT", "candidates": [], "note": "Vulkan portability over Metal for macOS/iOS"},
    {"id": "blender-cycles", "kind": "command", "argv": ["blender", "--version"], "note": "Cycles reference renderer for RFC 0007 (R49/R51); feasibility only"},
    {"id": "openusd", "kind": "command", "argv": ["usdchecker", "--help"], "note": "RFC 0008 World Stage (R54)"},
    {"id": "ktx-tools", "kind": "command", "argv": ["ktx", "--version"], "note": "RFC 0008 KTX2 textures (R55)"}
  ],
  "content": [
    {"id": "portal-runtime", "env": "SOURCE_PORTAL_RUNTIME", "candidates": ["~/.local/share/Steam/steamapps/common/Portal"], "marker": "portal/gameinfo.txt", "redistribution": "licensed game content; staged privately by tools/quality/portal_boot.py and never copied into the repository", "consumers": ["R09", "R19", "R21", "R27", "R28", "R32", "R53"]},
    {"id": "portal-staged-runtime", "candidates": ["run/runtime"], "marker": "portal/gameinfo.txt", "redistribution": "private staging of portal-runtime (git-ignored); recreated by ./run.sh or tools/quality/stage_runtime.py", "consumers": ["R09", "R19"]},
    {"id": "hl2-runtime", "env": "SOURCE_HL2_RUNTIME", "candidates": ["~/.local/share/Steam/steamapps/common/Half-Life 2"], "marker": "hl2/gameinfo.txt", "redistribution": "licensed game content", "consumers": ["R31", "R34"]},
    {"id": "portal2-runtime", "env": "SOURCE_PORTAL2_RUNTIME", "candidates": ["run/runtime-p2", "~/.local/share/Steam/steamapps/common/Portal 2"], "marker": "portal2/gameinfo.txt", "redistribution": "licensed game content; staged privately, used for RFC 0008 v21 container carriage and Hammer authoring reference", "consumers": ["R08", "R22", "R53"]},
    {"id": "chamber-sdk", "env": "SOURCE_CHAMBER_SDK", "candidates": ["~/src/chamber-sdk"], "marker": "fixtures", "redistribution": "external authoring corpus (VMF/BSP); referenced by path, never copied", "consumers": ["R08", "R22", "R53"]},
    {"id": "material-pixel-fixtures", "candidates": ["quality/fixtures/material-pixels"], "marker": "README.md", "redistribution": "in-repository D3D9 reference captures (measured values only)", "consumers": ["R32", "R47"]}
  ],
