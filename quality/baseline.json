    {"id": "roadmap.selftest", "group": "static", "domain": "Q-ARCH", "rows": ["R01"], "argv": ["python3", "-m", "unittest", "discover", "-s", "tools/roadmap/tests"], "budget_seconds": 2, "baseline": {"outcome": "pass"}},
