    {"id": "build.tests", "group": "build", "domain": "Q-FOUNDATION", "rows": ["R03"], "argv": ["python3", "./waf", "build", "install", "-j{jobs}"], "budget_seconds": 30, "env": {"WAFLOCK": ".lock-waf-r03-tests"}, "requires": ["path:.lock-waf-r03-tests"], "setup": "WAFLOCK=.lock-waf-r03-tests ./waf configure --tests --use-sdl=0 --use-togl=0 --disable-warns -T release -o build-r03-tests --prefix=$PWD/build-r03-tests/install", "timeout": 3600, "baseline": {"outcome": "pass"}, "timeout_reason": "a from-scratch rebuild after a large change or a cleaned tree compiles the whole tree"},
