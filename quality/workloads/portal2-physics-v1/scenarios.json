{
  "schema": "portal2-scenarios/v1",
  "description": "Portal 2 physics against retail (tools/quality/portal2_physics.py): momentum through portals, cubes through portals, carried cubes, faith plates, funnels, light bridges and floor buttons on retail maps. Each scenario prints QA_METRIC measurements that the checker compares with a recorded retail run (retail-reference.json) under the tolerances below.",
  "driver": "../portal2-wheatley-v1/qa_driver.nut",
  "includes": [
    "qa_physics.nut",
    "../portal2-catapult-v1/qa_catapult.nut"
  ],
