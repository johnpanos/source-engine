{
  "schema": "frame-pacing-scenario/v1",
  "id": "portal-frame-pacing-v1",
  "description": "Portal testchmb_a_02 from the spawn point: open a blue portal on the concrete wall ahead and an orange one on the wall behind, then walk into the blue portal, out of the orange one, and back. Every pass first fizzles both portals, so each pass opens new portals. Reported on the native Vulkan renderer through -vkframestats; budgets gate the last (warm) pass.",
  "map": "testchmb_a_02",
  "passes": 3,
  "host_framerate": 60,
  "setup": [
    "god",
    "notarget",
    "give weapon_portalgun",
    "upgrade_portalgun",
    "upgrade_portalgun",
    "wait 120"
  ],
  "body": [
    "ent_fire prop_portal fizzle",
    "setpos -912 192 64",
    "setang 0 0 0",
    "wait 90",
    "vk_frame_mark idle",
    "wait 120",
    "vk_frame_mark fire_blue",
    "+attack",
    "wait 2",
    "-attack",
    "wait 120",
    "setang 0 180 0",
    "wait 30",
    "vk_frame_mark fire_orange",
    "+attack2",
    "wait 2",
    "-attack2",
    "wait 120",
    "setang 0 0 0",
    "wait 30",
    "vk_frame_mark approach_blue",
    "+forward",
    "wait 240",
    "-forward",
    "wait 60",
    "vk_frame_mark turn_back",
    "setang 0 180 0",
    "wait 60",
    "vk_frame_mark approach_back",
    "+forward",
    "wait 240",
    "-forward",
    "vk_frame_mark settle",
    "wait 60"
  ],
  "budgets": {
    "max_hitches": 0
  }
}
