        "view.chamber",
        "event.wall_falls",
        "view.wall_falls",
        "stand.reached",
        "event.laser_on",
        "view.laser_on",
        "view.aim_portal_floor",
        "portal_floor.placed",
        "view.lift",
        "lift.reached",
        "view.aim_portal_ceiling",
        "portal_ceiling.placed",
        "catcher.powered",
        "view.portal_ceiling",
        "event.catcher_powered",
        "view.catcher_powered",
        "event.lift_raised",
        "exit_door.opens",
        "catcher.still_powered",
        "view.exit_door",
        "departure.reached",
        "event.departure_elevator",
        "view.departure_elevator",
        "elevator_door.reached",
