{
  "schema": "source-host-tool-profile/v1",
  "id": "pbrt-map-remote-gpu-host-linux-x86_64-v1",
  "description": "What a rented Linux GPU host (tools/quality/vast_blender.py) installs to run the map pipeline's remote steps (remote_blender.py): the profile's Blender for the Cycles steps and reference renders, and a Python with the OIDN library for the post-bake steps (noise, denoise, directional, rprb), so their large EXR outputs stay on the host. Everything is pinned by digest; the Python packages match the local host's versions (pbrt-map-linux-tools) and run on the Blender's bundled CPython 3.13. The OIDN build is upstream's, not Fedora's oidn-libs 2.4.0: same release, different binary, so denoised results can differ slightly from local ones (step cache keys record which).",
  "target": {"product": "map-lighting-remote-host", "os": "linux", "architecture": "x86_64"},
  "blender": {
    "version": "5.2.2",
    "urls": [
      "https://download.blender.org/release/Blender5.2/blender-5.2.2-linux-x64.tar.xz",
      "https://mirrors.ocf.berkeley.edu/blender/release/Blender5.2/blender-5.2.2-linux-x64.tar.xz",
      "https://mirror.clarkson.edu/blender/release/Blender5.2/blender-5.2.2-linux-x64.tar.xz",
      "https://ftp.nluug.nl/pub/graphics/blender/release/Blender5.2/blender-5.2.2-linux-x64.tar.xz"
    ],
    "sha256": "84098912789dc450e95697c4184fb8a90acbe5111c2ba4aede3fecb57806a168",
    "directory": "/opt/blender-5.2.2-linux-x64",
    "executable": "blender",
    "python": "5.2/python/bin/python3.13"
  },
  "oidn": {
    "version": "2.4.0",
