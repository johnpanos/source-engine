{
  "schema": "gi-sdf-perf/v1",
  "rfc": "0011",
  "rows": [
    "R76"
  ],
  "recorded": "2026-09-25",
  "policy": "Performance fixtures of the SDF-traced indirect light path (RFC 0011 G6/G7), for burning down its performance debt. Budgets are set before optimization (AGENTS.md): each row has a budget (its own, or `budget_ref` into quality/budgets/indirect-light-v1.json, which owns the producers' GPU budgets) and a reviewed baseline (the median of interleaved rounds on the profile's runner). A row fails when it measures over max(budget, baseline) x tolerance.ratio + tolerance.absolute_ms; a row whose baseline is over budget is performance debt, listed by size with its owner; a row measuring under baseline x tolerance.improved_ratio is improved and its baseline is lowered with --update-baselines (never raised without review). CPU budgets proposed 2026-09-25 with these fixtures: one publishing frame's main-thread work 1.0 ms (the radiosity producer's cpu_ms_per_update), a still scene 0.01 ms (the producer's promise that a still scene costs nothing), an occlusion recompose per door change 4 ms pooled and 10 ms serial (the desktop frame's slack: 16.67 ms target less the 6.1 ms warm median), load-time stages 20 ms and the occlusion build 100 ms. Synthetic scenes are sized like the real maps and generated deterministically; map scenes are optional pipeline outputs, and a missing one leaves its rows unverified. A profile without its own runner's measurements is unverified. Android, macOS and iOS have no rows: RFC 0011 declares sdf unsupported there until measured, and these fixtures have no runner for them.",
  "budgets": "quality/budgets/indirect-light-v1.json",
  "suites": {
    "cpu": "render.indirect-sdf.bench-smoke",
    "gpu": "render.indirect-light.sdf"
  },
  "default_profile": "linux-x86_64-desktop",
  "tolerance": {
    "ratio": 1.5,
    "absolute_ms": 0.05,
    "improved_ratio": 0.67
  },
  "host": {
    "max_load_per_cpu": 1.0,
    "why": "timings from a host whose one-minute load average exceeds its CPU count are contention, not the code: their rows are unverified (never passed or failed), and neither calibration nor --update-baselines records them. The calibration ran at 0.96 per CPU; a verification at 2.7 per CPU (two Blender bakes) measured every stage 2-4x slower."
  },
  "metrics": {
    "load_ms": "PRBV and SDFV validation of bytes in memory (the map load's share)",
    "begin_ms": "SdfTracedProducer::Begin: light cells, voxel style scan, buffer creation and uploads",
    "schedule_reference.median_ms": "Schedule per frame while probes build their reference (dispatch bookkeeping, reference capture)",
    "schedule_idle.median_ms": "Schedule per frame in a still scene after every reference",
    "schedule_publish.median_ms": "Schedule on a frame that publishes: the field's change from its reference applied to the bake and the volume composed (ChangeComposer)",
    "consume_change_atlas.median_ms": "the host's BakedPlusDelta change atlas per published volume (indirect_light.h ChangeAtlas)",
    "consume_visibility.median_ms": "the host's copy of a published volume with the proxies' probe visibility (OccludeProbeVisibility)",
    "frame_publish.median_ms": "one publishing frame's main-thread total: Schedule plus the host's work per published volume",
    "frame_publish.p95_ms": "the same, 95th percentile",
    "build_ms": "DirectOcclusion build per map (rasterize the lightmap texels, orient, light samples)",
    "compose_serial.median_ms": "DirectOcclusion compose per proxy change, serial (the low-core path)",
    "compose_pooled.median_ms": "DirectOcclusion compose per proxy change on the declared workers",
    "live_ms_median": "GPU: trace dispatch timestamps per update after the change (median)",
    "live_ms_p95": "GPU: the same, 95th percentile",
    "reference_ms_median": "GPU: trace dispatch timestamps per update in the reference phase",
    "schedule_cpu_ms_median": "GPU bench: Schedule's CPU time on the device after the change (field readback from host-cached memory)"
  },
