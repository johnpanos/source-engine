{
  "schema": "toolchain-policy/v1",
  "description": "Authoritative per-target language-dialect policy (RFC 0006 M0 / roadmap R03). By user decision (2026-09-22) every in-tree C++ target compiles as C++20: unmigrated code uses cxx20-permissive, new and migrated code the strict cxx20 dialect. legacy-cxx11 exists only for fixtures that stand in for frozen external consumers (prebuilt mods/plugins) of the declared C++11 facades; no in-tree target may select it. The Waf tool scripts/waifulib/toolchain_dialect.py applies or verifies the policy for every C/C++ task generator and records final invocations; tools/quality/toolchain_boundary.py verifies them. Target wscripts do not pass -std flags. Include and link permissions are owned by architecture/modules.json, not here.",
  "compiler_families": {
    "gcc": "gnu",
    "g++": "gnu",
    "clang": "gnu",
    "clang++": "gnu",
    "msvc": "msvc"
  },
  "std_flag_prefixes": {
    "gnu": [
      "-std="
    ],
    "msvc": [
      "/std:",
      "-std:"
    ]
  },
  "defaults": {
    "c++": "cxx20-permissive",
    "c": "c-toolchain-default"
  },
  "dialects": {
    "cxx20-permissive": {
      "language": "c++",
      "mode": "verify",
      "description": "Default for unmigrated in-tree C++: C++20 supplied by the root wscript with the engine's historical -fpermissive relaxation. Verified, never rewritten, so each target keeps its exact flags.",
      "gnu": {
        "std": "c++20",
        "required": [
          "-fpermissive"
        ],
        "forbidden": []
      },
      "msvc": {
        "std": "/std:c++20",
        "required": [
          "/Zc:__cplusplus"
        ],
        "forbidden": []
      },
      "probe": "quality/toolchain/probes/cxx20.cpp"
    },
    "cxx20": {
      "language": "c++",
      "mode": "apply",
      "description": "New and deliberately migrated first-party targets: exactly one C++20 flag and no permissive compilation, whatever the inherited flags were.",
      "gnu": {
        "std": "c++20",
        "required": [],
        "forbidden": [
          "-fpermissive"
        ]
      },
      "msvc": {
        "std": "/std:c++20",
        "required": [
          "/permissive-",
          "/Zc:__cplusplus"
        ],
        "forbidden": []
      },
      "probe": "quality/toolchain/probes/cxx20.cpp"
    },
    "cxx20-vendored-ivp": {
      "language": "c++",
      "mode": "apply",
      "description": "The vendored IVP physics submodule (ivp/, pinned; not edited here) compiled as C++20 with the engine's permissive relaxation. Its sources still use the `register` storage class, which C++17 removed; -Wno-register accepts it on clang (gcc already only warns). Retire when IVP simulation retires (R44/R45) or the submodule is updated.",
      "gnu": {
        "std": "c++20",
        "required": [
          "-fpermissive",
          "-Wno-register"
        ],
        "forbidden": []
      },
      "msvc": {
        "std": "/std:c++20",
        "required": [
          "/Zc:__cplusplus"
        ],
        "forbidden": []
      },
      "probe": "quality/toolchain/probes/cxx20.cpp"
    },
    "legacy-cxx11": {
      "language": "c++",
      "mode": "verify",
      "description": "Frozen external consumer dialect: exact C++11 code built outside this tree (mods, plugins, SDK users) that includes the declared legacy facades. GNU-family fixture units only; MSVC cannot select exact C++11. No in-tree target may select it.",
      "gnu": {
        "std": "c++11",
        "required": [
          "-fpermissive"
        ],
        "forbidden": []
      },
      "probe": "quality/toolchain/probes/legacy_cxx11.cpp",
      "fixture_only": true
    },
    "c-toolchain-default": {
      "language": "c",
      "mode": "unconstrained",
      "description": "Legacy C targets keep whatever the toolchain and their own configuration select; recorded in evidence, not constrained.",
      "gnu": {
        "std": null,
        "required": [],
        "forbidden": []
      },
      "msvc": {
        "std": null,
        "required": [],
        "forbidden": []
      }
    },
    "box3d-c17": {
      "language": "c",
      "mode": "apply",
      "description": "Private pinned Box3D C17 library (RFC 0004/0006): gnu17 with upstream's floating-point, visibility and PIC settings and none of the engine's fast-math flags. No MSVC mapping is declared, so an MSVC Box3D build fails composition instead of guessing.",
      "gnu": {
        "std": "gnu17",
        "required": [
          "-ffp-contract=off",
          "-fno-fast-math",
          "-fvisibility=hidden",
          "-fPIC"
        ],
        "forbidden": [
          "-ffast-math",
          "-funsafe-math-optimizations"
        ]
      },
      "probe": "quality/toolchain/probes/box3d_c17.c"
    }
  },
