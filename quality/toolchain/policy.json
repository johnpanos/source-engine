  "cxx20_header_sets": [
    {
      "id": "jobsystem",
      "paths": [
        "public/jobsystem/"
      ],
      "legacy_facades": [
        "public/jobsystem/parallel_batch.h",
        "public/jobsystem/worker_backend.h"
      ]
    },
    {
      "id": "mapcontainer",
      "paths": [
        "public/mapcontainer/",
        "mapcontainer/"
      ],
      "legacy_facades": [
        "public/mapcontainer/map_container.h",
        "public/mapcontainer/map_container_format.h",
        "public/mapcontainer/world_mesh.h",
        "public/mapcontainer/world_mesh_format.h"
      ]
    },
    {
      "id": "platform",
      "paths": [
        "public/platform/",
        "platform/composition.cpp",
        "platform/tool_process_client.cpp",
        "platform/posix/"
      ],
      "legacy_facades": []
    }
