  "abi": {
    "libstdcxx_dual_abi_define": "_GLIBCXX_USE_CXX11_ABI",
    "libstdcxx_dual_abi_default": "1",
    "rule": "C++ standard-library types crossing a target boundary require the same libstdc++ dual-ABI value. Engine products define _GLIBCXX_USE_CXX11_ABI=0 globally; strict-hygiene targets use the toolchain default and may meet legacy targets only through ABI-neutral interfaces.",
    "supported_combinations": [
      {
        "id": "same-toolchain-mixed-dialect",
        "description": "A legacy-cxx11 consumer and a cxx20 provider built by the same compiler and libstdc++ in one configuration, sharing the product's dual-ABI value, communicating only through declared legacy facades (vtables, C++11 standard-layout values, std::function).",
        "compilers": [
          "g++",
          "clang++"
        ],
        "suites": [
          "toolchain.abi.jobsystem-batch",
          "toolchain.abi.mapcontainer"
        ]
      },
      {
        "id": "strict-isolated-default-abi",
        "description": "Strict-hygiene cxx20 targets built with the toolchain-default dual-ABI value, linked only with other targets of the same value.",
        "compilers": [
          "g++",
          "clang++"
        ],
        "verified_by": "toolchain_boundary.py verify (link-closure ABI check)"
      },
      {
        "id": "declared-abi-island",
        "description": "A linked product may contain a declared island of targets built with the other dual-ABI value, only as listed in abi.islands, and only while its edge carries ABI-neutral symbols and shares no first-party inline definitions.",
        "compilers": [
          "g++",
          "clang++"
        ],
        "verified_by": "toolchain_boundary.py TOOLCHAIN011 (object-level symbol check)"
      }
    ],
    "unsupported_combinations": [
      "Different compilers or standard libraries within one product binary or loaded module set",
      "Different _GLIBCXX_USE_CXX11_ABI values on either side of any linked boundary",
      "Standard-library containers, smart pointers, Expected or exceptions across a legacy facade (RFC 0006)"
    ],
    "islands": [
      {
        "id": "vbsp2-openusd",
        "host": "vbsp2",
        "members": [
          "vbspworldstage",
          "sourceWorld"
        ],
        "value": "1",
        "owner": "R54",
        "reason": "OpenUSD requires the current libstdc++ string ABI; vbsp2's legacy translation units use ABI 0. The World Stage writer (utils/vbsp/worldstage.cpp) and the generated schema library are the ABI 1 island, called through the C-compatible WriteWorldStageGeometry.",
        "verified_by": "toolchain_boundary.py TOOLCHAIN011: no symbol with a dual-ABI type crosses the island edge, and no first-party inline symbol is defined on both sides (object-level nm check)"
      }
    ]
  }
}
