{
  "schema": "map-export-profile/v1",
  "name": "source2",
  "description": "One production map quality policy for authoring and relighting. GPU Cycles, directional indirect light and invariant-validated compiled runtime data. No per-map quality overrides or reference-image comparisons.",
  "lightmap": {
    "size": 4096,
    "samples": 2048,
    "device": "gpu",
    "denoise": true,
    "directional": true,
    "layers": [
      "direct",
      "indirect"
    ],
    "directional_samples": 2048,
    "direct_samples": 2048,
    "light_paths": "gi-reference",
    "layout": "planar",
    "exclude_materials": [
      "relight_occluder"
    ],
    "seam_gate": {
      "max": 0.24
    }
  },
  "probe_volume": {
    "spacing_m": 2.0,
    "samples": 4096,
    "fit_limit": false,
    "max_probes": 50000
  },
  "reflection_probe": {
    "width": 512,
    "face_size": 256,
    "samples": 1024,
    "placement": {
      "max_probes": 256,
      "max_walkable": 2000
    },
    "light_paths": "gi-reference",
    "relight": false
  },
  "reference": null,
  "runtime_gate": null,
  "audit": {
    "min_lightmap_samples": 2048,
    "require_denoise": true,
    "require_directional": true,
    "require_reflection_probe": true,
    "require_reflection_candidates": true,
    "max_reflection_probe_residual": 2.5,
    "require_reflection_probe_budget": true,
    "max_uncovered_walkable_fraction": 0.12,
    "max_unserved_glossy_fraction": 0.55,
    "require_authored_channels": true,
    "max_wmsh_normal_fallback_fraction": 0.01,
    "require_runtime_gate_when_booted": false
  },
  "revision": 5,
  "world_mesh": {
    "exclude_materials": [
      "relight_occluder"
    ]
  },
  "radiosity": null,
  "sdf_volume": null
}
