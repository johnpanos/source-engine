SPDL
Version = "2.0.0.1";
Reference = "{5EEA18F4-19B8-40a5-96F5-3BCAC4741C5D}";
Name = "HelperBoneOp";

DEFINE_GUID(Property,				0x9e04fcee, 0x10f3, 0x11d0, 0x94, 0x3a, 0x0, 0xaa, 0x0, 0x6d, 0x31, 0x65);
DEFINE_GUID(GlobalKinematicState,		0xf75293a0, 0x5a6b, 0x11d0, 0x84, 0xc9, 0x0, 0xa0, 0x24, 0x3e, 0x35, 0x43);
DEFINE_GUID(IID_AnyInterface,		0x00000000, 0x0000, 0x0000, 0xC0, 0x00, 0x0, 0x00, 0x00, 0x00, 0x00, 0x46);
DEFINE_GUID(CustomProperty,		0x76332575, 0xD242, 0x11d0, 0xB6, 0x9C, 0x0, 0xAA, 0x00, 0x3B, 0x3E, 0xA6);

PropertySet "HelperBoneOp_Params"
{
	Parameter "HelperBoneOp"
	{
		GUID  = {5EEA18F4-19B8-40a5-96F5-3BCAC4741C5D};
		Type  = VT_EMPTY;
		Caps  = Persistable; /* 0x00000004 */
	}
}

PortSet "HelperBoneOp_Ports"
{
	Group "HelperBoneGroup"
	{
		Origin = Select;
		Min=1;
		Max=1;

		Output "outglobalkineport"
		{
			Major = Property;
			Minor = GlobalKinematicState;
			Interface = IID_AnyInterface;
			Attributes = 0x00000001;
		}
		Input "globalkineport"
		{
			Major = Property;
			Minor = GlobalKinematicState;
			Interface = IID_AnyInterface;
			Attributes = 0x00000001;
		}
		Input "bonedataport"
		{
			Major = Property;
			Minor = CustomProperty;
			Interface = IID_AnyInterface;
		}
	}

	Group "RootBoneGroup"
	{
		Origin = Pick;
		Min=1;
		Max=1;
		PickMessage = "Pick root bone";

		Input "globalkineport"
		{
			Major = Property;
			Minor = GlobalKinematicState;
			Interface = IID_AnyInterface;
		}
	}

	Group "ParentBoneGroup"
	{
		Origin = Pick;
		Min=1;
		Max=1;
		PickMessage = "Pick parent bone";

		Input "globalkineport"
		{
			Major = Property;
			Minor = GlobalKinematicState;
			Interface = IID_AnyInterface;
		}
	}

	Group "ChildBoneGroup"
	{
		Origin = Pick;
		Min=1;
		Max=1;
		PickMessage = "Pick child";

		Input "globalkineport"
		{
			Major = Property;
			Minor = GlobalKinematicState;
			Interface = IID_AnyInterface;
		}
	}
}

Plugin = Library
{
	api = cpp;
	Filename = "HelperBoneOp";
	EntryPoints
	{
		Init = "HelperBoneOp_Init";
		Term = "HelperBoneOp_Term";
		Update = "HelperBoneOp_Update";
	}
}

