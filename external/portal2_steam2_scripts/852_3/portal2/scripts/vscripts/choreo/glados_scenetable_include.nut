	//smellyhuman03
		//Here's an interesting story. I almost got a job down here in Manufacturing. Guess who the foreman went with? An exact duplicate of himself. Favoritism. Give me the WORST job, tending to all the smelly humans. Sorry. That just slipped out. Insensitive.
		SceneTable["sp_sabotage_darknesssmellyhuman0301"] <- {vcd=CreateSceneEntity("scenes/npc/sphere03/sphere_flashlight_tour71.vcd"),postdelay=0.1,next=null,char="wheatley",fires=[{entity="lookat_player_rl",input="Trigger",parameter="",delay=15.000,fireatstart=true},{entity="@enable_fast_swivel",input="Trigger",parameter="",delay=14.00,fireatstart=true},{entity="@disable_fast_swivel",input="Trigger",parameter="",delay=17.00,fireatstart=true}],noDingOff=true,noDingOn=true}
	//smellyhuman04
