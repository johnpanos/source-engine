	return

def build(bld):
	source = [
		'job_graph.cpp',
		'deterministic_executor.cpp',
		'parallel_executor.cpp',
		'frame_graph.cpp',
		'pilot_particles.cpp',
	]

	includes = [
		'../public',
	]

	bld.stlib(
		source    = source,
		target    = PROJECT_NAME,
		name      = PROJECT_NAME,
		features  = 'c cxx',
		includes  = includes,
		defines   = [],
		cxxflags  = ['-std=c++20'],
		use       = [],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx       = bld.get_taskgen_count()
	)
