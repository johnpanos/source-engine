#! /usr/bin/env python
# encoding: utf-8

# Dependency-aware job system (RFC 0003). A self-contained, portable C++20
# static library over standard atomics/threads. It deliberately does not depend
# on tier0/tier1 or the legacy jobthread pool; it is a deliberately migrated
# C++20 target whose dialect is selected in quality/toolchain/policy.json.

from waflib import Utils
import os

top = '.'
PROJECT_NAME = 'jobsystem'

def options(opt):
	return

def configure(conf):
	conf.load('strict_cpp20', tooldir='scripts/waifulib')

def build(bld):
	source = [
		'job_graph.cpp',
		'deterministic_executor.cpp',
		'parallel_executor.cpp',
		'thread_worker_backend.cpp',
		'parallel_batch.cpp',
		'frame_graph.cpp',
		'serial_frame_graph.cpp',
		'declared_frame_graph.cpp',
		'pilot_particles.cpp',
		'dynamic_scope.cpp',
	]

	includes = [
		'../public',
	]

	# jobs.graph (RFC 0016 K0): a strict capability module. Its C++ API crosses
	# into the engine and client, which build with libstdc++'s old dual ABI on
	# Linux, so it keeps that ABI (as platform_composition_legacyabi does).
	defines = [ '_GLIBCXX_USE_CXX11_ABI=0' ] if bld.env.DEST_OS == 'linux' else []
	bld.stlib(
		env       = bld.strict_cpp20_env(),
		source    = source,
		target    = PROJECT_NAME,
		name      = PROJECT_NAME,
		arch_module = 'jobs.graph',
		features  = 'cxx capability_strict',
		includes  = includes,
		defines   = defines,
		use       = [],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx       = bld.get_taskgen_count()
	)
