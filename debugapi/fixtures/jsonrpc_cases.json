{
 "schema": "debugapi-jsonrpc-fixtures/v1",
 "description": "Shared JSON-RPC 2.0 cases for source.debug.v1. The C++ suite (unittests/debugapitest/test_jsonrpc.cpp) runs every case against the fake host (unittests/debugapitest/fakes/fake_host.h) under each framing; the Python suite (tools/debugapi/tests) checks the same params/results with the generated Python bindings. An expected error without \"message\" accepts any nonempty message. \"$FRAMING\" is the active framing name. Before each pump the fake clock advances by pumpClockStepSeconds. Products: client (default), dedicated, dedicated-idle (dedicated with no active server).",
 "pumpClockStepSeconds": 0.015625,
 "cases": [
  {
   "name": "hello",
   "steps": [
    {
     "send": {
      "jsonrpc": "2.0",
      "id": 1,
      "method": "hello",
      "params": {
       "protocolVersion": "PROTOCOL_VERSION_1",
       "clientName": "fixture"
      }
     },
     "pumps": 1,
     "expect": [
      {
       "jsonrpc": "2.0",
       "id": 1,
       "result": {
        "protocolVersion": "PROTOCOL_VERSION_1",
        "framing": "$FRAMING",
        "transport": "memory:",
        "product": "PRODUCT_CLIENT",
        "buildRevision": "fixture-revision",
        "hostState": "HOST_STATE_RUN",
        "providers": [
         {
          "role": "render",
          "id": "null"
         },
         {
          "role": "physics",
          "id": "fixture"
         }
        ],
        "gameDir": "/game/portal"
       }
      }
     ]
    }
   ]
  },
