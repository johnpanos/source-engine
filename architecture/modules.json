  "description": "RFC 0001 architectural manifest. Phase A currently freezes legacy dynamic-loader boundaries.",
  "legacyAbi": {
    "description": "Preserved binary ABI declarations and exact private compatibility adapters/tests. Video provider runtime supplies the existing IVideoSubSystem::Connect factory without exposing it through the typed catalog.",
    "paths": [
      "video/provider_catalog_runtime.h",
      "video/provider_catalog_runtime.cpp",
      "unittests/videoprovidertest/catalog_test.cpp",
      "public/tier1/interface.h",
      "tier1/interface.cpp",
      "external/vpc/public/tier1/interface.h",
      "external/vpc/tier1/interface.cpp",
      "unittests/appframeworktest/appsystemgrouptest.cpp",
      "unittests/legacymoduleclientfixture/legacy_loader_abi_2013.h",
      "unittests/legacymoduleclientfixture/legacymoduleclientfixture.cpp",
      "unittests/shaderextensiontest/test_shaderextension_host.cpp",
      "unittests/shaderextensiontest/material_pixel_conformance.cpp"
    ]
  },
  "loaderInventory": {
    "classifications": [
      {
        "name": "retained-extension",
        "pathPrefixes": [
          "materialsystem/shaderextension_compatibility_host.cpp"
        ],
        "reason": "Private ShaderDLL004 mod-extension host; scoped filesystem acquisition, version negotiation and disconnect-before-unload preserve the retained ABI."
      },
      {
        "name": "tool-indirection",
        "pathPrefixes": [
          "devtools/",
          "external/vpc/",
          "tools/",
          "unittests/",
          "utils/"
        ],
        "reason": "Tool-only implementation, wrapper, or optional tool integration."
      },
      {
        "name": "retained-extension",
        "pathPrefixes": [
          "game/",
          "gameui/",
          "serverbrowser/",
          "engine/sv_plugin",
          "engine/cdll_engine",
          "engine/sys_dll"
        ],
        "reason": "Game, server, or UI extension boundary retained for compatibility."
      },
      {
        "name": "optional-provider",
        "pathPrefixes": [
          "common/ihfx/",
          "common/dx_proxy/",
          "materialsystem/",
          "inputsystem/",
          "replay/",
          "sfmobjects/",
          "video/"
        ],
        "reason": "Optional product, renderer, input, video, or vendor provider."
      },
      {
        "name": "native-symbol-probe",
        "pathPrefixes": [
          "tier0/",
          "vstdlib/",
          "vguimatsurface/",
          "engine/audio/",
          "engine/cl_check_process",
          "engine/sys_mainwind"
        ],
        "rules": [
          "INVENTORY_NATIVE_LOAD"
        ],
        "reason": "Native API availability or vendor symbol probe."
      },
      {
        "name": "first-party-composition",
        "pathPrefixes": [
          "appframework/",
          "dedicated/",
          "dedicated_main/",
          "launcher/",
          "launcher_main/",
          "filesystem/",
          "tier1/",
          "public/"
        ],
        "reason": "First-party runtime module assembled by legacy application composition."
      }
    ]
  },
  "hammerModules": {
    "version": 1,
    "description": "RFC 0002 editor module ownership and allowed dependency edges. Strict modules carry zero baseline debt and reject native/toolkit types.",
    "strictIncludeRoots": [
      "public/hammer/",
      "hammer/core/"
    ],
    "legacyHost": "hammer.adapters.mfc",
    "modules": [
      {
        "id": "hammer.geometry",
        "strict": true,
        "owns": "Geometric values, algorithms, numeric policies",
        "allowedEdges": []
      },
      {
        "id": "hammer.scene",
        "strict": true,
        "owns": "Content graph, typed IDs, document metadata, invariants",
        "allowedEdges": [
          "hammer.geometry"
        ]
      },
      {
        "id": "hammer.ports",
        "strict": true,
        "owns": "Asset, persistence, job, and external-service contracts",
        "allowedEdges": [
          "hammer.geometry",
          "hammer.scene"
        ]
      },
      {
        "id": "hammer.formats",
        "strict": true,
        "owns": "VMF/MAP/RMF codecs and format validation",
        "allowedEdges": [
          "hammer.geometry",
          "hammer.scene",
          "hammer.ports"
        ]
      },
      {
        "id": "hammer.app",
        "strict": true,
        "owns": "Sessions, queries, edit transactions, history, save/build orchestration",
        "allowedEdges": [
          "hammer.geometry",
          "hammer.scene",
          "hammer.ports"
        ]
      },
      {
        "id": "hammer.viewport",
        "strict": true,
        "owns": "Projection, picking queries, presentation extraction, render contracts",
        "allowedEdges": [
          "hammer.geometry",
          "hammer.scene",
          "hammer.ports"
        ]
      },
      {
        "id": "hammer.tools",
        "strict": true,
        "owns": "Gesture state machines and edit/overlay production",
        "allowedEdges": [
          "hammer.geometry",
          "hammer.scene",
          "hammer.ports",
          "hammer.app",
          "hammer.viewport"
        ]
      },
      {
        "id": "hammer.presenters",
        "strict": true,
        "owns": "Inspector/browser/view presentation models and action routing",
        "allowedEdges": [
          "hammer.app",
          "hammer.tools",
          "hammer.viewport",
          "hammer.ports",
          "hammer.scene"
        ]
      },
      {
        "id": "hammer.adapters.source",
        "strict": false,
        "owns": "Source asset and renderer integrations",
        "allowedEdges": [
          "hammer.ports",
          "hammer.viewport",
          "hammer.scene",
          "hammer.geometry"
        ]
      },
      {
        "id": "hammer.adapters.platform",
        "strict": false,
        "owns": "Files, settings, processes, clocks, watchers, scheduling",
        "allowedEdges": [
          "hammer.ports"
        ]
      },
      {
        "id": "hammer.adapters.mfc",
        "strict": false,
        "owns": "Existing shell and compatibility glue",
        "allowedEdges": [
          "hammer.presenters",
          "hammer.app",
          "hammer.tools",
          "hammer.viewport",
          "hammer.ports",
          "hammer.scene",
          "hammer.geometry",
          "hammer.formats"
        ]
      },
      {
        "id": "hammer.adapters.gtk",
        "strict": false,
        "owns": "Canonical GTK4/libadwaita rendering+interaction shell at hammer/gtk/ (4-view layout, GL viewports, tool/menu input, main-context dispatch); sibling of hammer.adapters.mfc, both driving the reusable MFC-free libraries",
        "allowedEdges": [
          "hammer.presenters",
          "hammer.app",
          "hammer.tools",
          "hammer.viewport",
          "hammer.ports",
          "hammer.scene",
          "hammer.geometry",
          "hammer.adapters.platform"
        ]
      },
      {
        "id": "hammer.interop.gtk_source",
