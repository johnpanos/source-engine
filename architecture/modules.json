  "loaderExceptions": {
    "description": "RFC 0001 'Baseline and exceptions': reviewed exceptions to the ARCH101-ARCH105 loader ratchet. Each names one file, one rule and the exact number of unbaselined occurrences it covers, with a reason, an owning roadmap row, a tracking record and a removal condition. archlint fails on a count mismatch or a stale entry. Added 2026-09-25 by R04-DRIFT (user decision) for the Portal 2 reconstruction glue.",
    "entries": [
      {
        "path": "engine/vgui_baseui_interface.cpp",
        "rule": "ARCH105",
        "count": 1,
        "reason": "The engine probes the client factory for a GameUI embedded in the Portal 2 client.",
        "owner": "R39",
        "tracking": "RFC/0001-phase-a-progress.md#loader-exceptions-2026-09-25",
        "removal": "The engine asks the client for an embedded GameUI through a typed query instead of reading g_ClientFactory."
      },
      {
        "path": "game/client/portal2/gameui/optionssubmultiplayer.cpp",
        "rule": "ARCH101",
        "count": 1,
        "reason": "Retail Portal 2 multiplayer options load vtex_dll to convert spray images.",
        "owner": "R41",
        "tracking": "RFC/0001-phase-a-progress.md#loader-exceptions-2026-09-25",
        "removal": "vtex conversion runs through a named, versioned tool or extension host (R41), so the GameUI loads no module by filename."
