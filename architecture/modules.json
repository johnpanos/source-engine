        "allowedEdges": [
          "hammer.viewport",
          "hammer.adapters.gtk",
          "hammer.adapters.source"
        ]
      },
      {
        "id": "hammer.composition",
        "strict": false,
        "owns": "Provider selection, wiring, startup/shutdown",
        "allowedEdges": [
          "hammer.geometry",
          "hammer.scene",
          "hammer.ports",
          "hammer.formats",
          "hammer.app",
          "hammer.viewport",
          "hammer.tools",
          "hammer.presenters",
          "hammer.adapters.source",
          "hammer.adapters.platform",
          "hammer.adapters.mfc",
          "hammer.adapters.gtk",
          "hammer.interop.gtk_source"
