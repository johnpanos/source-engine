#! /usr/bin/env python
# encoding: utf-8

# RFC 0008 F3 read-only KTX2 adapter. The host KTX-Software build is selected
# explicitly at configure time and checked against the profile revision.

def options(opt):
	pass

def configure(conf):
	conf.load('strict_cpp20', tooldir='scripts/waifulib')
	conf.add_subproject('vtf')

def build(bld):
	bld.add_subproject('vtf')
	# The VTF reader needs no KTX: the render core's cookies and the lab read
	# VTFs in every client build.
	bld.stlib(
		features='c cxx',
		env=bld.strict_cpp20_env(),
		source=['vtf_reader.cpp'],
		target='vtf_texture_reader',
		name='vtf_texture_reader',
		arch_module='content.vtf-reader',
		includes=['../public'],
		use=['vtf_container'],
		install_path=None)
	if not bld.env.KTX_READ_ENABLED:
		return
	bld.stlib(
		features='c cxx',
		source=['ktx2_reader.cpp'],
		target='texturecontainer',
		name='texturecontainer',
		arch_module='content.ktx2-reader',
		includes=['../public'] + bld.env.INCLUDES_KTXREAD + bld.env.INCLUDES_VULKAN,
		use=['KTXREAD', 'VULKAN'],
		install_path=None)
