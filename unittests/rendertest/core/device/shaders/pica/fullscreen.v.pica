; tri.vert for render.device.pica (RFC 0026): the full-screen triangle of
; vertex index i = 0, 1, 2 at clip (-1, -1), (3, -1), (-1, 3), port depth 0.25.
; The PICA has no vertex index: the adapter feeds it to v0 (PVS1's vertex
; index register). p = (4i - 2i^2, i^2 - i) is (0, 0), (2, 0), (0, 2).
; Writes PICA clip space: z is the port's negated. texcoord0 is the point's
; (u, 1 - v) (PVS1's texture convention), where (u, v) = (p.x, 1 - p.y) is
; what sampled.frag's gl_FragCoord.xy / size gives over a target the
; texture's size: so texcoord0 = (p.x, p.y). texcoord1 is the same, for
; render.device.pica's two-unit check.

.constf k(4.0, 2.0, 1.0, -0.25)

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1

.alias index v0

.proc main
	mul r0.x, index.xxxx, index.xxxx
	mul r1.x, k.xxxx, index.xxxx
	mul r4.x, k.yyyy, r0.xxxx
	add r1.x, r1.xxxx, -r4.xxxx
	add r1.y, r0.xxxx, -index.xxxx

	mul r2.xy, k.yyyy, r1.xyyy
	add r2.xy, -k.zzzz, r2.xyyy
	mov r2.z, k.wwww
	mov r2.w, k.zzzz
	mov outpos, r2

	mov r3, k.zzzz
	mov r3.xy, r1.xyyy
	mov outtc0, r3
	mov outtc1, r3

	mov outclr, k.zzzz
	end
.end
