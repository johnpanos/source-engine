; render.device.pica's own raster checks (test_device_pica.cpp, RFC 0026):
; attribute 0 (v0) is a clip-space xy, moved by the first uniform buffer's
; first vec4 (c0, PVS1's uniform range (1, 0) -> c0); port depth 0.5.

.fvec shift

.constf k(1.0, -0.5, 0.0, 0.0)

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias position v0

.proc main
	mov r1, shift
	add r0.xy, position.xyyy, r1.xyyy
	mov r0.z, k.yyyy
	mov r0.w, k.xxxx
	mov outpos, r0
	mov outtc0, k.xxxx
	mov outclr, k.xxxx
	end
.end
