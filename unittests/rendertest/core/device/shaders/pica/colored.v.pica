; render.device.pica's own raster checks (test_device_pica.cpp, RFC 0026):
; attribute 0 (v0) a clip-space xy, attribute 1 (v1) a kUnorm8x4 colour,
; which PVS1 delivers as 0 to 255 and the program scales; port depth 0.5.

.constf k(1.0, -0.5, 0.00392156862745098, 0.0)

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias position v0
.alias tint v1

.proc main
	mov r0.xy, position.xyyy
	mov r0.z, k.yyyy
	mov r0.w, k.xxxx
	mov outpos, r0
	mul outclr, k.zzzz, tint
	mov outtc0, k.xxxx
	end
.end
