; tophalf.vert for render.device.pica (RFC 0026): clip x -1 to 3 and clip y
; 0 to 2 (the top half of the view, clip Y up), port depth 0.25. See
; fullscreen.v.pica for the vertex index and the conventions.

.constf k(4.0, 2.0, 1.0, -0.25)

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias index v0

.proc main
	mul r0.x, index.xxxx, index.xxxx
	mul r1.x, k.xxxx, index.xxxx
	mul r4.x, k.yyyy, r0.xxxx
	add r1.x, r1.xxxx, -r4.xxxx
	add r1.y, r0.xxxx, -index.xxxx

	mul r2.x, k.yyyy, r1.xxxx
	add r2.x, -k.zzzz, r2.xxxx
	mov r2.y, r1.yyyy
	mov r2.z, k.wwww
	mov r2.w, k.zzzz
	mov outpos, r2

	mov outtc0, k.zzzz
	mov outclr, k.zzzz
	end
.end
