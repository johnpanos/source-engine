#! /usr/bin/env python
# encoding: utf-8

# Conformance tests for the dependency-aware job system (RFC 0003). These are
# standalone C++20 programs (own main) rather than unitlib-registered shlibs,
# so the C++20 module is not linked into the C++11 unitlib loader. Run directly:
#   <testdir>/jobsystemtest && <testdir>/jobsystemframetest

from waflib import Utils
import os

top = '.'
PROJECT_NAME = 'jobsystemtest'

def options(opt):
	return

def configure(conf):
	return

def build(bld):
	includes = [
		'../../public',
	]

	# DL/LOG are waf uselibs (dlopen + logging) required only when linking tier0.
	dl_log = [ 'DL', 'LOG' ] if bld.env.DEST_OS != 'win32' else []
	linkflags = [ '-pthread' ] if bld.env.DEST_OS != 'win32' else []

	# ( target, source, use-libs ). The engine-bridge test links the real vstdlib
	# thread pool (and its tier0/tier1 dependencies); the pure-scheduler tests
	# only need the self-contained jobsystem library.
	programs = [
		( 'jobsystemlegacybatchtest', 'legacybatchtest.cpp', ['vstdlib', 'tier1', 'tier0'] + dl_log ),
		# Host frame graph vs the legacy hand-ordered frame (recording stand-ins).
		( 'jobsystemhostframetest', 'hostframetest.cpp', ['jobsystem'] ),
		# Real vstdlib pool + tier0 CTSQueue race/contract fixture (run under TSan).
		( 'jobsystemthreadpooltest', 'threadpooltest.cpp', ['vstdlib', 'tier1', 'tier0'] + dl_log ),
		# Pool/CTSQueue microbenchmarks; old-API only, so it also builds against older trees.
		( 'jobsystemthreadpoolbench', 'threadpoolbench.cpp', ['vstdlib', 'tier1', 'tier0'] + dl_log ),
		( 'jobsystempooledtest', 'pooledexecutortest.cpp', ['jobsystem'] ),
		( 'jobsystemdeclaredframetest', 'declaredframetest.cpp', ['jobsystem'] ),
		# Client render-start blocks vs the legacy OnRenderStart (recording stand-ins).
		( 'jobsystemrenderstarttest', 'renderstarttest.cpp', ['jobsystem'] ),
		( 'jobsystembatchtest', 'parallelbatchtest.cpp', ['jobsystem'] ),
		( 'jobsystemtest',        'jobsystemtest.cpp',    ['jobsystem'] ),
		( 'jobsystemframetest',   'frametest.cpp',        ['jobsystem'] ),
		( 'jobsystemdynamictest', 'dynamicscopetest.cpp', ['jobsystem'] ),
		( 'jobsystemqjobstest',   'qjobstest.cpp',        ['jobsystem'] ),
		( 'jobsystemsealeqtest',  'sealequivalencetest.cpp', ['jobsystem'] ),
		( 'jobsystemstresstest',  'executorstresstest.cpp',  ['jobsystem'] ),
		# Microbenchmarks: validated smoke run by default, --full for numbers.
		( 'jobsystembench',       'jobsystembench.cpp',      ['jobsystem'] ),
		( 'jobsystembridgetest',  'enginebridgetest.cpp', ['jobsystem', 'vstdlib', 'tier1', 'tier0'] + dl_log ),
		# Portal carving: real mathlib clipping through the C++11 game-facing facade.
		( 'jobsystemportalcarvetest', 'portalcarvetest.cpp', ['mathlib', 'vstdlib', 'tier1', 'tier0'] + dl_log ),
	]
	# Dialects are selected in quality/toolchain/policy.json: the C++20 tests are
	# listed there; the legacy-facade tests keep the default C++11 dialect.
	cxx11 = [ 'jobsystemlegacybatchtest', 'jobsystemhostframetest', 'jobsystemthreadpooltest', 'jobsystemthreadpoolbench', 'jobsystemportalcarvetest' ]

	for target, src, use_libs in programs:
		bld.program(
			source       = [ src ],
			target       = target,
			name         = target,
			features     = 'c cxx cxxprogram',
			includes     = includes + (['../../public/tier0'] if target in cxx11 else []) +
				(['../..'] if target == 'jobsystemportalcarvetest' else []),
			defines      = [],
			linkflags    = linkflags,
			use          = use_libs,
			install_path = bld.env.TESTDIR,
			subsystem    = bld.env.MSVC_SUBSYSTEM,
			idx          = bld.get_taskgen_count()
		)
