#! /usr/bin/env python
# encoding: utf-8

# Conformance tests for the dependency-aware job system (RFC 0003). These are
# standalone C++20 programs (own main) rather than unitlib-registered shlibs,
# so the C++20 module is not linked into the C++11 unitlib loader. Run directly:
#   <testdir>/jobsystemtest && <testdir>/jobsystemframetest

from waflib import Utils
import os

top = '.'
PROJECT_NAME = 'jobsystemtest'

def options(opt):
	return

def configure(conf):
	return

def build(bld):
	includes = [
		'../../public',
	]

	# DL/LOG are waf uselibs (dlopen + logging) required only when linking tier0.
	dl_log = [ 'DL', 'LOG' ] if bld.env.DEST_OS != 'win32' else []
	linkflags = [ '-pthread' ] if bld.env.DEST_OS != 'win32' else []

	# ( target, source, use-libs ). The engine-bridge test links the real vstdlib
	# thread pool (and its tier0/tier1 dependencies); the pure-scheduler tests
	# only need the self-contained jobsystem library.
	programs = [
		( 'jobsystemlegacybatchtest', 'legacybatchtest.cpp', ['vstdlib', 'tier1', 'tier0'] + dl_log ),
		( 'jobsystempooledtest', 'pooledexecutortest.cpp', ['jobsystem'] ),
		( 'jobsystembatchtest', 'parallelbatchtest.cpp', ['jobsystem'] ),
		( 'jobsystemtest',        'jobsystemtest.cpp',    ['jobsystem'] ),
		( 'jobsystemframetest',   'frametest.cpp',        ['jobsystem'] ),
		( 'jobsystemdynamictest', 'dynamicscopetest.cpp', ['jobsystem'] ),
		( 'jobsystemqjobstest',   'qjobstest.cpp',        ['jobsystem'] ),
		( 'jobsystembridgetest',  'enginebridgetest.cpp', ['jobsystem', 'vstdlib', 'tier1', 'tier0'] + dl_log ),
	]

	for target, src, use_libs in programs:
		bld.program(
			source       = [ src ],
			target       = target,
			name         = target,
			features     = 'c cxx cxxprogram',
			includes     = includes + (['../../public/tier0'] if target == 'jobsystemlegacybatchtest' else []),
			defines      = [],
			cxxflags     = ['-std=c++11' if target == 'jobsystemlegacybatchtest' else '-std=c++20'],
			linkflags    = linkflags,
			use          = use_libs,
			install_path = bld.env.TESTDIR,
			subsystem    = bld.env.MSVC_SUBSYSTEM,
			idx          = bld.get_taskgen_count()
		)
