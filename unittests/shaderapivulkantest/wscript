#! /usr/bin/env python
# encoding: utf-8


def options(opt):
	pass


def configure(conf):
	pass


def build(bld):
	# Native Vulkan bring-up / presentation smoke test (roadmap R28). It links
	# the real device core directly (no engine composition) and requires a
	# Vulkan device plus a display at run time; without them it reports an
	# explicit skip (exit 77) rather than a false pass. Only built in native
	# Vulkan configurations.
	if not bld.env.NATIVE_VULKAN:
		return

	test_env = bld.env.derive()
	test_env.DEFINES = [value for value in bld.env.DEFINES
		if not value.startswith('strncpy=')]

	includes = ['../../materialsystem/shaderapivulkan', '../../public',
		'../../public/tier0', '../../public/tier1'] \
		+ bld.env.INCLUDES_SDL3 + bld.env.INCLUDES_VULKAN

	bld.program(
		features='c cxx', env=test_env.derive(),
		source=['test_vulkan_bringup.cpp',
			'../../materialsystem/shaderapivulkan/vulkan_device.cpp',
			'../../materialsystem/shaderapivulkan/vulkan_compute.cpp',
			'../../materialsystem/shaderapivulkan/vulkan_adapter.cpp',
			'../../materialsystem/shaderapivulkan/vulkan_descriptor_groups.cpp',
			'../../materialsystem/shaderapivulkan/vulkan_scene_capture.cpp'],
		target='native_vulkan_bringup_conformance',
		name='native_vulkan_bringup_conformance',
		arch_module='render.bridge.sdl3-vulkan.native-tests',
		includes=includes, use=['render_bridge_sdl3_vulkan', 'VULKAN', 'SDL3', 'vulkan_debug', 'render_device_vulkan', 'render_spv'],
		install_path=None)

	# Substitutability proof (LSP): the native Vulkan provider of the
	# render.contracts backend contract runs the SAME shared conformance suite as
	# the null provider. No SDL/window needed -- devices never present; the
	# presentation bridges do. Skips (exit 77) when no Vulkan device is present.
	bld.program(
		features='c cxx', env=test_env.derive(),
		source=['../rendertest/test_render_backend_vulkan.cpp',
			'../rendertest/conformance/render_backend_conformance.cpp',
			'../../render/device/vulkan/backend_v1/render_backend_v1.cpp',
			'../../materialsystem/shaderapivulkan/vulkan_compute.cpp'],
		target='render_backend_vulkan_conformance',
		name='render_backend_vulkan_conformance',
		arch_module='render.vulkan.native-tests',
		includes=['../rendertest', '../../materialsystem/shaderapivulkan', '../../public',
			'../../public/tier0', '../../public/tier1'] + bld.env.INCLUDES_VULKAN,
		# The render.contracts headers and shared suite need C++14+ aggregate
		# initialization; the target is C++20 in quality/toolchain/policy.json,
		# the same dialect the conformance runner uses.
		use=['VULKAN', 'vulkan_debug', 'render_device_vulkan', 'render_spv'],
		install_path=None)

	# RFC 0001 R16: the SDL3-Vulkan presentation bridge runs the SAME shared
	# presentation suite as the headless pair (unittests/rendertest), against real
	# windows, a real swapchain and GPU completion held by a timeline semaphore,
	# then checks presented pixels in two windows. Opens windows: run it only
	# under an isolated compositor (see RFC/0001-presentation-bridge-progress.md).
	# Skips (exit 77) without a display or Vulkan device.
	bld.program(
		features='c cxx', env=test_env.derive(),
		source=['test_sdl3_vulkan_presentation.cpp',
			'../rendertest/conformance/render_backend_conformance.cpp',
			'../rendertest/conformance/render_presentation_conformance.cpp',
			'../../render/device/vulkan/backend_v1/render_backend_v1.cpp',
			'../../materialsystem/shaderapivulkan/vulkan_compute.cpp',
			'../../render/bridge/sdl3-vulkan/sdl3_vulkan_presentation.cpp',
			'../../render/bridge/sdl3-vulkan/sdl3_dynamic_range.cpp',
			'../../platform/sdl3/render_surface/sdl3_render_surfaces.cpp'],
		target='render_presentation_sdl3_vulkan_conformance',
		name='render_presentation_sdl3_vulkan_conformance',
		arch_module='render.bridge.sdl3-vulkan.native-tests',
		includes=['../rendertest', '../../materialsystem/shaderapivulkan', '../../public']
			+ bld.env.INCLUDES_SDL3 + bld.env.INCLUDES_VULKAN,
		use=['VULKAN', 'SDL3', 'vulkan_debug', 'render_device_vulkan', 'render_spv'],
		install_path=None)

	# RFC 0011 G5 render.compute: the compute foundation on a headless device
	# (no window), so the same program also runs on an Android device.
	bld.program(
		features='c cxx', env=test_env.derive(),
		source=['test_compute.cpp',
			'../../materialsystem/shaderapivulkan/vulkan_compute.cpp'],
		target='compute_native_conformance',
		name='compute_native_conformance',
		includes=includes,
		use=['VULKAN', 'vulkan_debug', 'render_device_vulkan', 'render_spv'],
		install_path=None)

	# RFC 0011 G6 render.indirect-light.sdf: the shared producer suite run
	# against the SDF-traced producer through the renderer's compute service
	# on a headless device. Skips (exit 77) without a device.
	bld.program(
		features='c cxx', env=test_env.derive(),
		source=['test_indirect_sdf.cpp',
			'../../materialsystem/shaderapivulkan/vulkan_compute.cpp'],
		target='indirect_sdf_native_conformance',
		name='indirect_sdf_native_conformance',
		includes=includes,
		use=['VULKAN', 'mapcontainer', 'vulkan_debug', 'render_pass_indirect', 'render_shaderlib',
			'render_device_vulkan', 'render_device', 'render_spv'],
		install_path=None)

	# Material-facing integration slice: drives the legacy IShaderAPI/IShaderDevice
	# interfaces (as the material system does) through the linked native Vulkan
	# backend and reads the presented frame back. Links the real backend library.
	# Queued-mesh contract (mat_queue_mode 2): ComputeVertexDescription plus the
	# material system's verbatim replay reproduce a direct build's records for
	# every vertex format, with a packed-layout negative control. CPU only.
	bld.program(
		features='c cxx', env=test_env.derive(),
		source=['test_queued_mesh_contract.cpp',
			'../../materialsystem/shaderapivulkan/vulkan_mesh_layout.cpp'],
		target='queued_mesh_contract_vulkan_conformance',
		name='queued_mesh_contract_vulkan_conformance',
		includes=['../../materialsystem/shaderapivulkan', '../../public',
			'../../public/tier0', '../../public/tier1']
			+ bld.env.INCLUDES_VULKAN,
		use=['shaderapivulkan', 'tier0', 'tier1', 'VULKAN', 'render_spv'],
		install_path=None)

	# Material equivalence oracle: asserts the native UnlitGeneric path produces
	# the result the D3D9 shader defines (cModulationColor * baseTexture at the
	# transformed UV), with every constant set at its real Source register number
	# and negative controls proving the oracle detects a non-conforming backend.
	# Links the real backend library; skips (exit 77) without a device/display.