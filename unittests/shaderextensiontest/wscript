#! /usr/bin/env python
# encoding: utf-8


def options(opt):
	pass


def configure(conf):
	pass


def build(bld):
	# These fixtures compile the real legacy-boundary implementation against its
	# real ABI headers. Assertions remain active independently of NDEBUG.
	test_env = bld.env.derive()
	test_env.DEFINES = [value for value in bld.env.DEFINES
		if not value.startswith('strncpy=')]
	includes = ['../../public', '../../public/tier0', '../../public/tier1',
		'../../materialsystem']
	bld.program(
		features='c cxx', env=test_env.derive(),
		source=['test_shaderextension_host.cpp',
			'../../materialsystem/shaderextension_compatibility_host.cpp'],
		target='shader_extension_conformance', name='shader_extension_conformance',
		arch_module='render.shader-extension-abi-test',
		includes=includes, install_path=None)
	# The catalog check must see exactly the backends this product linked, so it
	# mirrors the composition root's own link conditions and defines.
	binding_use = ['materialsystem', 'shaderapiempty', 'tier0', 'vstdlib']
	binding_defines = list(test_env.DEFINES)
	if bld.env.SDL3:
		binding_use += ['SDL3']
	bld.program(
		features='cxx', env=test_env.derive(),
		source=['test_material_binding.cpp'],
		target='material_binding_conformance', name='material_binding_conformance',
		includes=includes, defines=binding_defines,
		use=binding_use,
		install_path=None)
	# RFC 0001 rank 8: legacy render modules through the render.contracts provider
	# contract, running the shared render-backend suite (C++11-compatible) against
	# the real null module, the native Vulkan module where linked, and bad fakes.
	provider_use = ['shaderapiempty', 'tier0', 'tier1', 'vstdlib']
	provider_defines = list(test_env.DEFINES)
	bld.program(
		features='cxx', env=test_env.derive(),
		source=['test_legacy_render_provider.cpp',
			'../rendertest/conformance/render_backend_conformance.cpp',
			'../../materialsystem/legacy_render_backend_provider.cpp',
			'../../materialsystem/shader_device_facade.cpp',
			'../../materialsystem/dxsupport_keyvalues.cpp'],
		target='legacy_render_provider_conformance',
		name='legacy_render_provider_conformance',
		includes=includes + ['../rendertest'], defines=provider_defines,
		use=provider_use, install_path=None,
		idx=bld.get_taskgen_count())
	if not bld.env.DEDICATED:
		bld.program(
			features='cxx', env=test_env.derive(),
			source=['test_builtin_shaders.cpp', '../../materialsystem/builtin_shader_catalog.cpp'],
			target='builtin_shader_conformance', name='builtin_shader_conformance',
			includes=includes,
			defines=['NATIVE_PBR_METALROUGH'] if bld.env.CLIENT_VULKAN else [],
			use=['stdshader_dx9', 'tier1', 'tier0', 'vstdlib'],
			install_path=None)
