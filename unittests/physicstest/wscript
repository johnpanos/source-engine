def options(opt):
	pass


def configure(conf):
	pass


def build(bld):
	# Shared VPhysics provider conformance suite (RFC 0004 / RFC 0005 Q-PHYSICS).
	# One host binary loads a provider module by path through its exported
	# CreateInterface, as the engine does, so IVP and Box3D run the identical
	# checks. It links no provider; tools/quality/physics_conformance.py runs it
	# once per provider (never two in one process) and compares observations.
	bld.program(
		features='cxx',
		source=['test_vphysics_conformance.cpp'],
		target='vphysics_conformance',
		name='vphysics_conformance',
		includes=['../../public', '../../public/tier0', '../../public/tier1'],
		use=['tier0', 'tier1', 'vstdlib', 'mathlib', 'DL'],
		install_path=None)
