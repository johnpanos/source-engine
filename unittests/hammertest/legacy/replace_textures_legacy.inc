static char * FindInString(char *pszSub, char *pszMain)
{
	char *p = pszMain;
	int nSub = strlen(pszSub);
	
	char ch1 = toupper(pszSub[0]);

	while(p[0])
	{
		if(ch1 == toupper(p[0]))
		{
			if(!strnicmp(pszSub, p, nSub))
				return p;
		}
		++p;
	}

	return NULL;
}

