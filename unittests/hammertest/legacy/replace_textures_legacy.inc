void CMapDoc::OnEditReplacetex(void)
{
	CReplaceTexDlg dlg( m_pSelection->GetCount());

	dlg.m_strFind = GetDefaultTextureName();

	if (dlg.DoModal() != IDOK)
	{
		return;
	}

	GetHistory()->MarkUndoPosition( m_pSelection->GetList(), "Replace Textures");

