#! /usr/bin/env python
# encoding: utf-8

def options(opt):
	pass

def configure(conf):
	pass

def build(bld):
	# VTF 7.6 (P2:CE) in the game's legacy texture path: no KTX needed.
	bld.program(
		features='c cxx',
		source=['test_vtf_decompress.cpp'],
		target='vtf_decompress_conformance',
		name='vtf_decompress_conformance',
		arch_module='content.ktx2-native-tests',
		defines=['VTF_DECOMPRESS_ZSTD'] if bld.env.VTF_DECOMPRESS_ZSTD else [],
		includes=['../../public', '../../public/tier0', '../../public/tier1', '../../external/bcdec'],
		use=['vtf_decompress', 'vtf', 'bitmap', 'mathlib', 'tier0', 'tier1', 'tier2', 'ZLIB'] +
			( ['ZSTD'] if bld.env.VTF_DECOMPRESS_ZSTD else [] ),
		# Runs from the build tree (the conformance manifest): tier0 is shared.
		rpath=[bld.bldnode.find_or_declare('tier0').abspath()],
		install_path=None)
	if not bld.env.KTX_READ_ENABLED:
		return
	bld.program(
		features='c cxx',
		source=['test_ktx2_reader.cpp'],
		target='ktx2_reader_conformance',
		name='ktx2_reader_conformance',
		arch_module='content.ktx2-native-tests',
		includes=['../../public'],
		use=['texturecontainer', 'KTXREAD', 'vtf_container'],
		install_path=None)
	bld.program(
		features='c cxx',
		source=['test_vtf_reader.cpp'],
		target='vtf_texture_reader_conformance',
		name='vtf_texture_reader_conformance',
		arch_module='content.ktx2-native-tests',
		includes=['../../public', '../../public/tier0', '../../public/tier1'],
		use=['vtf_texture_reader', 'texturecontainer', 'KTXREAD', 'vtf',
			'bitmap', 'mathlib', 'tier0', 'tier1', 'tier2'],
		install_path=None)
	# Hammer's decoder and the shared VTF reader exchange std::string through
	# decompression callbacks. Both conformance targets must use the reader's
	# C++ ABI; IVTFTexture/CUtlBuffer retain their legacy ABI independently.
	shared_env = bld.env.derive()
	shared_env.DEFINES = [d for d in bld.env.DEFINES if not d.startswith('_GLIBCXX_USE_CXX11_ABI=')]
	bld.program(
		env=shared_env,
		features='c cxx',
		source=[
			'../hammertest/formats/test_ktx2_preview.cpp',
			'../../hammer/adapters/source/ktx2_preview.cpp',
			'../../hammer/core/formats/material_catalog.cpp',
			'../../hammer/core/formats/material.cpp',
			'../../hammer/core/formats/vtf_image.cpp',
			'../../kvtext/keyvalues.cpp'
		],
		target='hammer_ktx2_preview_conformance',
		name='hammer_ktx2_preview_conformance',
		arch_module='hammer.composition',
		includes=['../..', '../../public', '../hammertest'],
		use=['texturecontainer', 'KTXREAD', 'vtf_container'],
		install_path=None)

	bld.program(
		env=shared_env,
		features='c cxx',
		source=['../hammertest/formats/test_vtf_shared.cpp', '../../hammer/core/formats/vtf_image.cpp'],
		target='vtf_shared_conformance',
		name='vtf_shared_conformance',
		arch_module='hammer.composition',
		defines=['VTF_SHARED_LEGACY'],
		includes=['../..', '../../public', '../../public/tier0', '../../public/tier1'],
		use=['vtf_container', 'vtf_texture_reader', 'vtf', 'bitmap', 'mathlib', 'tier0', 'tier1', 'tier2'],
		install_path=None)
