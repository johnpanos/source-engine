#! /usr/bin/env python
# encoding: utf-8

from waflib import Utils
import os

top = '.'
PROJECT_NAME = 'shaderapivulkan'

def options(opt):
	# stub
	return

def configure(conf):
	conf.env.append_unique('DEFINES',[
		'SHADER_DLL_EXPORT',
		'PROTECTED_THINGS_ENABLE'
	])

def build(bld):
	bld.stlib(
		features = 'c cxx',
		source = [ 'vulkan_texture_image.cpp' ],
		target = 'vulkan_texture_image',
		name = 'vulkan_texture_image',
		arch_module = 'render.bridge.texture-image-vulkan',
		includes = [ '.', '../../public' ] + bld.env.INCLUDES_VULKAN,
		use = [ 'VULKAN', 'texture_block_decode' ],
		install_path = None)

	# Capture-tool support shared by the backend and its GPU suites: debug-utils
	# names and labels, and the embedded shaders' names and debug variants.
	bld.stlib(
		features = 'c cxx',
		source = [ 'vulkan_debug_utils.cpp', 'vulkan_shader_library.cpp' ],
		target = 'vulkan_debug',
		name = 'vulkan_debug',
		includes = [ '.' ] + bld.env.INCLUDES_VULKAN,
		use = [ 'VULKAN', 'render_spv' ],
		install_path = None)

	source = [
		'shaderapivulkan.cpp',
		'vulkan_compute.cpp',
		'vulkan_device.cpp',
		'vulkan_mesh_layout.cpp',
		'vulkan_adapter.cpp',
		'vulkan_scene_capture.cpp',
		'vulkan_world_mesh_upload.cpp',
		'../../public/tier0/memoverride.cpp'
	]

	includes = [
		'.',
		'../../public',
		'../../public/tier0',
		'../../public/tier1',
		'../../common',
		'../'
	] + bld.env.INCLUDES_SDL3 + bld.env.INCLUDES_VULKAN

	defines = []

	libs = ['tier0','tier1','vstdlib','mathlib','bitmap','VULKAN','vulkan_texture_image',
		'vulkan_debug',
		'mapcontainer', 'render_spv', 'render_device']
	if bld.env.KTX_READ_ENABLED:
		libs += ['texturecontainer', 'KTXREAD']
		defines += ['RFC0008_KTX_READER']

	install_path = bld.env.LIBDIR

	bld.shlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		use      = libs,
		install_path = install_path,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)
