#! /usr/bin/env python
# encoding: utf-8
#
# The render core's shader API (--render-backend=core): the material
# system's IShaderAPI, drawing through the render core's device
# (render.device.v2).

top = '.'
PROJECT_NAME = 'shaderapicore'

def options(opt):
	return

def configure(conf):
	conf.env.append_unique('DEFINES', [
		'SHADER_DLL_EXPORT',
		'PROTECTED_THINGS_ENABLE'
	])

def build(bld):
	source = [
		'shaderapicore.cpp',
		'core_renderer.cpp',
		'core_copies.cpp',
		'core_texture.cpp',
		'../../public/tier0/memoverride.cpp'
	]

	includes = [
		'.',
		'../../public',
		'../../public/tier0',
		'../../public/tier1',
		'../../common',
		'../'
	]

	# bitmap before the libraries it uses (a static link resolves left to right).
	libs = ['tier0', 'bitmap', 'tier1', 'tier2', 'mathlib', 'render_device']

	bld.shlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		use      = libs,
		install_path = bld.env.LIBDIR,
		idx      = bld.get_taskgen_count()
	)
