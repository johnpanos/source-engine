; The 3DS shader API's vertex program on render.device.pica (RFC 0026 P5).
; Inputs (pica_renderer.h's vertex record): v0 position (float3), v1 colour
; (4 unsigned bytes, D3DCOLOR order B G R A), v2 texcoord (float2).
; Draw constants from c0: the four column-vector rows of the port's clip
; transform (D3D's), then the tint. Writes PICA clip space (z negated) and
; PVS1's texture coordinates (u, 1 - v).

.fvec mvp[4]
.fvec tint

.constf consts(1.0, 0.00392156862745098, 0.0, 0.0)

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inclr v1
.alias intc0 v2

.proc main
	mov r0.xyz, inpos
	mov r0.w, consts.xxxx

	dp4 r1.x, mvp[0], r0
	dp4 r1.y, mvp[1], r0
	dp4 r1.z, mvp[2], r0
	dp4 r1.w, mvp[3], r0
	mov r1.z, -r1.zzzz
	mov outpos, r1

	; D3DCOLOR bytes are B G R A: swizzle to R G B A and normalize, then tint.
	mul r2, consts.yyyy, inclr.zyxw
	mul outclr, tint, r2

	mov r3, consts.xxxx
	mov r3.x, intc0.xxxx
	add r3.y, consts.xxxx, -intc0.yyyy
	mov outtc0, r3
	end
.end
