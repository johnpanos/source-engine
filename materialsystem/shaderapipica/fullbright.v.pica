; PICA200 vertex shader of the 3DS fullbright shader API.
; Inputs (pica_renderer.cpp's vertex record): v0 position (float3),
; v1 color (4 unsigned bytes, D3DCOLOR order B G R A), v2 texcoord (float2).
; Uniform mvp: the four rows of the column-vector clip transform, already
; converted from D3D clip space to PICA's (tilted screen, depth [-1, 0]).

.fvec mvp[4]
.fvec tint

.constf consts(1.0, 0.00392156862745098, 0.0, 0.0)

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inclr v1
.alias intc0 v2

.proc main
	mov r0.xyz, inpos
	mov r0.w, consts.xxxx

	dp4 outpos.x, mvp[0], r0
	dp4 outpos.y, mvp[1], r0
	dp4 outpos.z, mvp[2], r0
	dp4 outpos.w, mvp[3], r0

	; D3DCOLOR bytes are B G R A: swizzle to R G B A and normalize, then tint.
	mul r1, consts.yyyy, inclr.zyxw
	mul outclr, tint, r1

	mov outtc0, intc0
	end
.end
