#! /usr/bin/env python
# encoding: utf-8
#
# The Nintendo 3DS shader API (DEST_OS 3ds, --render-backend=pica): the
# material system's IShaderAPI, drawing through the render core's PICA200
# device (render.device.pica, RFC 0026 P5). Its vertex program is assembled by
# the device's pica_device_shaders feature (render/device/pica/wscript).

top = '.'
PROJECT_NAME = 'shaderapipica'

def options(opt):
	return

def configure(conf):
	conf.env.append_unique('DEFINES', [
		'SHADER_DLL_EXPORT',
		'PROTECTED_THINGS_ENABLE'
	])

def build(bld):
	source = [
		'shaderapipica.cpp',
		'pica_renderer.cpp',
		'core_copies.cpp',
		'pica_texture.cpp',
		'../../public/tier0/memoverride.cpp'
	]

	includes = [
		'.',
		'../../public',
		'../../public/tier0',
		'../../public/tier1',
		'../../common',
		'../'
	] + bld.env.INCLUDES_SDL2

	# bitmap before the libraries it uses (a static link resolves left to right).
	libs = ['tier0', 'bitmap', 'tier1', 'tier2', 'mathlib', 'render_device']
	# The 3DS's: its formats and presenter are the PICA device's.
	if bld.env.N3DS:
		libs += ['render_device_pica']

	bld.shlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		use      = libs,
		install_path = bld.env.LIBDIR,
		idx      = bld.get_taskgen_count()
	)
