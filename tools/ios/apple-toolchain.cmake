# CMake toolchain for cross-building macOS, iOS and tvOS dependencies on Linux
# with the pinned host toolchain (tools/ios/build_toolchain.py). APPLE_SDK,
# APPLE_TOOLCHAIN, APPLE_DEPLOYMENT_TARGET and APPLE_TARGET_OS (macos, ios or
# tvos) are passed with -D by build-apple-app.sh.
# try_compile projects see these too.
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES
	APPLE_SDK APPLE_TOOLCHAIN APPLE_DEPLOYMENT_TARGET APPLE_TARGET_OS)
if(NOT APPLE_TARGET_OS)
	message(FATAL_ERROR "APPLE_TARGET_OS must be set (macos, ios or tvos)")
endif()
if(APPLE_TARGET_OS STREQUAL "tvos")
	set(CMAKE_SYSTEM_NAME tvOS)
elseif(APPLE_TARGET_OS STREQUAL "ios")
	set(CMAKE_SYSTEM_NAME iOS)
elseif(APPLE_TARGET_OS STREQUAL "macos")
	set(CMAKE_SYSTEM_NAME Darwin)
else()
	message(FATAL_ERROR "APPLE_TARGET_OS must be macos, ios or tvos, not ${APPLE_TARGET_OS}")
endif()
set(APPLE_TRIPLE "arm64-apple-${APPLE_TARGET_OS}${APPLE_DEPLOYMENT_TARGET}")
set(CMAKE_SYSTEM_PROCESSOR arm64)
set(CMAKE_OSX_ARCHITECTURES arm64)
set(CMAKE_OSX_SYSROOT "${APPLE_SDK}")
set(CMAKE_OSX_DEPLOYMENT_TARGET "${APPLE_DEPLOYMENT_TARGET}")
set(CMAKE_C_COMPILER "${APPLE_TOOLCHAIN}/bin/clang")
set(CMAKE_CXX_COMPILER "${APPLE_TOOLCHAIN}/bin/clang++")
set(CMAKE_OBJC_COMPILER "${APPLE_TOOLCHAIN}/bin/clang")
set(CMAKE_ASM_COMPILER "${APPLE_TOOLCHAIN}/bin/clang")
set(CMAKE_C_COMPILER_TARGET "${APPLE_TRIPLE}")
set(CMAKE_CXX_COMPILER_TARGET "${APPLE_TRIPLE}")
set(CMAKE_OBJC_COMPILER_TARGET "${APPLE_TRIPLE}")
set(CMAKE_AR "${APPLE_TOOLCHAIN}/bin/llvm-ar" CACHE FILEPATH "")
set(CMAKE_RANLIB "${APPLE_TOOLCHAIN}/bin/llvm-ranlib" CACHE FILEPATH "")
set(CMAKE_INSTALL_NAME_TOOL "${APPLE_TOOLCHAIN}/bin/llvm-install-name-tool" CACHE FILEPATH "")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_FIND_ROOT_PATH "${APPLE_SDK}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
