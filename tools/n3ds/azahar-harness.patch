+void RendererSoftware::RenderScreenshot() {
+    if (!settings.screenshot_requested.exchange(false)) {
+        return;
+    }
+    // The OpenGL renderer's result: the layout drawn bottom-up as BGRA (glReadPixels
+    // with GL_BGRA, GL_UNSIGNED_INT_8_8_8_8_REV), screens scaled nearest-neighbour.
+    const Layout::FramebufferLayout layout{settings.screenshot_framebuffer_layout};
+    u8* out = static_cast<u8*>(settings.screenshot_bits);
+    std::memset(out, 0, std::size_t(layout.width) * layout.height * 4);
+    const auto blit = [&](const ScreenInfo& info, const Common::Rectangle<u32>& rect) {
+        // screen_infos hold the screen as LoadFBToScreenInfo leaves it: `width`
+        // rows of `height` pixels, i.e. an image `height` wide and `width` tall.
+        const u32 image_w = info.height, image_h = info.width;
+        const u32 rect_w = rect.GetWidth(), rect_h = rect.GetHeight();
+        if (info.pixels.empty() || !image_w || !image_h || !rect_w || !rect_h) {
+            return;
+        }
+        for (u32 ry = 0; ry < rect_h; ++ry) {
+            const u32 oy = rect.top + ry;
+            if (oy >= layout.height) {
+                break;
+            }
+            const u32 sy = ry * image_h / rect_h;
+            u8* row = out + std::size_t(layout.height - 1 - oy) * layout.width * 4;
+            for (u32 rx = 0; rx < rect_w; ++rx) {
+                const u32 ox = rect.left + rx;
+                if (ox >= layout.width) {
+                    break;
+                }
+                const u32 sx = rx * image_w / rect_w;
+                const u8* rgba = info.pixels.data() + (std::size_t(sy) * image_w + sx) * 4;
+                u8* bgra = row + std::size_t(ox) * 4;
+                bgra[0] = rgba[2];
+                bgra[1] = rgba[1];
+                bgra[2] = rgba[0];
+                bgra[3] = 255;
+            }
+        }
+    };
+    if (layout.top_screen_enabled) {
+        blit(screen_infos[0], layout.top_screen);
+    }
+    if (layout.bottom_screen_enabled) {
+        blit(screen_infos[2], layout.bottom_screen);
+    }
+    settings.screenshot_complete_callback(true);
+}
