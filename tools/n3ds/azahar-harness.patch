+// Copyright Citra Emulator Project / Azahar Emulator Project
+// Licensed under GPLv2 or any later version
+// Refer to the license.txt file included.
+
+#include "citra_qt/harness.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <vector>
+#include <future>
+#include <sstream>
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+
+#include "citra_qt/bootmanager.h"
+#include "core/arm/arm_interface.h"
+#include "core/arm/exception_handler.h"
+#include "core/core.h"
+#include "core/core_timing.h"
+#include "core/hle/kernel/kernel.h"
+#include "core/hle/kernel/memory.h"
+#include "core/hle/kernel/process.h"
+#include "core/hle/kernel/thread.h"
+#include "core/memory.h"
+#include "common/logging/backend.h"
+#include "common/logging/filter.h"
+#include "common/settings.h"
+
+namespace {
+
+std::string Hex(u32 value) {
+    char buffer[16];
+    std::snprintf(buffer, sizeof(buffer), "\"%08x\"", value);
+    return buffer;
+}
+
+std::string Escape(const std::string& text) {
+    std::string out;
+    for (char c : text) {
+        if (c == '"' || c == '\\') {
+            out += '\\';
+        }
+        out += (c >= 0x20) ? c : ' ';
+    }
+    return out;
+}
+
+const char* StatusName(Kernel::ThreadStatus status) {
+    switch (status) {
+    case Kernel::ThreadStatus::Running:
+        return "running";
+    case Kernel::ThreadStatus::Ready:
+        return "ready";
+    case Kernel::ThreadStatus::WaitArb:
+        return "wait_arb";
+    case Kernel::ThreadStatus::WaitSleep:
+        return "wait_sleep";
+    case Kernel::ThreadStatus::WaitIPC:
+        return "wait_ipc";
+    case Kernel::ThreadStatus::WaitSynchAny:
+        return "wait_synch_any";
+    case Kernel::ThreadStatus::WaitSynchAll:
+        return "wait_synch_all";
+    case Kernel::ThreadStatus::WaitHleEvent:
+        return "wait_hle_event";
+    case Kernel::ThreadStatus::Dormant:
+        return "dormant";
+    case Kernel::ThreadStatus::Dead:
+        return "dead";
+    }
+    return "unknown";
+}
+
+} // namespace
+
+Harness::Harness(Core::System& system_, std::string socket_path_, EmuThreadGetter emu_thread_,
+                 QuitCallback quit_, ScreenshotCallback screenshot_)
+    : system(system_), socket_path(std::move(socket_path_)), emu_thread(std::move(emu_thread_)),
+      quit(std::move(quit_)), screenshot(std::move(screenshot_)) {
+    listen_fd = socket(AF_UNIX, SOCK_STREAM, 0);
+    sockaddr_un address{};
+    address.sun_family = AF_UNIX;
+    std::snprintf(address.sun_path, sizeof(address.sun_path), "%s", socket_path.c_str());
+    unlink(socket_path.c_str());
+    if (listen_fd < 0 || bind(listen_fd, reinterpret_cast<sockaddr*>(&address), sizeof(address)) != 0 ||
+        listen(listen_fd, 1) != 0) {
+        std::fprintf(stderr, "harness: cannot listen on %s\n", socket_path.c_str());
+        return;
+    }
+    std::fprintf(stderr, "harness: listening on %s\n", socket_path.c_str());
+    // A guest that stops itself (abort, break, fault, exit) is reported with
+    // every thread from the emulation thread, before the process is torn down.
+    Core::SetGuestStopHook([this](const std::string& reason, const std::string& report) {
+        {
+            std::scoped_lock lock{dump_mutex};
+            if (!stop_dump_path.empty()) {
+                DumpMemory(stop_dump_address, stop_dump_length, stop_dump_path);
+            }
+        }
+        PushEvent("{\"event\":\"guest_stop\",\"reason\":\"" + reason + "\",\"report\":\"" +
+                  Escape(report) + "\",\"dump\":" + DumpThreads(2048) + "}");
+    });
+    server = std::thread([this] { Serve(); });
+}
+
+Harness::~Harness() {
+    Core::SetGuestStopHook({});
+    stopping = true;
+    if (listen_fd >= 0) {
+        shutdown(listen_fd, SHUT_RDWR);
+        close(listen_fd);
+    }
+    {
+        std::scoped_lock lock{send_mutex};
+        for (const int fd : client_fds) {
+            shutdown(fd, SHUT_RDWR);
+        }
+    }
+    if (server.joinable()) {
+        server.join();
+    }
+    for (auto& thread : client_threads) {
+        thread.join();
+    }
+    unlink(socket_path.c_str());
+}
+
+// Replies go to the client that asked (one line each); events go to every
+// connected client.
+static void WriteLine(int fd, const std::string& line) {
+    const std::string out = line + "\n";
+    std::size_t sent = 0;
+    while (sent < out.size()) {
+        const ssize_t n = write(fd, out.data() + sent, out.size() - sent);
+        if (n <= 0) {
+            return;
+        }
+        sent += static_cast<std::size_t>(n);
+    }
+}
+
+void Harness::Send(const std::string& line) {
+    std::scoped_lock lock{send_mutex};
+    for (const int fd : client_fds) {
+        WriteLine(fd, line);
+    }
+}
+
+void Harness::PushEvent(const std::string& json) {
+    Send(json);
+}
+
+void Harness::Serve() {
+    while (!stopping) {
+        const int fd = accept(listen_fd, nullptr, nullptr);
+        if (fd < 0) {
+            return;
+        }
+        {
+            std::scoped_lock lock{send_mutex};
+            client_fds.push_back(fd);
+        }
+        client_threads.emplace_back([this, fd] { ServeClient(fd); });
+    }
+}
+
+void Harness::ServeClient(int fd) {
+    std::string pending;
+    char buffer[4096];
+    for (;;) {
+        const ssize_t n = read(fd, buffer, sizeof(buffer));
+        if (n <= 0) {
+            break;
+        }
+        pending.append(buffer, static_cast<std::size_t>(n));
+        std::size_t newline;
+        while ((newline = pending.find('\n')) != std::string::npos) {
+            const std::string line = pending.substr(0, newline);
+            pending.erase(0, newline + 1);
+            const std::string reply = Handle(line);
+            std::scoped_lock lock{send_mutex};
+            WriteLine(fd, reply);
+        }
+    }
+    std::scoped_lock lock{send_mutex};
+    std::erase(client_fds, fd);
+    close(fd);
+}
+
+std::string Harness::RunOnEmuThread(std::function<std::string()> job) {
+    EmuThread* thread = emu_thread();
+    if (!thread) {
+        return "{\"ok\":false,\"error\":\"no emulation running\"}";
+    }
+    auto promise = std::make_shared<std::promise<std::string>>();
+    auto future = promise->get_future();
+    thread->Post([promise, job = std::move(job)] { promise->set_value(job()); });
+    return future.get();
+}
+
+std::string Harness::Handle(const std::string& line) {
+    std::istringstream in(line);
+    std::string command;
+    in >> command;
+    if (command == "ping") {
+        return "{\"ok\":true}";
+    }
+    if (command == "status") {
+        EmuThread* thread = emu_thread();
+        return std::string("{\"ok\":true,\"booted\":") + (thread ? "true" : "false") +
+               ",\"running\":" + (thread && thread->IsRunning() ? "true" : "false") + "}";
+    }
+    if (command == "threads") {
+        int words = 64;
+        in >> words;
+        return RunOnEmuThread([this, words] { return DumpThreads(words); });
+    }
+    if (command == "profile") {
+        std::string action, argument;
+        in >> action >> argument;
+        if (action == "start") {
+            const double us = argument.empty() ? 1000.0 : std::stod(argument);
+            return RunOnEmuThread([this, us] {
+                auto& timing = system.CoreTiming();
+                if (!profile_event) {
+                    profile_event = timing.RegisterEvent(
+                        "HarnessProfile",
+                        [this](std::uintptr_t, int cycles_late) { ProfileSample(cycles_late); });
+                }
+                if (profile_interval) {
+                    timing.RemoveEvent(static_cast<Core::TimingEventType*>(profile_event));
+                }
+                profile_samples.clear();
+                profile_interval = std::max<s64>(
+                    1, static_cast<s64>(us * BASE_CLOCK_RATE_ARM11 / 1'000'000.0));
+                timing.ScheduleEvent(profile_interval,
+                                     static_cast<Core::TimingEventType*>(profile_event), 0, 0);
+                return std::string("{\"ok\":true}");
+            });
+        }
+        if (action == "stop") {
+            const std::string path = argument;
+            return RunOnEmuThread([this, path] {
+                if (profile_interval && profile_event) {
+                    system.CoreTiming().RemoveEvent(
+                        static_cast<Core::TimingEventType*>(profile_event));
+                }
+                profile_interval = 0;
+                FILE* file = std::fopen(path.c_str(), "wb");
+                if (!file) {
+                    return std::string("{\"ok\":false,\"error\":\"cannot open the output\"}");
+                }
+                static_assert(sizeof(ProfileSampleRecord) == 164 * 4);
+                std::fwrite(profile_samples.data(), sizeof(ProfileSampleRecord),
+                            profile_samples.size(), file);
+                std::fclose(file);
+                std::ostringstream out;
+                out << "{\"ok\":true,\"samples\":" << profile_samples.size() << "}";
+                return out.str();
+            });
+        }
+        return "{\"ok\":false,\"error\":\"usage: profile start <us> | profile stop <path>\"}";
+    }
+    if (command == "read") {
+        std::string address_text;
+        unsigned length = 0;
+        in >> address_text >> length;
+        const unsigned address = static_cast<unsigned>(std::stoul(address_text, nullptr, 16));
+        return RunOnEmuThread([this, address, length] { return ReadMemory(address, length); });
+    }
+    if (command == "memory") {
+        return RunOnEmuThread([this] {
+            auto& kernel = system.Kernel();
+            const auto region = kernel.GetMemoryRegion(Kernel::MemoryRegion::APPLICATION);
+            const auto process = kernel.GetCurrentProcess();
+            std::ostringstream out;
+            out << "{\"ok\":true,\"application_size\":" << region->size
+                << ",\"application_used\":" << region->used
+                << ",\"process_used\":" << (process ? process->memory_used : 0) << "}";
+            return out.str();
+        });
+    }
+    if (command == "pause" || command == "resume") {
+        EmuThread* thread = emu_thread();
+        if (!thread) {
+            return "{\"ok\":false,\"error\":\"no emulation running\"}";
+        }
+        thread->SetRunning(command == "resume");
+        return "{\"ok\":true}";
+    }
+    if (command == "dump" || command == "dump_on_stop") {
+        std::string address_text, path;
+        unsigned length = 0;
+        in >> address_text >> length >> path;
+        const unsigned address = static_cast<unsigned>(std::stoul(address_text, nullptr, 16));
+        if (command == "dump_on_stop") {
+            std::scoped_lock lock{dump_mutex};
+            stop_dump_address = address;
+            stop_dump_length = length;
+            stop_dump_path = path;
+            return "{\"ok\":true}";
+        }
+        return RunOnEmuThread(
+            [this, address, length, path] { return DumpMemory(address, length, path); });
+    }
+    if (command == "speed") {
+        // "speed 500" runs at 500 %, "speed 0" unlimited: a temporary limit
+        // for this session; the saved configuration is untouched.
+        double percent = 100;
+        in >> percent;
+        Settings::is_temporary_frame_limit = true;
+        Settings::temporary_frame_limit = percent;
+        return "{\"ok\":true}";
+    }
+    if (command == "log_filter") {
+        // e.g. "log_filter *:Info Service.FS:Debug": change what the emulator
+        // logs while the guest runs.
+        std::string filter;
+        std::getline(in, filter);
+        Common::Log::Filter parsed;
+        parsed.ParseFilterString(filter);
+        Common::Log::SetGlobalFilter(parsed);
+        return "{\"ok\":true}";
+    }
+    if (command == "screenshot") {
+        std::string path;
+        in >> path;
+        if (path.empty() || !emu_thread()) {
+            return "{\"ok\":false,\"error\":\"usage: screenshot <path>, with emulation running\"}";
+        }
+        screenshot(path);
+        return "{\"ok\":true,\"pending\":true}";
+    }
+    if (command == "quit") {
+        quit();
+        return "{\"ok\":true}";
+    }
+    return "{\"ok\":false,\"error\":\"unknown request\"}";
+}
+
+void Harness::ProfileSample(int cycles_late) {
+    if (!profile_interval) {
+        return;
+    }
+    ProfileSampleRecord record;
+    record.ticks = static_cast<u32>(system.GetCore(0).GetTimer().GetTicks());
+    auto& kernel = system.Kernel();
+    const Kernel::Thread* current = kernel.GetThreadManager(0).GetCurrentThread();
+    const auto process = current ? current->owner_process.lock() : nullptr;
+    const Kernel::Thread* sampled = nullptr;
+    Core::ARM_Interface::ThreadContext context{};
+    std::shared_ptr<Kernel::Process> owner;
+    if (current && process && current->status == Kernel::ThreadStatus::Running) {
+        context = current->context;
+        system.GetCore(0).SaveContext(context);
+        sampled = current;
+        owner = process;
+        record.thread = current->GetThreadId();
+    } else {
+        // Core 0 idle: what the application's main thread (its lowest id on
+        // core 0) is blocked in, from its saved context, flagged as waiting
+        // (bit 31 of the thread field).
+        for (const auto& thread : kernel.GetThreadManager(0).GetThreadList()) {
+            auto thread_owner = thread->owner_process.lock();
+            if (!thread_owner || thread->status == Kernel::ThreadStatus::Dead ||
+                thread_owner->codeset->name.empty()) {
+                continue;
+            }
+            if (!sampled || thread->GetThreadId() < sampled->GetThreadId()) {
+                sampled = thread.get();
+                owner = thread_owner;
+            }
+        }
+        if (sampled) {
+            context = sampled->context;
+            record.thread = sampled->GetThreadId() | 0x80000000u;
+        }
+    }
+    if (sampled && owner) {
+        const auto& process_ref = owner;
+        record.pc = context.cpu_registers[15];
+        record.lr = context.cpu_registers[14];
+        const u32 sp = context.GetStackPointer();
+        for (u32 i = 0; i < 160; ++i) {
+            const u32 address = sp + i * 4;
+            if (!system.Memory().IsValidVirtualAddress(*process_ref, address)) {
+                break;
+            }
+            record.stack[i] = system.Memory().Read32(*process_ref, address);
+        }
+    }
+    if (profile_samples.size() < 2'000'000) {
+        profile_samples.push_back(record);
+    }
+    system.CoreTiming().ScheduleEvent(std::max<s64>(1, profile_interval - cycles_late),
+                                      static_cast<Core::TimingEventType*>(profile_event), 0, 0);
+}
+
+std::string Harness::DumpThreads(int stack_words) {
+    std::ostringstream out;
+    out << "{\"ok\":true,\"threads\":[";
+    bool first = true;
+    auto& kernel = system.Kernel();
+    for (u32 core = 0; core < system.GetNumCores(); ++core) {
+        auto& manager = kernel.GetThreadManager(core);
+        const Kernel::Thread* current = manager.GetCurrentThread();
+        for (const auto& thread : manager.GetThreadList()) {
+            Core::ARM_Interface::ThreadContext context = thread->context;
+            if (thread.get() == current) {
+                system.GetCore(core).SaveContext(context);
+            }
+            const auto process = thread->owner_process.lock();
+            out << (first ? "" : ",") << "{\"id\":" << thread->GetThreadId() << ",\"core\":" << core
+                << ",\"name\":\"" << Escape(thread->GetName()) << "\",\"process\":\""
+                << (process ? Escape(process->codeset->name) : std::string()) << "\",\"status\":\""
+                << StatusName(thread->status) << "\",\"current\":"
+                << (thread.get() == current ? "true" : "false") << ",\"regs\":[";
+            for (int i = 0; i < 16; ++i) {
+                out << (i ? "," : "") << Hex(context.cpu_registers[i]);
+            }
+            out << "],\"cpsr\":" << Hex(context.cpsr) << ",\"stack\":[";
+            const u32 sp = context.GetStackPointer();
+            for (int i = 0; process && i < stack_words; ++i) {
+                const u32 address = sp + static_cast<u32>(i) * 4;
+                if (!system.Memory().IsValidVirtualAddress(*process, address)) {
+                    break;
+                }
+                out << (i ? "," : "") << Hex(system.Memory().Read32(*process, address));
+            }
+            out << "]}";
+            first = false;
+        }
+    }
+    out << "]}";
+    return out.str();
+}
+
+std::string Harness::DumpMemory(unsigned address, unsigned length, const std::string& path) {
+    const auto process = system.Kernel().GetCurrentProcess();
+    FILE* file = std::fopen(path.c_str(), "wb");
+    if (!process || !file) {
+        if (file) {
+            std::fclose(file);
+        }
+        return "{\"ok\":false,\"error\":\"no process or cannot open the output\"}";
+    }
+    // Unmapped pages are written as zeros, so offsets in the file stay addresses.
+    std::vector<u8> page(4096);
+    for (unsigned offset = 0; offset < length; offset += 4096) {
+        const unsigned size = std::min<unsigned>(4096, length - offset);
+        if (system.Memory().IsValidVirtualAddress(*process, address + offset)) {
+            system.Memory().ReadBlock(*process, address + offset, page.data(), size);
+        } else {
+            std::fill(page.begin(), page.end(), 0);
+        }
+        std::fwrite(page.data(), 1, size, file);
+    }
+    std::fclose(file);
+    return "{\"ok\":true}";
+}
+
+std::string Harness::ReadMemory(unsigned address, unsigned length) {
+    const auto process = system.Kernel().GetCurrentProcess();
+    if (!process || length > 65536) {
+        return "{\"ok\":false,\"error\":\"no process or length too large\"}";
+    }
+    std::ostringstream out;
+    out << "{\"ok\":true,\"address\":" << Hex(address) << ",\"bytes\":\"";
+    for (unsigned i = 0; i < length; ++i) {
+        if (!system.Memory().IsValidVirtualAddress(*process, address + i)) {
+            break;
+        }
+        char byte[3];
+        std::snprintf(byte, sizeof(byte), "%02x", system.Memory().Read8(address + i));
+        out << byte;
+    }
+    out << "\"}";
+    return out.str();
+}
