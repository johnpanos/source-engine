+
+#pragma once
+
+#include <atomic>
+#include <functional>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "common/common_types.h"
+
+namespace Core {
+class System;
+}
+class EmuThread;
+
+/**
+ * A scripting harness for debugging guest applications: a line protocol on a
+ * UNIX socket (--harness <path>). Each request is one line, each reply one
+ * JSON line; events (emulation errors, shutdown) are pushed as JSON lines
+ * with an "event" key to the connected client.
+ *
+ * Requests:
+ *   ping                  -> {"ok":true}
+ *   status                -> running/paused, booted
+ *   threads [words]       -> every guest thread: id, name, process, core,
+ *                            status, r0-r15, cpsr, and `words` stack words
+ *                            (default 64); read on the emulation thread
+ *   read <hexaddr> <len>  -> bytes of the current process's memory (hex)
+ *   screenshot <path>     -> the next frame (both screens) as a PNG
+ *   pause | resume        -> stop or continue the emulation thread
+ *   quit                  -> close the emulator
+ *   profile start <us>    -> sample core 0 every <us> microseconds of
+ *                            emulated time: the running thread's id, pc, lr
+ *                            and 160 stack words, or idle (a guest-time
+ *                            profile: no request per sample, no host bias)
+ *   profile stop <path>   -> stop and write the samples: records of 164
+ *                            little-endian u32 (thread, pc, lr, the low
+ *                            32 bits of core 0's system tick, 160 stack
+ *                            words); with core 0 idle, the application's
+ *                            main thread as it waits, its id | 1 << 31
+ *                            (0 when there is none)
+ */
+class Harness {
+public:
+    using EmuThreadGetter = std::function<EmuThread*()>;
+    using QuitCallback = std::function<void()>;
+    using ScreenshotCallback = std::function<void(const std::string& path)>;
+
+    Harness(Core::System& system, std::string socket_path, EmuThreadGetter emu_thread,
+            QuitCallback quit, ScreenshotCallback screenshot);
+    ~Harness();
+
+    /// Pushes an event line to the connected client (thread-safe).
+    void PushEvent(const std::string& json);
+
+private:
+    void Serve();
+    void ServeClient(int fd);
+    std::string Handle(const std::string& line);
+    std::string RunOnEmuThread(std::function<std::string()> job);
+    std::string DumpThreads(int stack_words);
+    void ProfileSample(int cycles_late);
+    // The guest-time profiler ("profile"): touched only on the emulation thread.
+    struct ProfileSampleRecord {
+        u32 thread = 0; // 0: core 0 idle
+        u32 pc = 0;
+        u32 lr = 0;
+        u32 ticks = 0; // core 0's timer (the guest's svcGetSystemTick), low bits
+        u32 stack[160] = {};
+    };
+    std::vector<ProfileSampleRecord> profile_samples;
+    s64 profile_interval = 0; // in ARM11 cycles; 0 = stopped
+    void* profile_event = nullptr;
+    std::string ReadMemory(unsigned address, unsigned length);
+    std::string DumpMemory(unsigned address, unsigned length, const std::string& path);
+    // Set by "dump_on_stop": the region the guest-stop hook writes to a file.
+    std::mutex dump_mutex;
+    unsigned stop_dump_address = 0;
+    unsigned stop_dump_length = 0;
+    std::string stop_dump_path;
+    void Send(const std::string& line);
+
+    Core::System& system;
+    std::string socket_path;
+    EmuThreadGetter emu_thread;
+    QuitCallback quit;
+    ScreenshotCallback screenshot;
+    int listen_fd = -1;
+    std::vector<int> client_fds;
+    std::vector<std::thread> client_threads;
+    std::mutex send_mutex;
+    std::atomic<bool> stopping{false};
+    std::thread server;
+};
