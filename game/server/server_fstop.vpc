//-----------------------------------------------------------------------------
//	SERVER_FSTOP.VPC
//
//	F-Stop: the Portal 1 server (server_portal.vpc) plus Valve's F-Stop
//	prototype sources in game\server\fstop. Waf lists it after
//	server_base.vpc and server_portal.vpc (game/server/wscript).
//
//	Not built: npc_companionbot, npc_medicbot and npc_obot speak through a
//	concept-handle manager (g_pConceptManager) and response-system follow-ups
//	(EOZ_Hacks::ResponseFollowup) that no available source drop contains.
//
//	The blob NPCs (npc_surface, npc_fountain, npc_demomonster) keep their
//	particles in VPhysics; the neighbour search Valve's blobulator physics
//	library supplied is the clean-room PhysTiler
//	(public/blobulator/physics, game/shared/blobulator/PhysTiler.cpp).
//-----------------------------------------------------------------------------

$Macro SRCDIR		"..\.."
$Macro GAMENAME 	"fstop"

$Configuration
{
	$Compiler
	{
		$AdditionalIncludeDirectories	"$BASE;.\fstop;$SRCDIR\game\shared\fstop"
		$PreprocessorDefinitions		"$BASE;FSTOP"
	}
}

$Project "Server (F-Stop)"
{
	$Folder	"Source Files"
	{
		$Folder	"F-Stop"
		{
			$File	"fstop\addon_basecombatweapon.cpp"
			$File	"fstop\addon_baseshooter.cpp"
			$File	"fstop\addon_baseshooter.h"
			$File	"fstop\addon_bomb.cpp"
