			$File	"fstop\addon_rpg.cpp"
			$File	"fstop\addon_saw.cpp"
			$File	"fstop\addon_shield.cpp"
			$File	"fstop\addon_thrownprojectile.cpp"
			$File	"fstop\ai_addon.cpp"
