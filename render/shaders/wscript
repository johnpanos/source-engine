#! /usr/bin/env python
# encoding: utf-8
# RFC 0016 K4 "Shader artifacts": every GLSL source the native backend ships
# becomes one artifact per target format (SPIR-V, GLSL 4.50), built here with
# the pinned host tools and checked against layouts.json by
# tools/render/shader_artifacts.py. Products build artifacts at build time;
# nothing compiles shaders at run time. The generated headers written beside
# the index are what the backend includes once the committed *_spv.h headers
# are deleted (the switch-over after K1).

import os
import subprocess
import sys

top = '.'

SHADERS = 'materialsystem/shaderapivulkan/shaders'
GENERATED_HEADERS = ('material_spv.h', 'material_spv_index.h', 'legacy_spv.h')

def options(opt):
	return

def pinned_tools(root):
	'''The pinned host tools the task runs, or the first one missing.'''
	sys.path.insert(0, os.path.join(root, 'tools', 'render'))
	try:
		import shader_toolchain
		for resolve in (shader_toolchain.glslc, shader_toolchain.spirv_cross,
				shader_toolchain.glslang_validator):
			resolve()
	except Exception as error:
		return str(error)
	finally:
		sys.path.pop(0)
	return None

def configure(conf):
	mode = getattr(conf.options, 'SHADER_ARTIFACTS', 'auto')
	conf.env.RENDER_SHADER_ARTIFACTS = False
	if mode == 'off':
		conf.msg('Shader artifacts', 'off (--shader-artifacts=off)', color='YELLOW')
		return
	problem = pinned_tools(conf.srcnode.abspath())
	if problem:
		if mode == 'on':
			conf.fatal('--shader-artifacts=on: %s' % problem)
		conf.msg('Shader artifacts', 'not built: %s' % problem.splitlines()[0][:120],
			color='YELLOW')
		return
	conf.env.RENDER_SHADER_ARTIFACTS = True
	conf.msg('Shader artifacts', 'SPIR-V and GLSL 4.50 with the pinned tools')

def build(bld):
	if not bld.env.RENDER_SHADER_ARTIFACTS:
		return
	root = bld.srcnode
	inputs = [root.find_node('tools/render/shader_artifacts.py'),
		root.find_node('tools/render/shader_toolchain.py'),
		root.find_node('quality/toolchain/shader-compiler.json'),
		bld.path.find_node('layouts.json')]
	inputs += root.ant_glob(SHADERS + '/**/*.vert ' + SHADERS + '/**/*.frag ' +
		SHADERS + '/**/*.comp ' + SHADERS + '/**/*.glsl ' + SHADERS + '/regen_*.py')
	index = bld.path.find_or_declare('artifacts/index.json')
	headers = [bld.path.find_or_declare('generated/' + name) for name in GENERATED_HEADERS]

	def build_artifacts(task):
		return subprocess.run([sys.executable, task.inputs[0].abspath(), 'build',
			'--out', task.outputs[0].parent.abspath(),
			'--headers', task.outputs[1].parent.abspath()],
			cwd=root.abspath()).returncode

	# The tool is the source; every other input is a dependency, so a change to
	# any GLSL, include, layout or pin rebuilds the artifacts.
	bld(rule=build_artifacts, source=inputs[:1], deps=inputs[1:], target=[index] + headers,
		name='render_shader_artifacts', color='CYAN', idx=bld.get_taskgen_count())
