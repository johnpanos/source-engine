#! /usr/bin/env python
# encoding: utf-8
# render.shader-library (RFC 0016); edges in architecture/modules.json.

def build(bld):
	bld.stlib(
		env         = bld.strict_cpp20_env(),
		features    = 'cxx capability_strict',
		arch_module = 'render.shader-library',
		target      = 'render_shaderlib',
		name        = 'render_shaderlib',
		source      = bld.path.ant_glob('*.cpp'),
		includes    = ['../../public'],
		use         = ['render_device', 'render_spv'],
		idx         = bld.get_taskgen_count()
	)
