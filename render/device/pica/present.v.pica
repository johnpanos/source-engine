; render.device.pica's top-screen presenter (RFC 0026 P4): one textured
; quad onto the screen's framebuffer. v0 is the corner's clip xy in the
; framebuffer (the screen turned a quarter, as the device lays the corners
; out), v1 its texture coordinate (PVS1's (u, 1 - v)).

.constf k(1.0, -0.5, 0.0, 0.0)

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias corner v0
.alias uv v1

.proc main
	mov r0.xy, corner.xyyy
	mov r0.z, k.yyyy
	mov r0.w, k.xxxx
	mov outpos, r0
	mov outtc0, uv
	mov outclr, k.xxxx
	end
.end
