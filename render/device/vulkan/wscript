#! /usr/bin/env python
# encoding: utf-8
# render.device.vulkan (RFC 0016 adapter): render.device.v2 over Vulkan. The
# only render target that sees Vulkan; its public header is a factory. It
# allocates through the pinned Vulkan Memory Allocator
# (quality/toolchain/vulkan-memory-allocator.json), verified here on every
# build and unpacked from the pinned archive when absent.

import os
import sys

def vma_include(bld):
	root = bld.path.find_node('../../..').abspath()
	sys.path.insert(0, os.path.join(root, 'tools', 'render'))
	try:
		import vma_pin
	finally:
		sys.path.pop(0)
	pin = vma_pin.load_pin()
	problems = vma_pin.verify(pin)
	if problems and all('is missing' in problem for problem in problems):
		vma_pin.fetch(pin)
		problems = vma_pin.verify(pin)
	if problems:
		bld.fatal('render.device.vulkan: the Vulkan Memory Allocator does not match its pin: ' +
			'; '.join(problems))
	return str(vma_pin.include_directory(pin))

def build(bld):
	fsr_flags = []
	fsr_use = []
	if bld.env.RENDER_FSR411:
		root = bld.srcnode.abspath()
		import subprocess
		for path in ('external/fsr411', 'external/fsr-vulkan-headers'):
			pin = subprocess.check_output(['git', 'ls-tree', 'HEAD', path], cwd=root, text=True)
			# New gitlinks are staged until this implementation is committed.
			if not pin:
				pin = subprocess.check_output(['git', 'ls-files', '-s', path], cwd=root, text=True)
			wanted = pin.split()[2 if pin.startswith('160000 commit') else 1]
			actual = subprocess.check_output(['git', '-C', os.path.join(root, path), 'rev-parse', 'HEAD'], text=True).strip()
			dirty = subprocess.check_output(['git', '-C', os.path.join(root, path), 'status', '--porcelain', '--untracked-files=no'], text=True).strip()
			if actual != wanted or dirty:
				bld.fatal(path + ': dependency does not match its gitlink')
		fsr_flags = ['-DRENDER_FSR411', '-isystem', os.path.join(root, 'external/fsr411/src'),
			'-isystem', os.path.join(root, 'external/fsr-vulkan-headers/include')]
		bld.stlib(env=bld.strict_cpp20_env(), features='cxx', arch_module='external.fsr411',
			name='fsr411_runtime', target='fsr411_runtime',
			source=['../../../external/fsr411/src/fsr411.cpp'], includes=[],
			cxxflags=fsr_flags + ['-w'], use=['VULKAN'], idx=bld.get_taskgen_count())
		fsr_use = ['fsr411_runtime']
	bld.stlib(
		env         = bld.strict_cpp20_env(),
		features    = 'cxx capability_strict',
		arch_module = 'render.device.vulkan',
		target      = 'render_device_vulkan',
		name        = 'render_device_vulkan',
		source      = bld.path.ant_glob('*.cpp'),
		includes    = ['../../../public'],
		# The allocator is a pinned third-party header: a system include, so
		# the strict warnings apply to the adapter and not to it.
		cxxflags    = ['-isystem', vma_include(bld)] + fsr_flags,
		use         = ['render_device', 'VULKAN'] + fsr_use,
		idx         = bld.get_taskgen_count()
	)
