#! /usr/bin/env python
# encoding: utf-8
# render.device.d3d12 (RFC 0024 adapter): render.device.v2 over Direct3D 12, on
# Windows products. The only render target that sees D3D12, DXGI, DXC or COM;
# its public header is a factory. It imports the pinned DXC (dxcompiler.dll),
# installed beside the executable, and links d3d12, dxgi and dxguid.

def build(bld):
	bld.stlib(
		env         = bld.strict_cpp20_env(),
		features    = 'cxx capability_strict',
		arch_module = 'render.device.d3d12',
		target      = 'render_device_d3d12',
		name        = 'render_device_d3d12',
		source      = bld.path.ant_glob('*.cpp'),
		includes    = ['../../../public'],
		use         = ['render_device', 'D3D12'],
		idx         = bld.get_taskgen_count()
	)
