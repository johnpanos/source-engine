#! /usr/bin/env python
# encoding: utf-8
# render.device.metal (RFC 0025 adapter): render.device.v2 over Metal 3, on
# Apple products. The only render target that sees Metal or Objective-C; its
# public header is a factory. Objective-C++ with ARC.

def build(bld):
	bld.stlib(
		env         = bld.strict_cpp20_env(),
		features    = 'cxx capability_strict',
		arch_module = 'render.device.metal',
		target      = 'render_device_metal',
		name        = 'render_device_metal',
		source      = bld.path.ant_glob('*.mm'),
		includes    = ['../../../public'],
		cxxflags    = ['-fobjc-arc', '-x', 'objective-c++'],
		use         = ['render_device', 'METAL'],
		idx         = bld.get_taskgen_count()
	)
