; The reduced 3DS material model's vertex skinning (RFC 0026 decision 8):
; three bones per vertex from a 19-bone palette, linked after model_lighting
; so the palette is c35-c91 (3 rows of bone-to-world each, row-major). The
; vertex: v0 the position and v1 the normal in bone space, v4.xy two weights
; (the third is 1 - x - y), v5.xyz three palette offsets (bone index x 3);
; the CPU path's rule (render/composition: CoreMeshDraw::bonePalette).
; Out: r0 the world position (w 1), r4 the world normal (w 0, not
; normalized). Uses r5, r12-r15.

.fvec bones[57]

.constf ks(1.0, 0.0, 0.0, 0.0)

.proc skin
	mov r12.xyz, v0
	mov r12.w, ks.xxxx
	mov r13.xyz, v1
	mov r13.w, ks.yyyy
	; weights: r5 = (w0, w1, 1 - w0 - w1)
	mov r5.xy, v4.xyyy
	add r5.z, ks.xxxx, -v4.xxxx
	add r5.z, r5.zzzz, -v4.yyyy
	mov r0, ks.yyyy
	mov r4, ks.yyyy
	; bone 0
	mova a0.x, v5.xxxx
	dp4 r14.x, bones[a0.x], r12
	dp4 r14.y, bones[a0.x+1], r12
	dp4 r14.z, bones[a0.x+2], r12
	dp4 r15.x, bones[a0.x], r13
	dp4 r15.y, bones[a0.x+1], r13
	dp4 r15.z, bones[a0.x+2], r13
	mad r0.xyz, r14, r5.xxxx, r0
	mad r4.xyz, r15, r5.xxxx, r4
	; bone 1
	mova a0.x, v5.yyyy
	dp4 r14.x, bones[a0.x], r12
	dp4 r14.y, bones[a0.x+1], r12
	dp4 r14.z, bones[a0.x+2], r12
	dp4 r15.x, bones[a0.x], r13
	dp4 r15.y, bones[a0.x+1], r13
	dp4 r15.z, bones[a0.x+2], r13
	mad r0.xyz, r14, r5.yyyy, r0
	mad r4.xyz, r15, r5.yyyy, r4
	; bone 2
	mova a0.x, v5.zzzz
	dp4 r14.x, bones[a0.x], r12
	dp4 r14.y, bones[a0.x+1], r12
	dp4 r14.z, bones[a0.x+2], r12
	dp4 r15.x, bones[a0.x], r13
	dp4 r15.y, bones[a0.x+1], r13
	dp4 r15.z, bones[a0.x+2], r13
	mad r0.xyz, r14, r5.zzzz, r0
	mad r4.xyz, r15, r5.zzzz, r4
	mov r0.w, ks.xxxx
	mov r4.w, ks.yyyy
.end
