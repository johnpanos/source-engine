; The reduced 3DS material model's rigid `skin` procedure (RFC 0026): the
; palette's first bone (c35-c37, as skin.pica's palette) transforms v0 (the
; position) and v1 (the normal). Out: r0 the world position (w 1), r4 the
; world normal (w 0, not normalized). Uses r12, r13.

.fvec bones[57]

.constf ks(1.0, 0.0, 0.0, 0.0)

.proc skin
	mov r12.xyz, v0
	mov r12.w, ks.xxxx
	mov r13.xyz, v1
	mov r13.w, ks.yyyy
	dp4 r0.x, bones[0], r12
	dp4 r0.y, bones[1], r12
	dp4 r0.z, bones[2], r12
	mov r0.w, ks.xxxx
	dp4 r4.x, bones[0], r13
	dp4 r4.y, bones[1], r13
	dp4 r4.z, bones[2], r13
	mov r4.w, ks.yyyy
.end
