; The reduced 3DS material model's flat and world vertex (RFC 0026 decision
; 8, render/material/surface_reduced.h): SurfaceFlatVertex's position, uv,
; lightmap uv and colour (a world vertex's other attributes are not read).
; c0-c3: the draw's world-to-clip rows (FamilyDrawConstants); c4-c5: the
; material's tint and flags (SurfaceConstants; flags.x is $vertexcolor).
; Writes PICA clip space (z negated) and PVS1's texture coordinates (u, 1 - v).

.fvec toClip[4]
.fvec material[2]

.constf k(1.0, 0.00392156862745098, 0.0, 0.0)

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1

.alias inpos v0
.alias inuv v1
.alias inlightmap v2
.alias incolor v3

.proc main
	mov r0.xyz, inpos
	mov r0.w, k.xxxx
	dp4 r1.x, toClip[0], r0
	dp4 r1.y, toClip[1], r0
	dp4 r1.z, toClip[2], r0
	dp4 r1.w, toClip[3], r0
	mov r1.z, -r1.zzzz
	mov outpos, r1

	mov r2, k.xxxx
	mov r2.x, inuv.xxxx
	add r2.y, k.xxxx, -inuv.yyyy
	mov outtc0, r2
	mov r3, k.xxxx
	mov r3.x, inlightmap.xxxx
	add r3.y, k.xxxx, -inlightmap.yyyy
	mov outtc1, r3

	; 1 + $vertexcolor x (colour / 255 - 1)
	mul r4, k.yyyy, incolor
	add r4, -k.xxxx, r4
	mov r5, material[1]
	mul r4, r5.xxxx, r4
	add outclr, k.xxxx, r4
	end
.end
