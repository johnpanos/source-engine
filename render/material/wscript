#! /usr/bin/env python
# encoding: utf-8
# render.material (RFC 0016); edges in architecture/modules.json. On the 3DS
# it also holds the reduced material model's vertex programs (RFC 0026
# decision 8, families/pica/), assembled by picasso through the
# pica_device_shaders feature (render/device/pica/wscript, built first).

def build(bld):
	features = 'c cxx capability_strict'
	programs = []
	if bld.env.N3DS:
		features += ' pica_device_shaders'
		# '+' links files into one program (render/device/pica/wscript): the
		# model lighting has one copy, model_lighting.pica.
		lighting = '+families/pica/model_lighting.pica'
		bones = '+families/pica/lit_bones_main.pica'
		programs = ['families/pica/surface_flat.v.pica', 'families/pica/surface_static.v.pica',
			'families/pica/surface_model.v.pica' + lighting,
			'families/pica/surface_lit.v.pica' + lighting,
			'families/pica/surface_lit_skinned.v.pica' + bones + lighting + '+families/pica/skin.pica',
			'families/pica/surface_lit_rigid.v.pica' + bones + lighting +
			'+families/pica/skin_rigid.pica']
	bld.stlib(
		env         = bld.strict_cpp20_env(),
		features    = features,
		arch_module = 'render.material',
		target      = 'render_material',
		name        = 'render_material',
		source      = bld.path.ant_glob('*.cpp'),
		pica_programs = programs,
		includes    = ['../../public'],
		use         = ['render_device', 'render_resources', 'render_shaderlib', 'kvtext', 'render_spv'],
		idx         = bld.get_taskgen_count()
	)
