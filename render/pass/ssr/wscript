#! /usr/bin/env python
# encoding: utf-8
# render.pass.ssr (RFC 0016 layer 6 feature, render.ssr.v1): screen-space
# reflections traced in the current frame's lit colour over the image-based
# specular.

def build(bld):
	bld.stlib(
		env         = bld.strict_cpp20_env(),
		features    = 'cxx capability_strict',
		arch_module = 'render.pass.ssr',
		target      = 'render_pass_ssr',
		name        = 'render_pass_ssr',
		source      = bld.path.ant_glob('*.cpp'),
		includes    = ['../../../public'],
		use         = ['render_graph', 'render_device', 'render_shaderlib', 'render_spv'],
		idx         = bld.get_taskgen_count()
	)
