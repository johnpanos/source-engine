#! /usr/bin/env python
# encoding: utf-8
# render.pass.luminance (RFC 0016 layer 6 feature, K8 post cohort): the
# luminance counts behind auto exposure.

def build(bld):
	bld.stlib(
		env         = bld.strict_cpp20_env(),
		features    = 'cxx capability_strict',
		arch_module = 'render.pass.luminance',
		target      = 'render_pass_luminance',
		name        = 'render_pass_luminance',
		source      = bld.path.ant_glob('*.cpp'),
		includes    = ['../../../public'],
		use         = ['render_device', 'render_shaderlib', 'render_spv'],
		idx         = bld.get_taskgen_count()
	)
