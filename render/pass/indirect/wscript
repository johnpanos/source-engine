#! /usr/bin/env python
# encoding: utf-8
# render.pass.indirect (RFC 0016 layer 6 feature, render.lighting.v1 indirect
# diffuse): the indirect-light producers' GPU work (RFC 0011's SDF producer)
# on the core's device port.

def build(bld):
	bld.stlib(
		env         = bld.strict_cpp20_env(),
		features    = 'cxx capability_strict',
		arch_module = 'render.pass.indirect',
		target      = 'render_pass_indirect',
		name        = 'render_pass_indirect',
		source      = bld.path.ant_glob('*.cpp'),
		includes    = ['../../../public'],
		use         = ['render_device', 'render_shaderlib', 'render_spv'],
		idx         = bld.get_taskgen_count()
	)
