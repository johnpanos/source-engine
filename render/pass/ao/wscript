#! /usr/bin/env python
# encoding: utf-8
# render.pass.ao (RFC 0016 layer 6 feature, render.lighting.v1 "Ambient
# occlusion"): ground-truth ambient occlusion from depth and normals.

def build(bld):
	bld.stlib(
		env         = bld.strict_cpp20_env(),
		features    = 'cxx capability_strict',
		arch_module = 'render.pass.ao',
		target      = 'render_pass_ao',
		name        = 'render_pass_ao',
		source      = bld.path.ant_glob('*.cpp'),
		includes    = ['../../../public'],
		use         = ['render_device', 'render_math', 'render_shaderlib', 'render_spv'],
		idx         = bld.get_taskgen_count()
	)
