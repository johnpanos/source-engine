// render.pass.bounce (public/render/pass/bounce/bounce.h): the projected
// lights' one bounce into an atlas of the probe volume's layout. Mode 0
// clears the atlas; mode 1 turns a projector's reflective shadow map into
// patch lights; mode 2 gathers them into every probe texel of layer 0,
// adding to what earlier projectors left. SEEDED_* build the defective
// programs render.lab.bounce's sensitivity row must reject.
#version 450

layout( local_size_x = 64, local_size_y = 1 ) in;

#include "../../shaders/common/projected_light.glsl"

layout( set = 3, binding = 0, std140 ) uniform BounceParams
{
	ProjectedLight projector;
	layout( row_major ) mat4 fromClip;  // the map's clip to world
	uvec4 sizes;    // map size, grid index, probes in the grid (at most), 0
	vec4 frustum;   // tan half horizontal, tan half vertical, 0, 0
}
params;

layout( set = 3, binding = 1 ) uniform texture2D probeAtlas;
layout( set = 3, binding = 2 ) uniform sampler probeAtlasSampler;
layout( set = 3, binding = 3 ) uniform texture2D probeGrids;
layout( set = 3, binding = 4 ) uniform sampler probeGridsSampler;
layout( set = 3, binding = 5 ) uniform texture2D mapAlbedo;
layout( set = 3, binding = 6 ) uniform texture2D mapDepth;
layout( set = 3, binding = 7 ) uniform texture2DArray cookies;
layout( std430, set = 3, binding = 8 ) buffer Patches
{
	vec4 patches[]; // per texel: position (w: 1 when lit), normal, power
};
layout( set = 3, binding = 9, rgba16f ) uniform image2D bounceAtlas;

layout( push_constant ) uniform Step
{
	uvec4 mode;
}
step;

#include "../../shaders/common/probe_volume.glsl"

const float kPi = 3.14159265358979;

vec3 MapWorld( ivec2 texel, float depth )
{
	const float size = float( params.sizes.x );
	const vec2 ndc = vec2( ( float( texel.x ) + 0.5 ) / size * 2.0 - 1.0,
	    1.0 - ( float( texel.y ) + 0.5 ) / size * 2.0 );
	const vec4 h = params.fromClip * vec4( ndc, depth, 1.0 );
	return h.xyz / h.w;
}

void Patch()
{
	const uint size = params.sizes.x;
	const uint index = gl_GlobalInvocationID.x;
	if ( index >= size * size )
		return;
	const ivec2 texel = ivec2( int( index % size ), int( index / size ) );
	patches[index * 3u] = vec4( 0.0 );
	patches[index * 3u + 1u] = vec4( 0.0 );
	patches[index * 3u + 2u] = vec4( 0.0 );
	const float depth = texelFetch( sampler2D( mapDepth, probeGridsSampler ), texel, 0 ).r;
	if ( depth >= 1.0 )
		return;
	const vec3 position = MapWorld( texel, depth );
	// The normal from the neighbouring depths (the nearer difference each way).
	const ivec2 last = ivec2( int( size ) - 1 );
	const ivec2 xp = min( texel + ivec2( 1, 0 ), last ), xn = max( texel - ivec2( 1, 0 ), ivec2( 0 ) );
	const ivec2 yp = min( texel + ivec2( 0, 1 ), last ), yn = max( texel - ivec2( 0, 1 ), ivec2( 0 ) );
	const vec3 px = MapWorld( xp, texelFetch( sampler2D( mapDepth, probeGridsSampler ), xp, 0 ).r );
	const vec3 nx = MapWorld( xn, texelFetch( sampler2D( mapDepth, probeGridsSampler ), xn, 0 ).r );
	const vec3 py = MapWorld( yp, texelFetch( sampler2D( mapDepth, probeGridsSampler ), yp, 0 ).r );
	const vec3 ny = MapWorld( yn, texelFetch( sampler2D( mapDepth, probeGridsSampler ), yn, 0 ).r );
	const vec3 dx = length( px - position ) < length( position - nx ) ? px - position : position - nx;
	const vec3 dy = length( py - position ) < length( position - ny ) ? py - position : position - ny;
	vec3 normal = cross( dx, dy );
	if ( dot( normal, normal ) < 1e-20 )
		return;
	normal = normalize( normal );
	const vec3 toProjector = params.projector.origin.xyz - position;
	if ( dot( normal, toProjector ) < 0.0 )
		normal = -normal;
	vec2 cookieUv;
	float distance;
	if ( !ProjectorProject( params.projector, position, cookieUv, distance ) )
		return;
	const float atten = ProjectorAttenuation( params.projector, distance );
	const vec3 cookie = textureLod( sampler2DArray( cookies, probeAtlasSampler ),
	    vec3( cookieUv, params.projector.origin.w ), 0.0 )
	                        .rgb;
	const vec3 albedo = texelFetch( sampler2D( mapAlbedo, probeGridsSampler ), texel, 0 ).rgb;
	// The texel's solid angle through the frustum.
	const float s = float( size );
	const vec2 ndc = vec2( ( float( texel.x ) + 0.5 ) / s * 2.0 - 1.0,
	    ( float( texel.y ) + 0.5 ) / s * 2.0 - 1.0 );
	const vec2 t = params.frustum.xy;
	const float r2 = 1.0 + ndc.x * ndc.x * t.x * t.x + ndc.y * ndc.y * t.y * t.y;
#ifdef SEEDED_BOUNCE_FLAT_SOLID_ANGLE
	const float solidAngle = ( 2.0 * t.x / s ) * ( 2.0 * t.y / s );
#else
	const float solidAngle = ( 2.0 * t.x / s ) * ( 2.0 * t.y / s ) / ( r2 * sqrt( r2 ) );
#endif
	const vec3 power =
	    albedo * params.projector.color.rgb * cookie * atten * solidAngle * distance * distance;
	patches[index * 3u] = vec4( position, 1.0 );
	patches[index * 3u + 1u] = vec4( normal, 0.0 );
	patches[index * 3u + 2u] = vec4( power, 0.0 );
}

// The direction of texel ( x, y ) of an octahedral tile of `n` + 2 texels:
// the interior's texel centre, a border texel its interior twin's
// (probe_volume.py with_border).
vec3 TileDirection( int x, int y, int n )
{
	int ix = x - 1;
	int iy = y - 1;
	if ( y == 0 || y == n + 1 )
	{
		iy = y == 0 ? 0 : n - 1;
		ix = x == 0 ? n - 1 : ( x == n + 1 ? 0 : n - x );
		if ( x == 0 || x == n + 1 )
			iy = y == 0 ? n - 1 : 0;
	}
	else if ( x == 0 || x == n + 1 )
	{
		ix = x == 0 ? 0 : n - 1;
		iy = n - y;
	}
	const vec2 e = ( vec2( ix, iy ) + 0.5 ) / float( n ) * 2.0 - 1.0;
	vec3 d = vec3( e, 1.0 - abs( e.x ) - abs( e.y ) );
	if ( d.z < 0.0 )
		d.xy = ( vec2( 1.0 ) - abs( d.yx ) ) * vec2( d.x >= 0.0 ? 1.0 : -1.0, d.y >= 0.0 ? 1.0 : -1.0 );
	return normalize( d );
}

void Gather()
{
	const uint probe = gl_GlobalInvocationID.x;
	const uint texelIndex = gl_GlobalInvocationID.y;
	const int g = int( params.sizes.y );
	const vec4 row0 = ProbeGridRow( 0, g );
	const vec4 row1 = ProbeGridRow( 1, g );
	const vec4 row2 = ProbeGridRow( 2, g );
	const vec4 row3 = ProbeGridRow( 3, g );
	const vec4 row4 = ProbeGridRow( 4, g );
	const uvec3 dims = uvec3( row2.xyz );
	if ( probe >= dims.x * dims.y * dims.z || texelIndex >= 64u )
		return;
	const uint tilesPerRow = uint( row0.w );
	const uint stateRow = tilesPerRow * 16u;
	const uvec2 stateOrigin = uvec2( row4.zw );
	const vec4 state = texelFetch( sampler2D( probeAtlas, probeAtlasSampler ),
	    ivec2( stateOrigin.x + probe % stateRow, stateOrigin.y + probe / stateRow ), 0 );
	if ( state.w < 0.5 )
		return;
	const uvec3 index3 = uvec3( probe % dims.x, ( probe / dims.x ) % dims.y, probe / ( dims.x * dims.y ) );
	const vec3 spacing = row1.xyz;
	const float maxDistance = row1.w;
	const vec3 probePosition = row0.xyz + vec3( index3 ) * spacing + state.xyz;
	const int tx = int( texelIndex % 8u );
	const int ty = int( texelIndex / 8u );
	const vec3 n = TileDirection( tx, ty, 6 );
	const float nearest = 0.25 * min( spacing.x, min( spacing.y, spacing.z ) );
	vec3 sum = vec3( 0.0 );
	const uint count = params.sizes.x * params.sizes.x;
	for ( uint k = 0u; k < count; ++k )
	{
		const vec4 p = patches[k * 3u];
		if ( p.w < 0.5 )
			continue;
		const vec3 d = p.xyz - probePosition;
		const float r2 = max( dot( d, d ), nearest * nearest );
		const vec3 w = d * inversesqrt( max( dot( d, d ), 1e-8 ) );
		const float receive = dot( n, w );
#ifdef SEEDED_BOUNCE_EMIT_IGNORED
		const float emit = 1.0;
#else
		const float emit = -dot( patches[k * 3u + 1u].xyz, w );
#endif
		if ( receive <= 0.0 || emit <= 0.0 )
			continue;
		// The probe's visibility of the patch (its depth moments).
		float visibility = 1.0;
		const float r = sqrt( dot( d, d ) );
		const vec4 moments = ProbeTile( row4.xy, 16.0, probe, tilesPerRow, w );
		const float mean = moments.x * maxDistance;
		const float meanSquared = moments.y * maxDistance * maxDistance;
#ifndef SEEDED_BOUNCE_VISIBILITY_IGNORED
		if ( r > mean )
#else
		if ( false )
#endif
		{
			const float variance = abs( mean * mean - meanSquared );
			const float excess = r - mean;
			visibility = variance / ( variance + excess * excess );
			visibility *= visibility * visibility;
		}
		sum += patches[k * 3u + 2u].rgb * emit * receive * visibility / ( kPi * r2 );
	}
	const ivec2 corner = ivec2( row3.xy ) + ivec2( int( probe % tilesPerRow ), int( probe / tilesPerRow ) ) * 8;
	const ivec2 at = corner + ivec2( tx, ty );
	const vec4 before = imageLoad( bounceAtlas, at );
	imageStore( bounceAtlas, at, vec4( before.rgb + sum, 1.0 ) );
}

void main()
{
	if ( step.mode.x == 0u )
	{
		const ivec2 size = imageSize( bounceAtlas );
		const uint index = gl_GlobalInvocationID.x;
		if ( index < uint( size.x * size.y ) )
			imageStore( bounceAtlas, ivec2( int( index % uint( size.x ) ), int( index / uint( size.x ) ) ),
			    vec4( 0.0 ) );
		return;
	}
	if ( step.mode.x == 1u )
		Patch();
	else
		Gather();
}
