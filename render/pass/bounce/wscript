#! /usr/bin/env python
# encoding: utf-8
# render.pass.bounce (RFC 0016 layer 6 feature, render.lighting.v1 indirect
# diffuse): the projected lights' one bounce into the probe volume's layout.

def build(bld):
	bld.stlib(
		env         = bld.strict_cpp20_env(),
		features    = 'cxx capability_strict',
		arch_module = 'render.pass.bounce',
		target      = 'render_pass_bounce',
		name        = 'render_pass_bounce',
		source      = bld.path.ant_glob('*.cpp'),
		includes    = ['../../../public'],
		use         = ['render_device', 'render_math', 'render_shaderlib', 'render_spv'],
		idx         = bld.get_taskgen_count()
	)
