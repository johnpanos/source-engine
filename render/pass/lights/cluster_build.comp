#version 450
// GPU Morton ordering and a 32-way light BVH for the declared <=1024-light profiles.
// One group builds the view's tree. Assignment groups traverse its 32 children,
// each containing up to 32 sorted leaves. No CPU sorting or readback.
layout( local_size_x = 256 ) in;
layout( std140, set = 3, binding = 0 ) uniform Params
{
	uvec4 grid;
	uvec4 limits;
}
params;
struct Light
{
	vec4 positionRadius;
	vec4 directionOuterCos;
};
layout( std430, set = 3, binding = 1 ) readonly buffer Lights
{
	Light lights[];
};
layout( std430, set = 3, binding = 3 ) readonly buffer Grid
{
	vec4 gridData[];
};
layout( std430, set = 3, binding = 6 ) buffer Tree
{
	vec4 bounds[64];
	uint order[1024];
};
shared vec3 low[256];
shared vec3 high[256];
shared uvec2 keys[1024];
uint Spread( uint x )
{
	x = ( x | ( x << 16 ) ) & 0x030000ffu;
	x = ( x | ( x << 8 ) ) & 0x0300f00fu;
	x = ( x | ( x << 4 ) ) & 0x030c30c3u;
	return ( x | ( x << 2 ) ) & 0x09249249u;
}
bool Less( uvec2 a, uvec2 b )
{
	return a.x < b.x || ( a.x == b.x && a.y < b.y );
}
void main()
{
	uint lane = gl_LocalInvocationID.x;
	vec3 lo = vec3( 3e38 ), hi = vec3( -3e38 );
	for ( uint i = lane; i < params.grid.w; i += 256u )
	{
		lo = min( lo, lights[i].positionRadius.xyz );
		hi = max( hi, lights[i].positionRadius.xyz );
	}
	low[lane] = lo;
	high[lane] = hi;
	barrier();
	for ( uint step = 128u; step > 0u; step >>= 1u )
	{
		if ( lane < step )
		{
			low[lane] = min( low[lane], low[lane + step] );
			high[lane] = max( high[lane], high[lane + step] );
		}
		barrier();
	}
	for ( uint i = lane; i < 1024u; i += 256u )
	{
		uvec2 key = uvec2( 0xffffffffu );
		if ( i < params.grid.w )
		{
			vec3 unit = clamp(
			    ( lights[i].positionRadius.xyz - low[0] ) / max( high[0] - low[0], vec3( 1e-10 ) ),
			    0.0, 1.0 );
			uvec3 q = uvec3( unit * 1023.0 );
			key = uvec2( Spread( q.x ) | ( Spread( q.y ) << 1u ) | ( Spread( q.z ) << 2u ), i );
		}
		keys[i] = key;
	}
	barrier();
	// Bounded bitonic sort of Morton keys; ties retain original light order.
	uint padded = 1u;
	while ( padded < params.grid.w )
		padded <<= 1u;
	for ( uint size = 2u; size <= padded; size <<= 1u )
		for ( uint step = size >> 1u; step > 0u; step >>= 1u )
		{
			for ( uint i = lane; i < padded; i += 256u )
			{
				uint other = i ^ step;
				if ( other > i && ( Less( keys[other], keys[i] ) == ( ( i & size ) == 0u ) ) )
				{
					uvec2 t = keys[i];
					keys[i] = keys[other];
					keys[other] = t;
				}
			}
			barrier();
		}
	for ( uint i = lane; i < 1024u; i += 256u )
		order[i] = keys[i].y;
	if ( lane < 32u )
	{
		lo = vec3( 3e38 );
		hi = vec3( -3e38 );
		float farZ = gridData[params.grid.x + params.grid.y + 2u + params.grid.z].x;
		for ( uint j = 0u; j < 32u; ++j )
		{
			uint i = keys[lane * 32u + j].y;
			if ( i >= params.grid.w )
				continue;
			vec3 p = lights[i].positionRadius.xyz;
			float r = lights[i].positionRadius.w;
			// Covers the leaf test's relative slack at every depth, including touching bounds.
			r = r >= 1e38 ? 3e38 : r + 8e-6 * ( length( p ) + r + farZ );
			lo = min( lo, p - vec3( r ) );
			hi = max( hi, p + vec3( r ) );
		}
		bounds[lane * 2u] = vec4( lo, 0 );
		bounds[lane * 2u + 1u] = vec4( hi, 0 );
	}
}
