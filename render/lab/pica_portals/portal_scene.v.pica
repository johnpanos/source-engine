; pica_portals (the 3DS portal lab): the one vertex program every technique
; draws with. c0-c3: the draw's clip rows (the D16 draw-constant block);
; v0 position, v1 texture coordinate (port convention, v down), v2 a
; kUnorm8x4 colour (0 to 255). Writes PICA clip space (z negated) and PVS1's
; texture coordinate (u, 1 - v). A pre-projected vertex (x, y, depth) with
; the identity matrix draws where it says: the screen-texture technique.

.fvec clip[4]

.constf k(1.0, 0.00392156862745098, 0.0, 0.0)

.out outpos position
.out outclr color
.out outtc0 texcoord0

.alias inpos v0
.alias inuv v1
.alias incolor v2

.proc main
	mov r0.xyz, inpos
	mov r0.w, k.xxxx
	dp4 r1.x, clip[0], r0
	dp4 r1.y, clip[1], r0
	dp4 r1.z, clip[2], r0
	dp4 r1.w, clip[3], r0
	mov r1.z, -r1.zzzz
	mov outpos, r1

	mov r2, k.xxxx
	mov r2.x, inuv.xxxx
	add r2.y, k.xxxx, -inuv.yyyy
	mov outtc0, r2

	mul outclr, k.yyyy, incolor
	end
.end
