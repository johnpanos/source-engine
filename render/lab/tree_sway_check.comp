#version 450
#include "../shaders/common/tree_sway.glsl"
layout( local_size_x = 64 ) in;
struct Case
{
	vec4 positionTime;
	vec4 windMode;
	vec4 geometry;
	vec4 motion;
	vec4 curves;
	vec4 windControls;
	mat4 objectToWorld;
};
layout( std430, set = 3, binding = 0, row_major ) readonly buffer Cases
{
	uvec4 header;
	Case cases[];
};
layout( std430, set = 3, binding = 1 ) writeonly buffer Results
{
	vec4 results[];
};
void main()
{
	const uint i = gl_GlobalInvocationID.x;
	if ( i >= header.x )
		return;
	const Case c = cases[i];
	results[i] = vec4( TreeSway( c.positionTime.xyz, c.objectToWorld, c.windMode.xy,
	    c.positionTime.w, int( c.windMode.z ), c.geometry, c.motion, c.curves, c.windControls ), 1.0 );
}
