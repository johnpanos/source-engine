// render_lab suite reflection-probes (RFC 0016 K11): evaluates the reflection
// probes (render/shaders/common/reflection_probes.glsl) at each case, so the
// suite can judge them against their oracle, mapcontainer::
// ReflectionProbesView. The probe texture (WriteReflectionProbeTexture's GPU
// form) is a sampled texture; its texels are fetched exactly and filtered
// explicitly, as the reference filters them, so the blend, parallax and lod
// arithmetic is what is judged. Per case it writes the radiance, and 1 in w
// when the texture carried probes.
#version 450

#include "../shaders/common/pbr_brdf.glsl"

layout( local_size_x = 64 ) in;

layout( set = 3, binding = 0 ) uniform texture2D probeTexture;
layout( set = 3, binding = 1 ) uniform sampler probeSampler;

struct Case
{
	vec4 positionRoughness;
	vec4 normal;    // the geometric normal
	vec4 reflected; // the unit reflected ray
};

layout( std430, set = 3, binding = 2 ) readonly buffer Cases
{
	uvec4 header; // x: the case count
	Case cases[];
};

layout( std430, set = 3, binding = 3 ) writeonly buffer Results
{
	vec4 results[];
};

vec4 ReflectionProbesFetch( ivec2 texel )
{
	const ivec2 size = textureSize( sampler2D( probeTexture, probeSampler ), 0 );
	return texelFetch( sampler2D( probeTexture, probeSampler ),
	    clamp( texel, ivec2( 0 ), size - ivec2( 1 ) ), 0 );
}

vec4 ReflectionProbesSample( vec2 texel )
{
	const vec2 t = texel - vec2( 0.5 );
	const ivec2 corner = ivec2( floor( t ) );
	const vec2 f = t - vec2( corner );
	const vec4 upper = mix( ReflectionProbesFetch( corner ),
	    ReflectionProbesFetch( corner + ivec2( 1, 0 ) ), f.x );
	const vec4 lower = mix( ReflectionProbesFetch( corner + ivec2( 0, 1 ) ),
	    ReflectionProbesFetch( corner + ivec2( 1, 1 ) ), f.x );
	return mix( upper, lower, f.y );
}

// R50-RELIGHT: the analytic light (now and baked) and the moving occluder
// the relight fixture is relit by (tools/quality/reflection_probe_set.py
// fixture_light and FIXTURE_OCCLUDER; the suite's FixtureLight).
#define REFLECTION_PROBE_RELIGHT
#include "../shaders/common/reflection_probes.glsl"

void ReflectionProbeDiffuseLight( vec3 position, vec3 normal, out vec3 now, out vec3 baked )
{
	baked = vec3(
	    0.3 + 0.001 * position.x, 0.25 + 0.1 * abs( normal.z ), 0.2 + 0.0005 * position.z );
	now = baked + vec3( 0.002 * position.x + 0.5 * max( normal.z, 0.0 ) - 0.45,
	                  0.3 - 0.003 * position.y, 0.25 * normal.x - 0.1 );
}

int ReflectionProbeOccluderCount()
{
	return 1;
}

void ReflectionProbeOccluder( int k, out vec3 lo, out vec3 hi, out float reflectance )
{
	const float unitsPerMeter = 39.37007874015748;
	lo = vec3( 2.8, 1.2, 0.0 ) * unitsPerMeter;
	hi = vec3( 3.2, 2.8, 2.2 ) * unitsPerMeter;
	reflectance = 0.4;
}

void main()
{
	const uint index = gl_GlobalInvocationID.x;
	if ( index >= header.x )
		return;
	const Case c = cases[index];
	vec3 radiance;
#ifdef RPRB_CANDIDATE_INVARIANTS
	vec4 selection;
	bool carried = ReflectionProbesRadianceDebug( c.positionRoughness.xyz, c.normal.xyz,
	    c.reflected.xyz, c.positionRoughness.w, radiance, selection );
	int count = int( ReflectionProbesFetch( ivec2( 0, 0 ) ).x );
	uvec2 candidates = ReflectionCandidates( c.positionRoughness.xyz, count );
	bool covered = true;
	for ( int rank = 0; rank < count; ++rank )
	{
		vec4 capture = ReflectionProbeRecord( rank, 0 );
		vec3 lo = ReflectionProbeRecord( rank, 3 ).xyz;
		vec3 hi = ReflectionProbeRecord( rank, 4 ).xyz;
		vec3 outside = max( max( lo - c.positionRoughness.xyz, c.positionRoughness.xyz - hi ), vec3( 0 ) );
		bool required = rank < 2 || ReflectionProbeRecord( rank, 2 ).w > 0.5 || length( outside ) < capture.w;
		covered = covered && ( !required || ( candidates[rank / 32] & ( 1u << uint( rank % 32 ) ) ) != 0u );
	}
	bool finiteLight = !any( isnan( radiance ) ) && !any( isinf( radiance ) ) && all( greaterThanEqual( radiance, vec3( 0 ) ) );
	bool weights = abs( selection.z + selection.w - 1.0 ) < 1e-5 && selection.z >= 0.0 && selection.w >= 0.0;
	bool ranks = selection.x >= 0.0 && selection.x < count &&
	    ( selection.w == 0.0 || ( selection.y >= 0.0 && selection.y < count ) );
	results[index] = vec4( carried && covered ? 1.0 : 0.0, finiteLight ? 1.0 : 0.0,
	    weights && ranks ? 1.0 : 0.0, float( bitCount( candidates.x ) + bitCount( candidates.y ) ) );
#else
	const bool carried = ReflectionProbesRadiance( c.positionRoughness.xyz, c.normal.xyz,
	    c.reflected.xyz, c.positionRoughness.w, radiance );
	results[index] = vec4( radiance, carried ? 1.0 : 0.0 );
#endif
}
