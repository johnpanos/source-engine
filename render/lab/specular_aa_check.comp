#version 450
#include "../shaders/common/pbr_specular_aa.glsl"
layout( local_size_x = 64 ) in;
// Per case: x roughness; the normal's screen derivatives.
struct Case
{
	vec4 roughness;
	vec4 normalDx;
	vec4 normalDy;
};
layout( std430, set = 3, binding = 0 ) readonly buffer Cases
{
	uvec4 header;
	Case cases[];
};
layout( std430, set = 3, binding = 1 ) writeonly buffer Results
{
	float results[];
};
void main()
{
	const uint i = gl_GlobalInvocationID.x;
	if ( i >= header.x )
		return;
	const Case c = cases[i];
	results[i] = SpecularAaRoughness( c.roughness.x, c.normalDx.xyz, c.normalDy.xyz );
}
