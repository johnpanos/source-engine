#! /usr/bin/env python
# encoding: utf-8

# render_lab (RFC 0016 K11): the render core composed alone, rendering scenes
# from BSP2 maps, studio models and VMT materials through the Vulkan adapter,
# to prove each lighting term against Cycles before product wiring. Built with
# the tools product when the core's Vulkan adapter and the texture readers
# (--ktx-source-root/--ktx-build-root) are configured (render_lab_projects in
# the top-level wscript).

top = '.'

def options(opt):
	return

def configure(conf):
	conf.load('strict_cpp20', tooldir='scripts/waifulib')

def build(bld):
	bld.program(
		env       = bld.strict_cpp20_env(),
		source    = [ 'render_lab.cpp', 'lab_shadows.cpp', 'lab_support.cpp', 'lab_canvas.cpp', 'lab_compute.cpp',
		              'lab_suite.cpp', 'lab_receiver.cpp', 'suites.cpp', 'debug_views_suite.cpp', 'cost_overlay_suite.cpp',
		              'area_lights_suite.cpp', 'energy_field_suite.cpp', 'lightmap_basis_suite.cpp',
		              'probe_volume_suite.cpp', 'reflection_probes_suite.cpp', 'tree_sway_suite.cpp',
		              'volumetric_suite.cpp', 'clustered_lights_suite.cpp',
		              'map_terms_suite.cpp', 'ssr_reference.cpp', 'ssr_scene.cpp', 'ssr_suite.cpp',
		              'shadowed_lights_suite.cpp', 'cutout_shadows_suite.cpp', 'shadow_receiver_perf_suite.cpp', 'bounce_suite.cpp', 'gtao_suite.cpp',
		              'panel_suite.cpp', 'posed_model_suite.cpp', 'selfillum_suite.cpp', 'energy_surface_suite.cpp', 'pbr_compat_suite.cpp', 'softparticle_suite.cpp', 'particles_suite.cpp', 'sprite_suite.cpp', 'static_light_suite.cpp', 'shader_stats_suite.cpp', 'shadow_mask_suite.cpp', 'model_selection_suite.cpp', 'view_state_suite.cpp', 'temporal_suite.cpp', 'gpu_submission_suite.cpp' ],
		target    = 'render_lab',
		name      = 'render_lab',
		arch_module = 'render.lab',
		features  = 'cxx cxxprogram',
		includes  = [ '../../public' ],
		use       = [ 'render_device_vulkan', 'render_pass_lines', 'render_pass_lights', 'render_pass_ssr', 'render_pass_temporal', 'render_material', 'render_frame',
		              'render_graph', 'jobsystem', 'render_resources', 'render_shaderlib',
		              'render_pass_shadows', 'render_pass_volumetric', 'render_pass_ao', 'render_pass_bounce', 'render_pass_world', 'render_pass_panels', 'render_map_media', 'render_pass_output',
		              'render_device', 'render_math', 'render_spv', 'mapcontainer', 'mdl',
		              'vtf_texture_reader', 'vtf_decompress', 'asset_resolver', 'asset_index', 'asset_identity', 'content_hash' ],
		install_path = None,
		subsystem = 'CONSOLE',
		idx       = bld.get_taskgen_count()
	)
