#! /usr/bin/env python
# encoding: utf-8

# RFC 0016 render core: one strict C++20 static library per module, each
# declaring its architecture module (architecture/modules.json owns the edges;
# archlint CAP011 checks they point down the layers). The root adds this
# directory to client, tool and test products only, never to a dedicated one.
# Device adapters build only when configured.

top = '.'

PORTABLE = [
	'math',
	'device',
	'device/null',
	'device/pica',
	'graph',
	'shaderlib',
	'resources',
	'material',
	'scene',
	'frame',
	'renderer',
	'pass/present',
	'pass/skinning',
	'culling',
	'pass/opaque',
	'pass/world',
	'pass/lines',
	'pass/panels',
	'pass/luminance',
	'pass/visibility',
	'pass/debug',
	'pass/lights',
	'pass/shadows',
	'pass/output',
	'pass/post',
	'pass/volumetric',
	'pass/ssr',
	'pass/temporal',
	'pass/ao',
	'pass/bounce',
	'pass/indirect',
	'legacy',
	'map_media',
	'composition',
]

def modules(env):
	adapters = []
	if env.RENDER_CORE_VULKAN:
		adapters.append('device/vulkan')
	if env.RENDER_CORE_GL:
		adapters.append('device/gl')
	if env.RENDER_CORE_METAL:
		adapters.append('device/metal')
	if env.RENDER_CORE_D3D12:
		adapters.append('device/d3d12')
	if env.RENDER_CORE_WEBGPU:
		adapters.append('device/webgpu')
	return PORTABLE + adapters

def options(opt):
	return

def configure(conf):
	conf.load('strict_cpp20', tooldir='scripts/waifulib')
	# render/shaders is configured by the root, in the root environment.

def build(bld):
	# render/shaders is recursed by the root, before every project (its
	# generated headers must be in the first build group).
	bld.recurse(modules(bld.env))
