#! /usr/bin/env python
# encoding: utf-8
# render.composition (RFC 0016 layer 7): RenderCore_Create for application
# roots. The only render module that names device adapters.

def build(bld):
	use = ['mdl', 'render_renderer', 'render_pass_present', 'render_pass_world', 'render_pass_debug',
		'render_pass_output', 'render_pass_post', 'render_pass_temporal',
		'render_legacy', 'render_scene',
		'render_frame', 'render_graph', 'render_resources', 'render_material',
		'render_pass_skinning',
		'render_shaderlib', 'render_device', 'render_math', 'mapcontainer', 'render_pass_lights', 'render_pass_shadows', 'render_pass_ao', 'render_pass_indirect', 'render_pass_panels', 'render_pass_luminance', 'render_pass_volumetric', 'render_map_media', 'render_pass_ssr',
		'vtf_decompress']
	defines = []
	# Every product but the 3DS links the null adapter (headless runs and
	# tools); the 3DS has one device, the PICA200's (RFC 0026).
	if bld.env.N3DS:
		defines.append('RENDER_CORE_NO_NULL')
	else:
		use.append('render_device_null')
	if bld.env.RENDER_CORE_VULKAN:
		use.append('render_device_vulkan')
		defines.append('RENDER_CORE_VULKAN')
	if bld.env.RENDER_CORE_GL:
		use.append('render_device_gl')
		defines.append('RENDER_CORE_GL')
	if bld.env.RENDER_CORE_METAL:
		use.append('render_device_metal')
		defines.append('RENDER_CORE_METAL')
	if bld.env.RENDER_CORE_D3D12:
		use.append('render_device_d3d12')
		defines.append('RENDER_CORE_D3D12')
	# RFC 0026: the 3DS's adapter.
	if bld.env.N3DS:
		use.append('render_device_pica')
		defines.append('RENDER_CORE_PICA')
	bld.stlib(
		env         = bld.strict_cpp20_env(),
		features    = 'cxx capability_strict',
		arch_module = 'render.composition',
		target      = 'render_composition',
		name        = 'render_composition',
		source      = bld.path.ant_glob('*.cpp'),
		includes    = ['../../public'],
		defines     = defines,
		use         = use,
		idx         = bld.get_taskgen_count()
	)
