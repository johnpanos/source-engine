#! /usr/bin/env python
# encoding: utf-8

# Headless editor authority (RFC 0002 hammer.app): the map document, undo
# history, save orchestration and the named command layer that the GTK host,
# scripts, UI-driven tests and an MCP server share. A strict C++20 static
# library with no UI dependency; it composes the layered format libraries.
# Its link to the VMF and KeyValues codecs is the recorded R22 include
# exception in architecture/modules.json.

top = '.'

def options(opt):
	return

def configure(conf):
	conf.load('strict_cpp20', tooldir='scripts/waifulib')

def build(bld):
	# hammer.scene: the map document content model, staged edits and change
	# sets, solid geometry and structural queries.
	bld.stlib(
		env       = bld.strict_cpp20_env(),
		source    = [ 'scene/change_set.cpp', 'scene/displacement_geometry.cpp',
		              'scene/document_index.cpp', 'scene/handle_table.cpp', 'scene/map_document.cpp', 'scene/map_objects.cpp',
		              'scene/map_queries.cpp', 'scene/scene_graph.cpp', 'scene/solid_geometry.cpp' ],
		target    = 'hammer_scene',
		name      = 'hammer_scene',
		arch_module = 'hammer.scene',
		features  = 'cxx',
		includes  = [ '../../public' ],
		defines   = [],
		use       = [ 'kvtext', 'mapgeometry' ],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx       = bld.get_taskgen_count()
	)

	# hammer.ports: shared helpers of the port contracts.
	bld.stlib(
		env       = bld.strict_cpp20_env(),
		source    = [ 'ports/entity_catalog.cpp' ],
		target    = 'hammer_ports',
		name      = 'hammer_ports',
		arch_module = 'hammer.ports',
		features  = 'cxx',
		includes  = [ '../../public' ],
		defines   = [],
		use       = [ 'hammer_scene', 'mapgeometry' ],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx       = bld.get_taskgen_count()
	)

	bld.stlib(
		env       = bld.strict_cpp20_env(),
		source    = [ 'app/change_history.cpp', 'app/clipboard.cpp', 'app/command_script.cpp',
		              'app/document_history.cpp', 'app/document_io.cpp', 'app/edit_session.cpp',
		              'app/editor_document.cpp',
		              'app/entity_selection.cpp', 'app/fragment_io.cpp', 'app/instance_fixup.cpp',
		              'app/instance_preview.cpp',
		              'app/map_build_queue.cpp', 'app/map_check.cpp', 'app/property_value.cpp',
		              'app/save_orchestrator.cpp', 'app/selection.cpp', 'app/session_commands.cpp',
		              'app/update_hint.cpp', 'app/ops/cordon_ops.cpp', 'app/ops/create_ops.cpp',
		              'app/ops/csg_ops.cpp', 'app/ops/decal_ops.cpp', 'app/ops/displacement_ops.cpp',
		              'app/ops/entity_ops.cpp', 'app/ops/find_replace_ops.cpp', 'app/ops/instance_ops.cpp',
		              'app/ops/prefab_ops.cpp', 'app/ops/structure_ops.cpp', 'app/ops/texture_ops.cpp',
		              'app/ops/transform_ops.cpp', 'app/ops/vertex_ops.cpp', 'app/ops/visgroup_ops.cpp' ],
		target    = 'hammer_app',
		name      = 'hammer_app',
		arch_module = 'hammer.app',
		features  = 'cxx',
		includes  = [ '../../public' ],
		defines   = [],
		use       = [ 'hammer_ports', 'hammer_scene', 'kvtext', 'mapgeometry' ],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx       = bld.get_taskgen_count()
	)

	# hammer.formats: the editor's format features over the codec libraries,
	# including the full-fidelity VMF codec (IMapCodec), the FGD entity catalog
	# (IEntityCatalog) and the material information adapter (IMaterialInfo).
	bld.stlib(
		env       = bld.strict_cpp20_env(),
		source    = [ 'formats/cordon.cpp', 'formats/entity_property_sheet.cpp', 'formats/fgd.cpp',
		              'formats/fgd_entity_catalog.cpp', 'formats/groups.cpp',
		              'formats/instancing.cpp', 'formats/map_export.cpp',
		              'formats/material_catalog.cpp', 'formats/material.cpp',
		              'formats/material_info_adapter.cpp', 'formats/overlay.cpp',
		              'formats/prefab.cpp', 'formats/search_path_assets.cpp',
		              'formats/visgroups.cpp', 'formats/vmf_map_codec.cpp',
		              'formats/vpk_archive.cpp', 'formats/vtf_image.cpp' ],
		target    = 'hammer_formats',
		name      = 'hammer_formats',
		arch_module = 'hammer.formats',
		features  = 'cxx',
		includes  = [ '../../public', '../..' ],
		defines   = [],
		use       = [ 'hammer_ports', 'hammer_scene', 'vmf', 'kvtext', 'mapgeometry', 'vtf_container' ],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx       = bld.get_taskgen_count()
	)

	# hammer.viewport: cameras, the grid policy, picking and render snapshots.
	bld.stlib(
		env       = bld.strict_cpp20_env(),
		source    = [ 'viewport/camera.cpp', 'viewport/extraction.cpp', 'viewport/grid.cpp',
		              'viewport/picking.cpp', 'viewport/view_policy.cpp' ],
		target    = 'hammer_viewport',
		name      = 'hammer_viewport',
		arch_module = 'hammer.viewport',
		features  = 'cxx',
		includes  = [ '../../public' ],
		defines   = [],
		use       = [ 'hammer_ports', 'hammer_scene', 'mapgeometry' ],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx       = bld.get_taskgen_count()
	)

	# hammer.tools: normalized input, the tool contract and manager, the shared
	# interaction policy, the editing tools and the camera controller.
	bld.stlib(
		env       = bld.strict_cpp20_env(),
		source    = [ 'tools/block_tool.cpp', 'tools/box_handles.cpp', 'tools/camera_controller.cpp',
		              'tools/clip_tool.cpp', 'tools/entity_tool.cpp', 'tools/face_tool.cpp',
		              'tools/input.cpp', 'tools/interaction_policy.cpp', 'tools/preview.cpp',
		              'tools/selection_tool.cpp', 'tools/tool_manager.cpp', 'tools/vertex_tool.cpp' ],
		target    = 'hammer_tools',
		name      = 'hammer_tools',
		arch_module = 'hammer.tools',
		features  = 'cxx',
		includes  = [ '../../public' ],
		defines   = [],
		use       = [ 'hammer_viewport', 'hammer_app', 'hammer_ports', 'hammer_scene', 'mapgeometry' ],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx       = bld.get_taskgen_count()
	)

	# hammer.presenters: display-ready panel models and action routing.
	bld.stlib(
		env       = bld.strict_cpp20_env(),
		source    = [ 'presenters/action_catalog.cpp', 'presenters/class_palette.cpp',
		              'presenters/editor_workspace.cpp', 'presenters/entity_inspector.cpp',
		              'presenters/face_inspector.cpp', 'presenters/history_panel.cpp',
		              'presenters/material_browser.cpp', 'presenters/object_label.cpp',
		              'presenters/outliner.cpp', 'presenters/problems_panel.cpp',
		              'presenters/status_bar.cpp', 'presenters/visgroup_panel.cpp' ],
		target    = 'hammer_presenters',
		name      = 'hammer_presenters',
		arch_module = 'hammer.presenters',
		features  = 'cxx',
		includes  = [ '../../public' ],
		defines   = [],
		use       = [ 'hammer_tools', 'hammer_viewport', 'hammer_app', 'hammer_ports', 'hammer_scene',
		              'mapgeometry' ],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx       = bld.get_taskgen_count()
	)
