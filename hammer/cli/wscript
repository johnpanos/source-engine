#! /usr/bin/env python
# encoding: utf-8

# hammer_cli: the headless Hammer host (RFC 0002 map-building loop). A
# composition root that runs command scripts through hammer::app::SessionCommands
# against the disk; tools/quality/hammer_loop.py drives it.

top = '.'

def options(opt):
	return

def configure(conf):
	conf.load('strict_cpp20', tooldir='scripts/waifulib')

def build(bld):
	bld.program(
		env       = bld.strict_cpp20_env(),
		source    = [ 'hammer_cli.cpp' ],
		target    = 'hammer_cli',
		name      = 'hammer_cli',
		arch_module = 'hammer.composition',
		features  = 'cxx cxxprogram',
		includes  = [ '../../public', '../..' ],
		defines   = [],
		use       = [ 'hammer_mcp', 'hammer_formats', 'hammer_app', 'hammer_ports', 'hammer_scene',
		              'hammer_platform', 'platform_posix', 'vmf', 'kvtext', 'mapgeometry' ],
		install_path = None,
		subsystem = 'CONSOLE',
		idx       = bld.get_taskgen_count()
	)
	# Host material import: compose the existing VTF pixel decoder with the
	# configured host compression libraries. No second VTF parser is introduced.
	if bld.env.KTX_READ_ENABLED and bld.env.DEST_OS == 'linux':
		bld.program(
			env=bld.strict_cpp20_env(),
			source=['vtf_decode.cpp'],
			target='hammer_vtf_decode',
			name='hammer_vtf_decode',
			arch_module='hammer.composition',
			features='cxx cxxprogram',
			includes=['../../public'],
			use=['hammer_formats', 'KTXREAD'],
			install_path=None)
