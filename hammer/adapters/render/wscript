#! /usr/bin/env python
# encoding: utf-8

# Hammer's viewports on the RFC 0016 render core (RFC 0002
# hammer.adapters.render; RFC 0016 A.7 and "Editor viewports"): the viewport
# geometry and renderer over render.pass.lines, and the editor document's
# solids projected into a render::scene the editor owns.

top = '.'

def options(opt):
	return

def configure(conf):
	conf.load('strict_cpp20', tooldir='scripts/waifulib')

def build(bld):
	bld.stlib(
		env       = bld.strict_cpp20_env(),
		source    = [ 'material_textures.cpp', 'scene_geometry.cpp', 'viewport_renderer.cpp',
		              'viewport_service.cpp' ],
		target    = 'hammer_render',
		name      = 'hammer_render',
		arch_module = 'hammer.adapters.render',
		features  = 'cxx',
		includes  = [ '../../../public', '../../..' ],
		defines   = [],
		use       = [ 'hammer_tools', 'hammer_viewport', 'hammer_scene', 'render_pass_lines',
		              'render_pass_opaque', 'render_material',
		              'render_resources', 'render_graph', 'render_device', 'render_scene',
		              'render_math', 'mapgeometry' ],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx       = bld.get_taskgen_count()
	)
