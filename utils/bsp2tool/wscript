#! /usr/bin/env python
# encoding: utf-8

# bsp2tool (RFC 0008, phase F1): inspect, verify, convert legacy VBSP maps to
# BSP2 and export them back. Host tool; C++20 (quality/toolchain/policy.json)
# over mapcontainer only.

top = '.'
PROJECT_NAME = 'bsp2tool'

def options(opt):
	return

def configure(conf):
	return

def build(bld):
	bld(
		source       = [ 'bsp2tool.cpp' ],
		target       = PROJECT_NAME,
		name         = PROJECT_NAME,
		features     = 'c cxx cxxprogram',
		includes     = [ '../../public' ],
		defines      = [],
		# mapcontainer reads the consolidated VTF container reader (RFC 0008 F3),
		# whose implementation is this separate strict library; naming it here
		# links it explicitly, because `vtf`'s own `use` of it does not reach a
		# tools link line.
		use          = [ 'mapcontainer', 'vtf_container' ],
		install_path = bld.env.BINDIR,
		subsystem    = bld.env.MSVC_SUBSYSTEM,
		idx          = bld.get_taskgen_count()
	)
