#! /usr/bin/env python
# encoding: utf-8

# Capability composition kernel (RFC 0001 rank 3). This is a strict C++20,
# portable target with no Tier or native-platform dependency.

top = '.'
PROJECT_NAME = 'platform_composition'

def options(opt):
	return

def configure(conf):
	conf.load('strict_cpp20', tooldir='scripts/waifulib')

def build(bld):
	bld.stlib(
		env       = bld.strict_cpp20_env(),
		source    = [ 'composition.cpp' ],
		target    = PROJECT_NAME,
		name      = PROJECT_NAME,
		arch_module = 'platform.composition',
		features  = 'cxx capability_strict',
		includes  = [ '../public' ],
		defines   = [],
		use       = [],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx       = bld.get_taskgen_count()
	)
	# Legacy dedicated modules use libstdc++'s old dual ABI. Compile the same
	# authoritative kernel source for that ABI instead of mixing STL objects.
	legacy_abi = [ '_GLIBCXX_USE_CXX11_ABI=0' ] if bld.env.DEST_OS == 'linux' else []
	bld.stlib(
		env       = bld.strict_cpp20_env(),
		source    = [ 'composition.cpp' ],
		target    = 'platform_composition_legacyabi',
		name      = 'platform_composition_legacyabi',
		arch_module = 'platform.composition',
		features  = 'cxx capability_strict',
		includes  = [ '../public' ],
		defines   = legacy_abi,
		use       = [],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx       = bld.get_taskgen_count()
	)
	# RFC 0001 rank 4 native loader provider (R07). POSIX hosts only; roots
	# and the Tier 1 Sys_* bridge select it explicitly. The 3DS has neither a
	# dynamic loader nor process spawning (statically composed, RFC 0026).
	if bld.env.DEST_OS not in ('win32', '3ds'):
		bld.stlib(
			env       = bld.strict_cpp20_env(),
			source    = [ 'posix/dynamic_library_provider.cpp', 'posix/tool_process_provider.cpp',
			              'posix/process_exec.cpp', 'posix/process_spawner.cpp',
			              # RFC 0001 foundation providers (R26).
			              'posix/clock_providers.cpp', 'posix/thread_provider.cpp',
			              'posix/virtual_memory_provider.cpp',
			              'posix/process_environment_provider.cpp', 'posix/paths_provider.cpp',
			              'posix/diagnostics_provider.cpp', 'posix/file_probe_provider.cpp' ],
			target    = 'platform_posix',
			name      = 'platform_posix',
			arch_module = 'platform.posix',
			features  = 'cxx capability_strict',
			includes  = [ '../public' ],
			defines   = [],
			use       = [],
			subsystem = bld.env.MSVC_SUBSYSTEM,
			idx       = bld.get_taskgen_count()
		)
		# The same provider for legacy (old libstdc++ dual ABI) consumers such as
		# Tier 1 and its test hosts; see platform_composition_legacyabi.
		bld.stlib(
			env       = bld.strict_cpp20_env(),
			source    = [ 'posix/dynamic_library_provider.cpp', 'posix/tool_process_provider.cpp' ],
			target    = 'platform_posix_legacyabi',
			name      = 'platform_posix_legacyabi',
			arch_module = 'platform.posix',
			features  = 'cxx capability_strict',
			includes  = [ '../public' ],
			defines   = legacy_abi,
			use       = [],
			subsystem = bld.env.MSVC_SUBSYSTEM,
			idx       = bld.get_taskgen_count()
		)
	# Tier 0's foundation providers (R103): the POSIX set on every non-Windows
	# target and the Win32 set on Windows, built for Tier 0's libstdc++ ABI.
	if bld.env.DEST_OS == 'win32':
		bld.stlib(
			env       = bld.strict_cpp20_env(),
			source    = [ 'win32/clock_providers.cpp', 'win32/thread_provider.cpp',
			              'win32/virtual_memory_provider.cpp',
			              'win32/process_environment_provider.cpp', 'win32/paths_provider.cpp',
			              'win32/diagnostics_provider.cpp' ],
			target    = 'platform_foundation_win32',
			name      = 'platform_foundation_win32',
			arch_module = 'platform.win32',
			features  = 'cxx capability_strict',
			includes  = [ '../public' ],
			defines   = [],
			use       = [],
			subsystem = bld.env.MSVC_SUBSYSTEM,
			idx       = bld.get_taskgen_count()
		)
	else:
		bld.stlib(
			env       = bld.strict_cpp20_env(),
			source    = [ 'posix/clock_providers.cpp', 'posix/thread_provider.cpp',
			              'posix/virtual_memory_provider.cpp',
			              'posix/process_environment_provider.cpp', 'posix/paths_provider.cpp',
			              'posix/diagnostics_provider.cpp' ],
			target    = 'platform_foundation_legacyabi',
			name      = 'platform_foundation_legacyabi',
			arch_module = 'platform.posix',
			features  = 'cxx capability_strict',
			includes  = [ '../public' ],
			defines   = legacy_abi,
			# Linked into Tier 0 and other shared modules: keep std template
			# instantiations out of their export lists, as their own code does.
			cxxflags  = [ '-fvisibility=hidden', '-fvisibility-inlines-hidden' ],
			use       = [],
			subsystem = bld.env.MSVC_SUBSYSTEM,
			idx       = bld.get_taskgen_count()
		)
	# Module resolution (RFC 0001 rank 5, R11): the portable resolver, and the
	# POSIX file probe on its own so products without a dynamic loader (the
	# 3DS) still get it. Tier 1's Sys_LoadModule search uses the _legacyabi
	# builds; see platform_composition_legacyabi.
	for target, defines in ( ( 'platform_resolver', [] ),
	                         ( 'platform_resolver_legacyabi', legacy_abi ) ):
		hidden = [ '-fvisibility=hidden', '-fvisibility-inlines-hidden' ] \
			if target.endswith( '_legacyabi' ) and bld.env.DEST_OS != 'win32' else []
		bld.stlib(
			env       = bld.strict_cpp20_env(),
			source    = [ 'resolver/module_resolver.cpp' ],
			cxxflags  = hidden,
			target    = target,
			name      = target,
			arch_module = 'platform.resolver',
			features  = 'cxx capability_strict',
			includes  = [ '../public' ],
			defines   = defines,
			use       = [],
			subsystem = bld.env.MSVC_SUBSYSTEM,
			idx       = bld.get_taskgen_count()
		)
	if bld.env.DEST_OS != 'win32':
		bld.stlib(
			env       = bld.strict_cpp20_env(),
			source    = [ 'posix/file_probe_provider.cpp' ],
			target    = 'platform_file_probe_legacyabi',
			name      = 'platform_file_probe_legacyabi',
			arch_module = 'platform.posix',
			features  = 'cxx capability_strict',
			includes  = [ '../public' ],
			defines   = legacy_abi,
			# Linked into Tier 0 and other shared modules: keep std template
			# instantiations out of their export lists, as their own code does.
			cxxflags  = [ '-fvisibility=hidden', '-fvisibility-inlines-hidden' ],
			use       = [],
			subsystem = bld.env.MSVC_SUBSYSTEM,
			idx       = bld.get_taskgen_count()
		)
	# Task runners and virtual time (RFC 0001 rank 11, R10): portable providers
	# of platform.task-runner.v1 over the standard library.
	bld.stlib(
		env       = bld.strict_cpp20_env(),
		source    = [ 'runners/manual_task_runner.cpp', 'runners/thread_task_runner.cpp',
		              'runners/sequenced_task_runner.cpp' ],
		target    = 'platform_runners',
		name      = 'platform_runners',
		arch_module = 'platform.runners',
		features  = 'cxx capability_strict',
		includes  = [ '../public' ],
		defines   = [],
		use       = [],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx       = bld.get_taskgen_count()
	)
	# The same runners for legacy (old libstdc++ dual ABI) consumers such as
	# vstdlib's engine-pool runner; see platform_composition_legacyabi.
	bld.stlib(
		env       = bld.strict_cpp20_env(),
		source    = [ 'runners/manual_task_runner.cpp', 'runners/thread_task_runner.cpp',
		              'runners/sequenced_task_runner.cpp' ],
		target    = 'platform_runners_legacyabi',
		name      = 'platform_runners_legacyabi',
		arch_module = 'platform.runners',
		features  = 'cxx capability_strict',
		includes  = [ '../public' ],
		defines   = legacy_abi,
		use       = [],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx       = bld.get_taskgen_count()
	)
	# Player record stores (platform.record-store.v1): the file store every
	# product can use. The game modules (legacy Linux dual ABI) take the
	# _legacyabi build; see platform_composition_legacyabi.
	for target, defines in ( ( 'platform_records', [] ),
	                         ( 'platform_records_legacyabi', legacy_abi ) ):
		bld.stlib(
			env       = bld.strict_cpp20_env(),
			source    = [ 'records/file_record_store.cpp' ],
			target    = target,
			name      = target,
			arch_module = 'platform.records',
			features  = 'cxx capability_strict',
			includes  = [ '../public' ],
			defines   = defines,
			use       = [],
			subsystem = bld.env.MSVC_SUBSYSTEM,
			idx       = bld.get_taskgen_count()
		)
	# The portable achievement service (platform.achievement-service.v1)
	# that native bridges complete.
	bld.stlib(
		env       = bld.strict_cpp20_env(),
		source    = [ 'achievements/queued_achievement_service.cpp' ],
		target    = 'platform_achievements',
		name      = 'platform_achievements',
		arch_module = 'platform.achievements',
		features  = 'cxx capability_strict',
		includes  = [ '../public' ],
		defines   = [],
		use       = [],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx       = bld.get_taskgen_count()
	)
	# Apple providers (iOS and tvOS roots): the user-defaults record store and
	# the Game Center achievement platform.
	if bld.env.DEST_OS == 'ios':
		bld.stlib(
			env       = bld.strict_cpp20_env(),
			source    = [ 'apple/user_defaults_record_store.mm', 'apple/game_center_achievements.mm' ],
			target    = 'platform_apple',
			name      = 'platform_apple',
			arch_module = 'platform.apple',
			features  = 'cxx capability_strict',
			includes  = [ '../public' ],
			defines   = [],
			use       = [ 'platform_achievements', 'FOUNDATION', 'UIKIT', 'GAMEKIT' ],
			subsystem = bld.env.MSVC_SUBSYSTEM,
			idx       = bld.get_taskgen_count()
		)
	bld.stlib(
		env       = bld.strict_cpp20_env(),
		source    = [ 'tool_process_client.cpp' ],
		target    = 'platform_tool_process',
		name      = 'platform_tool_process',
		arch_module = 'platform.tool-process',
		features  = 'cxx capability_strict',
		includes  = [ '../public' ],
		defines   = [],
		use       = [],
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx       = bld.get_taskgen_count()
	)
